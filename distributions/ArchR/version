# VERSION: set full version, use "devel" for development version
  DISTRO_VERSION="devel"

# OS_VERSION: OS Version
  OS_VERSION="$(date +%Y%m%d)"

# ARCHR_RELEASE: the release an official image is published as. scripts/image
# writes it to the image's /etc/os-release. A console shows the later of it
# and the last release its updates reached (archr package, sources/releases):
# "v<release> · <update>". Raise it before building the images of a release,
# and add the release's update to sources/releases when it is published.
  ARCHR_RELEASE="3.1.1"
