[Unit]
Description=ArchR user autostart script
# No Before= on the UI: this script starts it (UI_SERVICE) as soon as the
# scripts it needs are done, then runs the deferred ones. Ordering the UI
# after this unit would hold it behind those too.
# Only what the scripts need: /storage config (userconfig) on top of the
# implicit basic.target. Waiting for network.target and graphical.target
# held the UI behind iwd, connman, sshd and the rest of multi-user.target
# (~6s on an R36S) for nothing: the UI is started by this script, and
# 099-networkservices only starts services, it never needs a link up.
After=userconfig.service

[Service]
Type=oneshot
Environment=HOME=/storage
ExecStart=/bin/bash -a -c 'source /etc/profile && exec /usr/bin/autostart'
RemainAfterExit=yes
# Cap the autostart at 60s so that a misbehaving script (drm_tool with
# DRM not ready, a daemon source hanging, etc.) doesn't lock the boot
# indefinitely.
TimeoutStartSec=60s

[Install]
WantedBy=archr.target
