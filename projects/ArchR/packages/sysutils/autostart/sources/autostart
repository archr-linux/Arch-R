. /etc/os-release

BOOTLOG="/var/log/boot.log"
# Persistent boot trace lives on /storage so that an interrupted boot
# (hung autostart, kernel crash, manual reset) survives across the
# reboot. The current script being run is written to .boot_last_step
# *before* execution, then erased on success. If the file still exists
# at the start of the next boot, the previous run hung on that script
# — copy it to .boot_last_hang so it survives even after a clean boot
# overwrites the marker.
BOOT_LAST_STEP="/storage/.boot_last_step"

log() {
  echo "$(date): Autostart: $*" >>${BOOTLOG} 2>&1
}

trace_step() {
  # Only attempt to write once /storage is mountable; quirks that run
  # before automount don't touch this and that's fine — the kernel
  # boot stage prior to /storage is already covered by dmesg.
  echo "$1" >${BOOT_LAST_STEP} 2>/dev/null
}

trace_done() {
  rm -f ${BOOT_LAST_STEP} 2>/dev/null
}

# If the previous boot hung, preserve a copy before we overwrite the
# marker on this boot. Read it back later with:
#   cat /storage/.boot_last_hang
if [ -f "${BOOT_LAST_STEP}" ]; then
  cp -f "${BOOT_LAST_STEP}" /storage/.boot_last_hang 2>/dev/null
  log "Previous boot hung at: $(cat ${BOOT_LAST_STEP} 2>/dev/null)"
fi

performance 2>/dev/null

### Fix permissions for non-root brightness and CPU boost control
chmod 0666 /sys/class/backlight/*/brightness 2>/dev/null
chmod 0666 /sys/devices/system/cpu/cpufreq/boost 2>/dev/null

### Disable rumble motor on boot (prevents vibration on boards where PWM0 defaults high).
### Let go of it right after: while exported, the joypad driver can't take
### its rumble PWM (-EBUSY), and the R36S Soysauce one probes about now.
if [ -d /sys/class/pwm/pwmchip0 ] && echo 0 > /sys/class/pwm/pwmchip0/export 2>/dev/null; then
  echo 0 > /sys/class/pwm/pwmchip0/pwm0/duty_cycle 2>/dev/null
  echo 0 > /sys/class/pwm/pwmchip0/pwm0/enable 2>/dev/null
  echo 0 > /sys/class/pwm/pwmchip0/unexport 2>/dev/null
fi

### The GPU driver from the start, beside the quirks and the storage: it
### reads only gpu.driver from system.cfg, and loading it (modprobe, the
### bind, the library binds) took ~3 s of phase B, right before the UI.
### Phase B's wait joins it, so the UI still starts with the GPU ready.
GPU_SCRIPT="/usr/lib/autostart/common/003-gpudriver"
if [ -x "${GPU_SCRIPT}" ]; then
  ( log "Run ${GPU_SCRIPT}"; "${GPU_SCRIPT}" 2>&1 >>${BOOTLOG}; log "Done ${GPU_SCRIPT}" ) &
  PHASE_B_PIDS+=($!)
fi

### Read what sway and the launcher map (their binaries and libraries)
### while the rest runs: they start off a cold card, ~5 s on an R36S. The
### list comes from their /proc/<pid>/maps after a boot (ui_prefetch_list
### below, phase C), again whenever the launcher binary changes. Lowest
### CPU priority: the boot needs the CPU, the card reads in parallel.
UI_PREFETCH="/storage/.cache/ui-prefetch.list"
if [ -s "${UI_PREFETCH}" ]; then
  ( renice 19 -p ${BASHPID} >/dev/null 2>&1
    while read -r f; do
      [ -f "${f}" ] && cat "${f}" >/dev/null 2>&1
    done <"${UI_PREFETCH}" ) &
  disown $!
fi

ui_prefetch_list() {
  local i pid pids=""
  [ -s "${UI_PREFETCH}" ] && [ "${UI_PREFETCH}" -nt /usr/bin/archr-launcher ] && return 0
  # The launcher has mapped what its first frame needs a few seconds in.
  for i in $(seq 1 60); do
    pid=$(pidof archr-launcher 2>/dev/null) && break
    sleep 0.5
  done
  [ -n "${pid}" ] || return 0
  sleep 5
  pids="$(pidof sway 2>/dev/null) $(pidof archr-launcher 2>/dev/null)"
  for pid in ${pids}; do
    awk '$6 ~ /^\/usr\// && $7 == "" {print $6}' "/proc/${pid}/maps" 2>/dev/null
  done | sort -u >"${UI_PREFETCH}.tmp" && [ -s "${UI_PREFETCH}.tmp" ] &&
    mv -f "${UI_PREFETCH}.tmp" "${UI_PREFETCH}"
  rm -f "${UI_PREFETCH}.tmp"
}

### Load platform + device quirks in parallel. Every quirk writes to its
### own /storage/.config/profile.d/NNN-name file or to a hardware sysfs
### path — they don't share state, so running them concurrently is safe
### and trims several seconds off boot (most quirks are sub-second cats).
### Each quirk is logged with its end-tag so a failure is still
### attributable in /var/log/boot.log; the trace_step marker for slow
### debugging picks the LAST-launched script (good enough — if a quirk
### hangs we want to know what's still running, not the entry order).
QUIRK_DIRS=()
[ -d "/usr/lib/autostart/quirks/platforms/${HW_DEVICE}" ] && QUIRK_DIRS+=("/usr/lib/autostart/quirks/platforms/${HW_DEVICE}")
[ -d "/usr/lib/autostart/quirks/devices/${QUIRK_DEVICE}" ] && QUIRK_DIRS+=("/usr/lib/autostart/quirks/devices/${QUIRK_DEVICE}")

# QUIRK_DEVICE comes from /sys/firmware/devicetree/base/model and usually
# carries spaces ("Game Console R36S"). The earlier string-concat +
# unquoted for-loop split that by whitespace, so the device-specific
# quirk dir was never iterated and 001-device_config never wrote the
# DEVICE_TEMP_SENSOR/etc. exports — System Information in ES had no
# CPU/GPU temperature, no playback path, and the rest of the quirks
# silently no-op'd. Array iteration with quoted expansion preserves the
# path verbatim.
run_quirks() {
  local QDIR script QUIRK_PIDS=()
  [ ${#QUIRK_DIRS[@]} -gt 0 ] || return 0
  tocon "Applying ${HW_DEVICE} / ${QUIRK_DEVICE} quirks..."
  for QDIR in "${QUIRK_DIRS[@]}"; do
    for script in "${QDIR}"/*; do
      [ -f "${script}" ] || continue
      log "Run ${script}"
      trace_step "quirk:${script}"
      ( "${script}" 2>&1 >>${BOOTLOG}; log "Done ${script}" ) &
      QUIRK_PIDS+=($!)
    done
  done
  # Only the quirks: a bare wait would hold the storage for the GPU driver
  # and the prefetch started above.
  [ ${#QUIRK_PIDS[@]} -eq 0 ] || wait "${QUIRK_PIDS[@]}"
}

### Fast boot (the idea of Zenith, a ROCKNIX fork). The quirks only write
### /storage/.config/profile.d files, which persist, and hardware settings
### the UI does not need to draw; on an R36S they held the storage and the
### UI for ~4.5 s (a dozen scripts sourcing /etc/profile off a cold card).
### When nothing they depend on changed since a boot that finished (this
### script, the model, the kernel, the GPU driver, the quirks themselves),
### the UI starts on the files that boot wrote and the quirks run again
### once the launcher is up. Anything else boots in the usual order:
###  - no mark, or a different one: first boot, an update, a new driver;
###  - the pending mark of a fast boot that never finished (power cut,
###    freeze, a reset): the next boot is a usual one, once;
###  - /storage/.config/autostart-nofast: always the usual order.
FAST_SIG="/storage/.cache/autostart-fast.sig"
FAST_PENDING="/storage/.cache/autostart-fast.pending"
fast_sig() {
  { stat -c %Y /usr/bin/autostart
    echo "${QUIRK_DEVICE}"
    uname -r
    get_setting gpu.driver
    for QDIR in "${QUIRK_DIRS[@]}"; do stat -c '%n %Y' "${QDIR}"/*; done
  } 2>/dev/null | cksum
}
FAST_BOOT=0
if [ -e "${FAST_PENDING}" ]; then
  rm -f "${FAST_PENDING}" "${FAST_SIG}"
  log "Fast boot: the previous one did not finish, usual order this time"
elif [ ! -e /storage/.config/autostart-nofast ] && [ -s "${FAST_SIG}" ] &&
  [ "$(cat "${FAST_SIG}")" = "$(fast_sig)" ]; then
  FAST_BOOT=1
  mkdir -p "${FAST_PENDING%/*}" && : >"${FAST_PENDING}"
  log "Fast boot: quirks after the UI"
fi

# Run once the boot is done (quirks included): the mark for the next one.
fast_done() {
  local sig
  sig=$(fast_sig) && mkdir -p "${FAST_SIG%/*}" &&
    echo "${sig}" >"${FAST_SIG}.tmp" && mv -f "${FAST_SIG}.tmp" "${FAST_SIG}"
  rm -f "${FAST_PENDING}"
}

[ "${FAST_BOOT}" = 1 ] || run_quirks

### Start the automount service
trace_step "archr-automount"
tocon "Starting storage services..."
systemctl start archr-automount

### Run common start scripts in three phases:
###   Phase A: 001-setup runs FIRST (gate). It creates /tmp/cache, the
###     runtime dir, /storage/.config/profile.d, runs chksysconfig
###     verify and sort_settings. Other scripts depend on these
###     directories/settings being ready.
###   Phase B: everything the UI needs, concurrently. Each script touches
###     a different domain and set_setting/get_setting serialize
###     themselves via wait_lock + J_CONF_LOCK, so concurrent writes are
###     safe. The UI starts as soon as this phase is done.
###   Phase C: the scripts in DEFERRED_SCRIPTS, started after the UI.
###     None of them writes anything sway or the UI reads at
###     startup (network daemons, bluetooth, LEDs, rumble, USB gadget,
###     logging, pacman db...). Holding the UI for them cost the slowest
###     one of the lot on every boot. A script missing from this list
###     stays in phase B, so a new script never leaves the boot path
###     unnoticed. 055-hdmi-check is not here: drm_tool racing sway for
###     the DRM master left the screen black.
GATE_SCRIPT="/usr/lib/autostart/common/001-setup"
DEFERRED_SCRIPTS=" 003-logging 004-seed-pacmandb 007-rootpw 008-perfmode
  009-bluetooth 009-sleepmode 010-moonlight 010-pico8 010-uimode 020-rumble
  020-set_audio_latency 081-usbgadget 095-turbo-mode
  096-powerled 098-deviceutils 099-networkservices 999-export "
DEFERRED_LIST=" $(echo ${DEFERRED_SCRIPTS}) "
# 111-sway-init reads DEVICE_HAS_DUAL_SCREEN, which 080-dual_screen_mode
# writes; run them as a chain instead of racing each other.
CHAIN_FIRST="080-dual_screen_mode"
CHAIN_SECOND="111-sway-init"

run_common() {
  log "Run ${1}"
  trace_step "common:${1}"
  "${1}" 2>&1 >>${BOOTLOG}
  log "Done ${1}"
}

if [ -x "${GATE_SCRIPT}" ]; then
  log "Run ${GATE_SCRIPT}"
  trace_step "common:${GATE_SCRIPT}"
  "${GATE_SCRIPT}" 2>&1 >>${BOOTLOG}
fi

COMMON="/usr/lib/autostart/common"
( [ -x "${COMMON}/${CHAIN_FIRST}" ] && run_common "${COMMON}/${CHAIN_FIRST}"
  [ -x "${COMMON}/${CHAIN_SECOND}" ] && run_common "${COMMON}/${CHAIN_SECOND}" ) &
PHASE_B_PIDS+=($!)
DEFERRED=()
for script in ${COMMON}/*; do
  name="${script##*/}"
  [ "${script}" = "${GATE_SCRIPT}" ] && continue
  [ "${script}" = "${GPU_SCRIPT}" ] && continue
  [ "${name}" = "${CHAIN_FIRST}" ] || [ "${name}" = "${CHAIN_SECOND}" ] && continue
  [ -x "${script}" ] || continue
  if [[ "${DEFERRED_LIST}" == *" ${name} "* ]]; then
    DEFERRED+=("${script}")
    continue
  fi
  run_common "${script}" &
  PHASE_B_PIDS+=($!)
done
# Phase B and the GPU driver; not the prefetch, which must never hold the UI.
wait "${PHASE_B_PIDS[@]}"

### Run device start scripts (no parallel — usually 0-2 scripts, ordering may matter)
if [ -d "/usr/lib/autostart/${HW_DEVICE}" ]
then
  for script in "/usr/lib/autostart/${HW_DEVICE}"/*
  do
    log "Run ${script}"
    trace_step "device:${script}"
    if [ -f "${script}" ]
    then
      "${script}" 2>&1 >>${BOOTLOG}
    fi
  done
fi

### Run custom start scripts
if [ -d "/storage/.config/autostart" ]
then
  for script in /storage/.config/autostart/*
  do
    log "Run ${script}"
    trace_step "custom:${script}"
   ${script} 2>&1 >>${BOOTLOG}
  done
fi
# No bare wait here: the only job still running is the UI prefetch.

tocon "Starting user interface..."
log "Startup complete..."

### Re-source the profile so we fetch the correct UI_SERVICE variable.
. /etc/profile

log "Starting ${UI_SERVICE}..."
systemctl start ${UI_SERVICE} 2>&1 >>${BOOTLOG} &

### Phase C: what the UI does not need, now that it is on its way. At
### the lowest CPU and I/O priority: the UI is loading off the SD card
### right now, and at normal priority this phase made EmulationStation,
### the previous UI, take ~3s longer to show its window.
for script in "${DEFERRED[@]}"; do
  ( renice 19 -p ${BASHPID} >/dev/null 2>&1
    ionice -c 3 -p ${BASHPID} >/dev/null 2>&1
    run_common "${script}" ) &
done
# Detached: the governor below must not wait for it (up to ~35 s).
( renice 19 -p ${BASHPID} >/dev/null 2>&1; ui_prefetch_list ) &
disown $!

### Fast boot: the quirks, now that the launcher is up (it reads the same
### files from the boot before). Detached, like the prefetch list.
if [ "${FAST_BOOT}" = 1 ]; then
  ( for i in $(seq 1 60); do
      pidof archr-launcher >/dev/null 2>&1 && break
      sleep 0.5
    done
    sleep 3
    renice 10 -p ${BASHPID} >/dev/null 2>&1
    run_quirks
    fast_done
    log "Fast boot: quirks done" ) &
  disown $!
fi
wait

DEVICE_CPU_GOVERNOR=$(get_setting system.cpugovernor)
${DEVICE_CPU_GOVERNOR} 2>&1 >>${BOOTLOG}
[ "${FAST_BOOT}" = 1 ] || fast_done
log "Autostart complete..."

# Boot reached the end without hanging — clear the marker so the next
# boot doesn't think the previous one failed.
trace_done

clear >/dev/console
