#!/bin/sh

# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2009-2014 Stephan Raue (stephan@openelec.tv)

# The log is on the boot FAT, the one partition a PC can read when the
# first boot hangs. vfat keeps writes in the page cache for up to ~30 s and
# a hung kernel never writes them back, so the log used to stop well before
# the step that hung. Sync the boot FAT before each step and after it: the
# log then always ends at the step that was running, with its uptime.
logsync() {
  sync -f "$LOG" 2>/dev/null || sync
}

uptime_s() {
  cut -d' ' -f1 /proc/uptime
}

# "reboot" is systemctl here, so "reboot -f" asked systemd for the reboot:
# systemd-shutdown kills everything, unmounts and only then calls reboot().
# On cards whose first boot then sat on a frozen screen, nothing after
# "sync" ever happened. Everything is on the card by now (synced, /flash
# read-only, STORAGE unmounted), so -ff calls reboot() directly, as busybox
# "reboot -f" did. If even that has not restarted the board after
# RESTART_WAIT seconds, a driver is stuck in its shutdown hook (the display
# is the suspect): restart without shutting devices down. The trigger
# works with sysrq disabled for the keyboard.
RESTART_WAIT=${RESTART_WAIT:-20}
restart_now() {
  sync
  ( sleep "$RESTART_WAIT"; echo b >/proc/sysrq-trigger ) &
  reboot -ff >/dev/null 2>&1
  wait
}

StartProgressLog() {
  local rc
  if [ "$1" = "spinner" ]; then
    echo "*** [$(uptime_s)] $3" >>$LOG
    logsync
  fi
  StartProgress "$@"
  rc=$?
  if [ "$1" = "spinner" ]; then
    echo "    [$(uptime_s)] exit $rc" >>$LOG
    logsync
  fi
  return $rc
}

if [ -e /storage/.please_resize_me ] ; then
  . /usr/lib/archr/functions

  hidecursor
  # The boot runs with the console at log level 1 (scripts/init). While
  # the card is repartitioned, show kernel errors (mmc timeouts, I/O
  # errors) on the screen, so a photo of a stuck first boot says why.
  PRINTK=$(cat /proc/sys/kernel/printk 2>/dev/null)
  echo "4 4 1 7" >/proc/sys/kernel/printk 2>/dev/null

  mount -o remount,rw /flash
  LOG=/flash/fs-resize.log
  date -Iseconds >>$LOG
  logsync

  # this sh** was never intended to be used
  # on already installed and runing system
  if [ -d /storage/.config -o -d /storage/.cache ] ; then
    rm -f /storage/.please_resize_me
    sync
    echo "Resizing is not permitted - the system has already been initialised." | tee -a $LOG
    mount -o remount,ro /flash
    StartProgress countdown "Rebooting in 5s... " 5 "NOW"
    restart_now
  fi

  # get the disk. /storage on 2nd partition
  echo $(grep "/storage " /proc/mounts) >>$LOG
  PART=$(grep "/storage " /proc/mounts | cut -d" " -f1 | grep '[0-9]$')
  PARTNUM="${PART: -1}"

  # get disk: /dev/sdx2 -> /dev/sdx, /dev/mmcblkxp2 -> /dev/mmcblkx
  case $PART in
    "/dev/mmcblk"*|"/dev/nvme"*|"/dev/loop"*)
      DISK=$(echo $PART | sed s/p[0-9]$//g)
      PART1="${DISK}p1"
      ;;
    *)
      DISK=$(echo $PART | sed s/[0-9]$//g)
      # /dev/sdX partitions have no "p" separator; ${DISK}p1 pointed at a
      # nonexistent node and the boot-partition serial was never randomized
      # on those devices.
      PART1="${DISK}1"
      ;;
  esac

  rm -f /storage/.please_resize_me
  sync

  echo "DISK: $DISK  PART: $PART" >>$LOG

  # just in case
  if [ ! -z "$DISK" -a ! -z "$PART" ] ; then
    umount $PART

    echo "PARTITION RESIZING IN PROGRESS"
    echo ""
    echo "Please do not reboot or turn off your @DISTRONAME@ device!"
    echo ""

    # New layout: STORAGE stops at 8 GiB and the rest becomes ARCHR_ROMS
    # (exFAT, /storage/roms), readable on any computer. Cards too small for
    # both keep the old layout, STORAGE to the end of the card.
    . /usr/lib/archr/roms-partition
    ROMS_PLANNED=
    if [ "$PARTNUM" = 3 ] && command -v mkfs.exfat >/dev/null && roms_plan "$DISK"; then
      ROMS_PLANNED=1
      echo "ROMs partition planned: STORAGE ends at sector $ROMS_P3_END, ARCHR_ROMS ${ROMS_P4_MIB} MiB" >>$LOG
      StartProgressLog spinner "Resizing partition...   " "parted -s -f -m $DISK unit s resizepart $PARTNUM ${ROMS_P3_END}s >>$LOG 2>&1"
    else
      StartProgressLog spinner "Resizing partition...   " "parted -s -f -m $DISK resizepart $PARTNUM 100% >>$LOG 2>&1"
    fi
    # e2fsck -p exits 0 (clean), 1 (fixed) or 2 (fixed, reboot wanted);
    # anything above means unfixed corruption, and growing a broken
    # filesystem with resize2fs would compound the damage. Leave the
    # partition grown but the filesystem untouched; a later boot can
    # retry after a manual fsck.
    StartProgressLog spinner "Checking file system... " "e2fsck -f -p $PART >>$LOG 2>&1; echo \$? >/tmp/fsck-status"
    FSCK_STATUS=$(cat /tmp/fsck-status 2>/dev/null || echo 0)
    if [ "${FSCK_STATUS:-0}" -le 2 ]; then
      StartProgressLog spinner "Resizing file system... " "resize2fs $PART >>$LOG 2>&1"
    else
      echo "e2fsck exited ${FSCK_STATUS}; skipping resize2fs to avoid growing a corrupted filesystem" | tee -a $LOG
    fi
    if [ -n "$ROMS_PLANNED" ]; then
      if ! StartProgressLog spinner "Creating ROMs partition... " "roms_create \"$DISK\" $ROMS_P4_START >>$LOG 2>&1"; then
        # Any failure: back to the old layout, STORAGE to the end of the
        # card. The ROMs then live in /storage/roms on ext4, as before.
        echo "ROMs partition failed; falling back to the old layout" | tee -a $LOG
        roms_has_part "$DISK" 4 && parted -s "$DISK" rm 4 >>$LOG 2>&1
        StartProgressLog spinner "Resizing partition...   " "parted -s -f -m $DISK resizepart $PARTNUM 100% >>$LOG 2>&1"
        StartProgressLog spinner "Resizing file system... " "resize2fs $PART >>$LOG 2>&1"
      fi
    fi
    StartProgressLog spinner "Regenerating UUIDs...   " "tune2fs $PART -U random >>$LOG 2>&1; fatlabel -i -r $PART1 >>$LOG 2>&1"
    # The two FAT warnings fatlabel prints here are expected and harmless:
    # the 256MB boot partition ships the same out-of-spec FAT32 layout as
    # the whole RK3326 ecosystem (vendor U-Boots are only tested against
    # it, so it must not be "fixed"), and the boot-sector/backup difference
    # is the kernel vfat dirty flag, written to the primary sector only
    # while /flash is mounted read-write.
    echo "NOTE: the FAT32 cluster-count and boot-sector-backup warnings above are expected and harmless." >>$LOG
    # The kernel's view of the run (mmc, ext4, exFAT), for comparing a
    # good first boot with a bad one.
    { echo "--- dmesg"; dmesg; echo "--- end of dmesg"; } >>$LOG 2>&1
    StartProgressLog spinner "Syncing to disk...      " "sync >>$LOG 2>&1"
    StartProgress countdown "Rebooting in 5s...     " 5 "NOW"
  else
    echo "Partition was not detected - resizing aborted."
    StartProgress countdown "Rebooting in 5s... " 5 "NOW"
  fi
  echo "[$(uptime_s)] restarting" >>$LOG
  logsync
  mount -o remount,ro /flash
  [ -n "$PRINTK" ] && echo $PRINTK >/proc/sys/kernel/printk 2>/dev/null
fi
restart_now
