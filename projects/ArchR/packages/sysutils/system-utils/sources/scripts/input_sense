# Copyright (C) 2024-present ArchR (https://github.com/archr-linux/Arch-R)

. "${INPUT_SENSE_PROFILE:-/etc/profile}"

# Remove or comment out 'set -e' so the script doesn't exit on a single error:
# set -e
set -o pipefail

### Summary
#   This script listens to input events and takes actions.
###

### In-game hotkeys (system.cfg, read once at startup; restart the input
### service to apply). Buttons are evtest key names (BTN_EAST, BTN_DPAD_UP,
### ...). Defaults are the historical, hard-wired behaviour.
#
#   key.hotkey.a=BTN_TL                 hotkey modifier (hold + button)
#   hotkey.screenshot=BTN_EAST          modifier + button: archr-screenshot
#   hotkey.screenshot.enabled=1
#   hotkey.mangohud=BTN_WEST            modifier + button: mangohud_set toggle
#   hotkey.mangohud.enabled=1
#   hotkey.exit=BTN_SELECT+BTN_START    modifier + both buttons: kill the
#   hotkey.exit.enabled=1               running emulator (/tmp/.process-kill-data);
#                                       unset, the pair comes from the older
#                                       key.hotkey.b / key.hotkey.c
#
#   key.function.a=<device default>     function modifier (BTN_SELECT on RK3326)
#   key.dpad.events=0                   master switch for the two pairs below
#   hotkey.volume=BTN_DPAD_UP+BTN_DPAD_DOWN         function modifier + up/down
#   hotkey.volume.enabled=1
#   hotkey.brightness=BTN_DPAD_RIGHT+BTN_DPAD_LEFT  function modifier + up/down
#   hotkey.brightness.enabled=1
#
#   hotkey.switcher=BTN_MODE            a tap on this button alone, under
#   hotkey.switcher.enabled=1           0.6 s (FN on the R36S: not in the SDL
#                                       pad mapping; mupen64plus only uses it
#                                       as a modifier with another button,
#                                       DraStic opens its menu): save the game
#                                       and open the launcher's switcher
#                                       (archr-game-save-exit switch); another
#                                       button pressed while it is held, or a
#                                       longer hold, cancels it
#
#   idle.timeout=0                      minutes without any key event, then
#   idle.timeout.game=0                 the power button's fake suspend; the
#                                       second applies while a game runs.
#                                       0 or unset: never.
#
#   Any value other than 0 enables an action. Each button should differ
#   from the modifiers and from the other hotkeys: the first match wins.
#   With InputPlumber, BTN_NORTH and BTN_WEST are swapped as before, so the
#   names always refer to the physical button.
###

### Enable logging
case $(get_setting system.loglevel) in
  verbose)
    DEBUG=true
  ;;
  *)
    DEBUG=false
  ;;
esac

### Define matching values from evtest, but allow them to be overridden in system.cfg.
KEY_VOLUME_UP=$(get_setting key.volume.up)
[ -z "${KEY_VOLUME_UP}" ] && KEY_VOLUME_UP='KEY_VOLUME*UP'

KEY_VOLUME_DOWN=$(get_setting key.volume.down)
[ -z "${KEY_VOLUME_DOWN}" ] && KEY_VOLUME_DOWN='KEY_VOLUME*DOWN'

FUNCTION_VOLUME_UP_EVENT='*('${KEY_VOLUME_UP}'), value *'
FUNCTION_VOLUME_DOWN_EVENT='*('${KEY_VOLUME_DOWN}'), value *'

# The power button's suspend, also run after inactivity. Its flag file
# says the device is already suspended.
: "${FAKE_SUSPEND:=/usr/bin/archr-fake-suspend}"
: "${FAKE_SUSPEND_FLAG:=/var/run/power-fake-suspend-active.flag}"

FUNCTION_POWER_RELEASED_EVENT='*(KEY_POWER), value 0'
FUNCTION_POWER_PRESSED_EVENT='*(KEY_POWER), value 1'

FUNCTION_LID_OPEN_EVENT='*(SW_LID), value 0'
FUNCTION_LID_CLOSE_EVENT='*(SW_LID), value 1'

### Define matching function hotkeys from controller values, but allow them to be overridden in system.cfg.
KEYA_MODIFIER=$(get_setting key.function.a)
[ -z "${KEYA_MODIFIER}" ] && KEYA_MODIFIER="${DEVICE_FUNC_KEYA_MODIFIER}"

KEYB_MODIFIER=$(get_setting key.function.b)
[ -z "${KEYB_MODIFIER}" ] && KEYB_MODIFIER="${DEVICE_FUNC_KEYB_MODIFIER}"

FUNCTION_MODIFIER_A_EVENT='*('${KEYA_MODIFIER}'), value *'
FUNCTION_MODIFIER_B_EVENT='*('${KEYB_MODIFIER}'), value *'

BTN_HOTKEY_A_MODIFIER=$(get_setting key.hotkey.a)
[ -z "${BTN_HOTKEY_A_MODIFIER}" ] && BTN_HOTKEY_A_MODIFIER="BTN_TL"

BTN_HOTKEY_B_MODIFIER=$(get_setting key.hotkey.b)
[ -z "${BTN_HOTKEY_B_MODIFIER}" ] && BTN_HOTKEY_B_MODIFIER="BTN_SELECT"

BTN_HOTKEY_C_MODIFIER=$(get_setting key.hotkey.c)
[ -z "${BTN_HOTKEY_C_MODIFIER}" ] && BTN_HOTKEY_C_MODIFIER="BTN_START"

### Per-action hotkeys, see the table at the top.
hotkey_enabled() {
  [ "$(get_setting "${1}.enabled")" = "0" ] && echo false || echo true
}

# One evtest key name, or the default when unset or malformed
hotkey_button() {
  local VALUE="$(get_setting "${1}")"
  [[ "${VALUE}" =~ ^[A-Z0-9_]+$ ]] && echo "${VALUE}" || echo "${2}"
}

# "A+B" -> two words; anything else -> nothing, so the caller keeps its default
hotkey_pair() {
  local VALUE="$(get_setting "${1}")"
  [[ "${VALUE}" =~ ^([A-Z0-9_]+)\+([A-Z0-9_]+)$ ]] && echo "${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"
}

HOTKEY_EXIT=$(hotkey_pair hotkey.exit)
[ -n "${HOTKEY_EXIT}" ] && read -r BTN_HOTKEY_B_MODIFIER BTN_HOTKEY_C_MODIFIER <<< "${HOTKEY_EXIT}"
HOTKEY_EXIT_ENABLED=$(hotkey_enabled hotkey.exit)

HOTKEY_A_PRESSED=false
HOTKEY_B_PRESSED=false
HOTKEY_C_PRESSED=false

INPUT_PLUMBER_CHECK=$(grep -l "InputPlumber Keyboard" /sys/class/input/event*/device/name | sed -E 's#.*/(event[0-9]+).*#/dev/input/\1#')
if [[ -n "${INPUT_PLUMBER_CHECK}" ]]; then
  ${DEBUG} && log $0 "InputPlumber detected, fixing face buttons."
fi

# Physical button name -> pattern for its press (or the supplied value).
# InputPlumber reports north and west swapped.
press_event() {
  local BTN="${1}"
  if [[ -n "${INPUT_PLUMBER_CHECK}" ]]; then
    case ${BTN} in
      BTN_NORTH) BTN=BTN_WEST ;;
      BTN_WEST)  BTN=BTN_NORTH ;;
    esac
  fi
  echo "*(${BTN}), value ${2:-1*}"
}

FUNCTION_HOTKEY_A_EVENT=$(press_event "${BTN_HOTKEY_A_MODIFIER}" '*')
FUNCTION_HOTKEY_B_EVENT=$(press_event "${BTN_HOTKEY_B_MODIFIER}" '*')
FUNCTION_HOTKEY_C_EVENT=$(press_event "${BTN_HOTKEY_C_MODIFIER}" '*')

HOTKEY_SCREENSHOT=$(hotkey_button hotkey.screenshot BTN_EAST)
HOTKEY_SCREENSHOT_ENABLED=$(hotkey_enabled hotkey.screenshot)

HOTKEY_MANGOHUD=$(hotkey_button hotkey.mangohud BTN_WEST)
HOTKEY_MANGOHUD_ENABLED=$(hotkey_enabled hotkey.mangohud)

FUNCTION_HOTKEY_BTN_NORTH_EVENT=$(press_event BTN_NORTH)
FUNCTION_HOTKEY_SCREENSHOT_EVENT=$(press_event "${HOTKEY_SCREENSHOT}")
FUNCTION_HOTKEY_MANGOHUD_EVENT=$(press_event "${HOTKEY_MANGOHUD}")

FUNCTION_HOTKEY_BTN_BACK_EVENT="*(BTN_BACK), value 1*"
FUNCTION_HOTKEY_KEY_RECORD_EVENT="*(KEY_RECORD), value 1*"

FUNCTION_HOTKEY_TOUCH_EVENT="*(BTN_TOUCH), value 1*"

TOUCHSCREEN_EVENTS=$(get_setting key.touchscreen.events)
if [ -z "${TOUCHSCREEN_EVENTS}" ] || [ "${TOUCHSCREEN_EVENTS}" = "0" ]; then
  TOUCHSCREEN_EVENTS=false
else
  TOUCHSCREEN_EVENTS=true
fi

### Volume and brightness pairs (function modifier + button), and the hat
### axis that stands for each dpad button on pads without dpad keys.
hat_event() {
  case ${1} in
    BTN_DPAD_UP)    echo "*(ABS_HAT0Y), value -1*" ;;
    BTN_DPAD_DOWN)  echo "*(ABS_HAT0Y), value 1*" ;;
    BTN_DPAD_RIGHT) echo "*(ABS_HAT0X), value 1*" ;;
    BTN_DPAD_LEFT)  echo "*(ABS_HAT0X), value -1*" ;;
    *)              press_event "${1}" ;;
  esac
}

HOTKEY_VOLUME=$(hotkey_pair hotkey.volume)
[ -z "${HOTKEY_VOLUME}" ] && HOTKEY_VOLUME="BTN_DPAD_UP BTN_DPAD_DOWN"
read -r HOTKEY_VOLUME_UP HOTKEY_VOLUME_DOWN <<< "${HOTKEY_VOLUME}"
HOTKEY_VOLUME_ENABLED=$(hotkey_enabled hotkey.volume)

HOTKEY_BRIGHTNESS=$(hotkey_pair hotkey.brightness)
[ -z "${HOTKEY_BRIGHTNESS}" ] && HOTKEY_BRIGHTNESS="BTN_DPAD_RIGHT BTN_DPAD_LEFT"
read -r HOTKEY_BRIGHTNESS_UP HOTKEY_BRIGHTNESS_DOWN <<< "${HOTKEY_BRIGHTNESS}"
HOTKEY_BRIGHTNESS_ENABLED=$(hotkey_enabled hotkey.brightness)

HOTKEY_SWITCHER=$(hotkey_button hotkey.switcher BTN_MODE)
HOTKEY_SWITCHER_ENABLED=$(hotkey_enabled hotkey.switcher)
FUNCTION_HOTKEY_SWITCHER_EVENT=$(press_event "${HOTKEY_SWITCHER}" '*')
# Pressed with nothing else since: its release is a tap, when it came
# within SWITCHER_TAP milliseconds.
SWITCHER_ARMED=false
SWITCHER_DOWN=0
: "${SWITCHER_TAP:=600}"
now_ms() {
  local t=${EPOCHREALTIME/[.,]/}
  echo $((t / 1000))
}

FUNCTION_HOTKEY_DPAD_UP_EVENT=$(press_event "${HOTKEY_VOLUME_UP}")
FUNCTION_HOTKEY_DPAD_DOWN_EVENT=$(press_event "${HOTKEY_VOLUME_DOWN}")
FUNCTION_HOTKEY_DPAD_RIGHT_EVENT=$(press_event "${HOTKEY_BRIGHTNESS_UP}")
FUNCTION_HOTKEY_DPAD_LEFT_EVENT=$(press_event "${HOTKEY_BRIGHTNESS_DOWN}")

FUNCTION_HOTKEY_HAT_UP_EVENT=$(hat_event "${HOTKEY_VOLUME_UP}")
FUNCTION_HOTKEY_HAT_DOWN_EVENT=$(hat_event "${HOTKEY_VOLUME_DOWN}")
FUNCTION_HOTKEY_HAT_RIGHT_EVENT=$(hat_event "${HOTKEY_BRIGHTNESS_UP}")
FUNCTION_HOTKEY_HAT_LEFT_EVENT=$(hat_event "${HOTKEY_BRIGHTNESS_DOWN}")

DPAD_EVENTS=$(get_setting key.dpad.events)
if [ -z "${DPAD_EVENTS}" ] || [ "${DPAD_EVENTS}" = "0" ]; then
  DPAD_EVENTS=false
else
  DPAD_EVENTS=true
fi

DEVICE_DISCONNECTED="*error reading: No such device"

### Matches if a button was pressed (1), released (0) or held down (2)
PRESS='value 1'
REPEAT='value 2'
RELEASE='value 0'

### Function buttons should be defined as not pressed for later matching.
FN_A_PRESSED=false
FN_B_PRESSED=false

VOLUME_UP_PRESSED=false
VOLUME_DOWN_PRESSED=false

### Allow actions to be overridden in system.cfg
FN_A_ACTION_UP="$(get_setting key.function.a.up)"
FN_A_ACTION_DOWN="$(get_setting key.function.a.down)"
FN_B_ACTION_UP="$(get_setting key.function.b.up)"
FN_B_ACTION_DOWN="$(get_setting key.function.b.down)"
FN_AB_ACTION_UP="$(get_setting key.function.ab.up)"
FN_AB_ACTION_DOWN="$(get_setting key.function.ab.down)"

### Set sane defaults to manage volume, brightness, wireless on/off, and led on/off.
[ -z "${FN_A_ACTION_UP}" ]    && FN_A_ACTION_UP="brightness up"
[ -z "${FN_A_ACTION_DOWN}" ]  && FN_A_ACTION_DOWN="brightness down"
[ -z "${FN_B_ACTION_UP}" ]    && FN_B_ACTION_UP="ledcontrol"
[ -z "${FN_B_ACTION_DOWN}" ]  && FN_B_ACTION_DOWN="ledcontrol poweroff"
[ -z "${FN_AB_ACTION_UP}" ]   && FN_AB_ACTION_UP="wifictl enable"
[ -z "${FN_AB_ACTION_DOWN}" ] && FN_AB_ACTION_DOWN="wifictl disable"

### Level pill (archr-osd) showing the current level; archr-levels sends it.
show_osd() {
  archr-levels "${1}" osd >/dev/null 2>&1
}

### Volume and brightness while a button is held: archr-levels steps once
### now, then keeps going, faster and faster, until the release. A hold
### lasts 400 ms unless renewed: a timer here renews it every 200 ms while
### the button is down (the dpad has no key repeat), so if this script dies
### the hold ends by itself. Only the button that started it ends it.
LEVEL_KEY=""
LEVEL_RENEWER=""
start_level_hold() {
  stop_level_hold
  archr-levels "${1}" hold "${2}" osd >/dev/null 2>&1
  [[ "${line}" =~ code\ [0-9]+\ \(([A-Z0-9_]+)\) ]] && LEVEL_KEY=${BASH_REMATCH[1]} || LEVEL_KEY="?"
  local PARENT=${BASHPID}
  (
    while kill -0 "${PARENT}" 2>/dev/null; do
      sleep 0.2
      archr-levels renew >/dev/null 2>&1
    done
  ) &
  LEVEL_RENEWER=$!
}

stop_level_hold() {
  [ -n "${LEVEL_KEY}" ] || return 0
  kill "${LEVEL_RENEWER}" 2>/dev/null
  wait "${LEVEL_RENEWER}" 2>/dev/null
  LEVEL_KEY=""
  LEVEL_RENEWER=""
  archr-levels release >/dev/null 2>&1
}

# A release ends the hold only when it is the button that started it.
release_level_hold() {
  [ -n "${LEVEL_KEY}" ] && [[ "${1}" == *"(${LEVEL_KEY}), value 0"* ]] && stop_level_hold
  return 0
}

# A hold left by a previous run, whose release never came, ends now.
archr-levels release >/dev/null 2>&1

### Simple functions to execute button actions, including global kill.
execute_kill() {
  if [ -e "/tmp/.process-kill-data" ]; then
    TO_KILL="$(cat /tmp/.process-kill-data)"
    ${DEBUG} && log $0 "Execute: killall ${TO_KILL}"
    killall ${TO_KILL} 2>/dev/null
  fi
}

execute_action() {
  ${DEBUG} && log $0 "${1}|${FN_A_PRESSED}|${FN_B_PRESSED}|${DPAD_UP_PRESSED}|${DPAD_DOWN_PRESSED}|${DPAD_RIGHT_PRESSED}|${DPAD_LEFT_PRESSED}"
  if [ "${FN_A_PRESSED}" = true ] && [ "${FN_B_PRESSED}" = true ]; then
    ${DEBUG} && log $0 "Executing FN_AB action"
    case ${1} in
      up)
        ${DEBUG} && log $0 "FN_AB (${FN_AB_ACTION_UP})"
        ${FN_AB_ACTION_UP}
        ;;
      down)
        ${DEBUG} && log $0 "FN_AB (${FN_AB_ACTION_DOWN})"
        ${FN_AB_ACTION_DOWN}
        ;;
    esac
  elif [ "${FN_A_PRESSED}" = true ] && [ "${FN_B_PRESSED}" = false ]; then
    ${DEBUG} && log $0 "Executing FN_A action"
    case ${1} in
      up)
        ${DEBUG} && log $0 "FN_A (${FN_A_ACTION_UP})"
        ${FN_A_ACTION_UP}
        if [ "${FN_A_ACTION_UP}" == "brightness up" ]; then
          show_osd brightness
        fi
        ;;
      down)
        ${DEBUG} && log $0 "FN_A (${FN_A_ACTION_DOWN})"
        ${FN_A_ACTION_DOWN}
        if [ "${FN_A_ACTION_DOWN}" == "brightness down" ]; then
          show_osd brightness
        fi
        ;;
    esac
  elif [ "${FN_A_PRESSED}" = false ] && [ "${FN_B_PRESSED}" = true ]; then
    ${DEBUG} && log $0 "Executing FN_B action"
    case ${1} in
      up)
        ${DEBUG} && log $0 "FN_B (${FN_B_ACTION_UP})"
        ${FN_B_ACTION_UP}
        ;;
      down)
        ${DEBUG} && log $0 "FN_B (${FN_B_ACTION_DOWN})"
        ${FN_B_ACTION_DOWN}
        ;;
    esac
  else
    # If neither FN_A nor FN_B is pressed, treat it as a volume control
    volume ${1}
  fi
}

### Inactivity, see the table at the top. Seconds per minute: the host
### test shortens it.
: "${IDLE_UNIT:=60}"
idle_limit() {
  local VALUE="$(get_setting "${1}")"
  [[ "${VALUE}" =~ ^[0-9]{1,4}$ ]] && echo $(( 10#${VALUE} * IDLE_UNIT )) || echo 0
}
IDLE_MENU=$(idle_limit idle.timeout)
IDLE_GAME=$(idle_limit idle.timeout.game)
# The shortest limit set: the longest the event loop waits before looking.
IDLE_STEP=${IDLE_MENU}
if [ "${IDLE_GAME}" -gt 0 ] && { [ "${IDLE_STEP}" -eq 0 ] || [ "${IDLE_GAME}" -lt "${IDLE_STEP}" ]; }; then
  IDLE_STEP=${IDLE_GAME}
fi

idle_suspend() {
  [ -e "${FAKE_SUSPEND_FLAG}" ] && return
  ${DEBUG} && log $0 "Idle: suspending"
  ${FAKE_SUSPEND} power &
}

# Read the next event into ${line}. With a limit set the read times out when
# the limit may have passed; the state decides which one applies (a game runs
# while runemu.sh does, as archr-fake-suspend sees it). Past it, suspend once
# and count again. No limit: a plain blocking read.
# The game runner, as archr-fake-suspend looks for it (the host test gives
# its own name, so another copy of the test cannot pass for a game).
: "${RUNEMU:=/usr/bin/runemu.sh}"

# Milliseconds: $SECONDS counts whole seconds from an unknown fraction, so
# a limit measured with it could pass up to a second early.
# now_ms sets NOW (no subshell: it runs on every event).
now_ms() {
  local US=${EPOCHREALTIME/[.,]/}
  NOW=$(( US / 1000 ))
}
now_ms
IDLE_SINCE=${NOW}
IDLE_WAKE=$(( IDLE_SINCE + IDLE_STEP * 1000 ))
next_event() {
  local LIMIT RC NOW WAIT
  while [ "${IDLE_STEP}" -gt 0 ]; do
    now_ms
    WAIT=$(( IDLE_WAKE > NOW ? IDLE_WAKE - NOW : 1 ))
    read -t "$(printf '%d.%03d' $(( WAIT / 1000 )) $(( WAIT % 1000 )))" line
    RC=$?
    now_ms
    if [ ${RC} -le 128 ]; then
      IDLE_SINCE=${NOW}
      IDLE_WAKE=$(( NOW + IDLE_STEP * 1000 ))
      return ${RC}
    fi
    LIMIT=${IDLE_MENU}
    pgrep -f "${RUNEMU}" >/dev/null 2>&1 && LIMIT=${IDLE_GAME}
    if [ "${LIMIT}" -gt 0 ] && [ $(( NOW - IDLE_SINCE )) -ge $(( LIMIT * 1000 )) ]; then
      idle_suspend
      IDLE_SINCE=${NOW}
    fi
    if [ "${LIMIT}" -gt 0 ]; then
      IDLE_WAKE=$(( IDLE_SINCE + LIMIT * 1000 ))
    else
      IDLE_WAKE=$(( NOW + IDLE_STEP * 1000 ))
    fi
  done
  read line
}

### Search the system for useful devices to monitor for inputs (the host
### test points INPUT_DIR elsewhere).
: "${INPUT_DIR:=/dev/input}"
INPUT_DEVICES=()

get_devices() {
  local KJDEVS=false
  local FOUNDKEYS=false
  local FOUNDJOY=false
  local FOUNDTOUCH=false
  # Starting at the limit meant no retry at all: early in boot udev has
  # not tagged the pad yet, the script found nothing, exited, and systemd
  # restarted it a second later.
  local RETRY=0

  while [ ${KJDEVS} = false ]; do
    for DEV in "${INPUT_DIR}"/ev*
    do
      unset SUPPORTS
      SUPPORTS=$(udevadm info ${DEV} | awk '/ID_INPUT_KEY=|ID_INPUT_JOYSTICK=|ID_INPUT_TOUCHSCREEN=/ {print $2}')
      if [ -n "${SUPPORTS}" ]; then
        DEVICE=$(udevadm info ${DEV} | awk 'BEGIN {FS="="} /DEVNAME=/ {print $2}')
        INPUT_DEVICES+=("${DEVICE}")
        if [[ "${SUPPORTS}" =~ ID_INPUT_KEY ]]; then
          ${DEBUG} && log $0 "Found Keyboard: ${DEVICE}"
          FOUNDKEYS=true
        elif [[ "${SUPPORTS}" =~ ID_INPUT_TOUCHSCREEN ]]; then
          ${DEBUG} && log $0 "Found Touchscreen: ${DEVICE}"
          FOUNDTOUCH=true
        elif [[ "${SUPPORTS}" =~ ID_INPUT_JOYSTICK ]]; then
          ${DEBUG} && log $0 "Found Joystick: ${DEVICE}"
          FOUNDJOY=true
        fi
      fi
    done

    if [ "${FOUNDKEYS}" = "true" ] && [ "${FOUNDJOY}" = "true" ]; then
      ${DEBUG} && log $0 "Found all needed devices."
      KJDEVS=true
      break
    fi

    if [ "${RETRY}" -ge 5 ]; then
      ${DEBUG} && log $0 "Did not find all needed devices, but continuing anyway."
      ${DEBUG} && log $0 "Did not find all of the needed devices, but that may be OK.  Breaking."
      break
    else
      RETRY=$(( RETRY + 1 ))
    fi

    sleep 1
  done
}

get_devices

# If the input devices change, it may be a new controller
# so handle it here.
mkcontroller 2>/dev/null || :

# ------------------------------------------------------------------
# Turn OFF 'exit on error' *now* so a single evtest crash won't kill
# the entire script. We still keep 'pipefail' for partial debugging.
# ------------------------------------------------------------------
set +e

### One evtest per key, joystick or touch device, started as devices come
### and go: a pad plugged in or removed never restarts this script (a
### restart dropped held buttons and left the power button deaf a moment).
### Every HOTPLUG_SCAN seconds the node list is compared (a glob, no
### process); only a changed list asks udev about new nodes.
: "${HOTPLUG_SCAN:=2}"
# 0: watch it, 1: not an input we use, 2: udev has not described it yet.
input_wanted() {
  local INFO
  # archr-keypress's own keyboard (the emulators' save keys) is not ours.
  [ "$(cat "${INPUT_SYSFS:-/sys/class/input}/${1##*/}/device/name" 2>/dev/null)" = archr-keypress ] && return 1
  INFO=$(udevadm info "${1}" 2>/dev/null)
  [[ "${INFO}" =~ ID_INPUT_(KEY|JOYSTICK|TOUCHSCREEN)= ]] && return 0
  [[ "${INFO}" == *ID_INPUT=* ]] && return 1
  return 2
}
watch_inputs() {
  local -A WATCHED=()
  # REMAP_DUE: a device we watch came or went (the first scan only finds
  # the ones already known); nodes nobody watches (archr-keypress's
  # keyboard) never remap the controllers.
  local DEV SEEN="" NOW NODES REMAP="" REMAP_DUE="" FIRST=1
  for DEV in "${INPUT_DEVICES[@]}"; do
    evtest "${DEV}" 2>&1 &
    WATCHED[${DEV}]=$!
  done
  while true; do
    NODES=("${INPUT_DIR}"/event[0-9]*)
    NOW=${NODES[*]}
    if [ "${NOW}" != "${SEEN}" ]; then
      SEEN=${NOW}
      for DEV in "${INPUT_DIR}"/event[0-9]*; do
        [ -e "${DEV}" ] || continue
        [ -n "${WATCHED[${DEV}]:-}" ] && continue
        input_wanted "${DEV}"
        case $? in
          1) continue ;;
          # A node just created: look again at the next scan.
          2) SEEN=""; continue ;;
        esac
        ${DEBUG} && log $0 "Watching ${DEV}"
        evtest "${DEV}" 2>&1 &
        WATCHED[${DEV}]=$!
        [ -n "${FIRST}" ] || REMAP_DUE=1
      done
      FIRST=""
      # The controller mapping follows (it takes seconds on an R36S): in
      # the background, after the new devices are already heard.
    fi
    if [ -n "${REMAP_DUE}" ] && { [ -z "${REMAP}" ] || ! kill -0 "${REMAP}" 2>/dev/null; }; then
      REMAP_DUE=""
      mkcontroller >/dev/null 2>&1 &
      REMAP=$!
    fi
    # An evtest that ended on a node still present (a read error) starts
    # again; a vanished node is forgotten until it comes back.
    for DEV in "${!WATCHED[@]}"; do
      kill -0 "${WATCHED[${DEV}]}" 2>/dev/null && continue
      unset "WATCHED[${DEV}]"
      [ -e "${DEV}" ] || REMAP_DUE=1
      if [ -e "${DEV}" ]; then
        evtest "${DEV}" 2>&1 &
        WATCHED[${DEV}]=$!
      fi
    done
    sleep "${HOTPLUG_SCAN}"
  done
}

### Take action when a known pattern of keys are pressed together.
watch_inputs | grep --line-buffered "EV_KEY\|EV_SW\|error reading" | while next_event; do

    # The switcher's tap, before the actions below (the button may also be
    # a modifier there): pressed, then released with nothing in between.
    # Its own unit: it outlives a restart of this service, and a second
    # tap while it saves finds the unit running.
    # (A case, as below: [[ == ]] would read "*(...)" as an extglob.)
    case ${line} in
      (${FUNCTION_HOTKEY_SWITCHER_EVENT})
        if [[ "${line}" =~ ${PRESS} ]]; then
          SWITCHER_ARMED=${HOTKEY_SWITCHER_ENABLED}
          SWITCHER_DOWN=$(now_ms)
        elif [[ "${line}" =~ ${RELEASE} ]] && ${SWITCHER_ARMED} &&
             [ $(( $(now_ms) - SWITCHER_DOWN )) -lt "${SWITCHER_TAP}" ]; then
          SWITCHER_ARMED=false
          ${DEBUG} && log $0 "${HOTKEY_SWITCHER}: Save and switch"
          systemd-run --no-block --collect --quiet --unit=archr-save-exit \
            /usr/bin/archr-game-save-exit switch >/dev/null 2>&1
        fi
      ;;
      (*)
        ${SWITCHER_ARMED} && [[ "${line}" =~ ${PRESS} ]] && SWITCHER_ARMED=false
      ;;
    esac

    # Parse lines from any evtest instance:
    case ${line} in
      (${DEVICE_DISCONNECTED})
        # watch_inputs notices the node going and coming back.
        ${DEBUG} && log $0 "An input device went away"
      ;;
      (${FUNCTION_MODIFIER_A_EVENT})
        if [[ "${line}" =~ ${PRESS} ]]; then
          ${DEBUG} && log $0 "${FUNCTION_MODIFIER_A_EVENT}: Pressed"
          FN_A_PRESSED=true
        elif [[ "${line}" =~ ${RELEASE} ]]; then
          ${DEBUG} && log $0 "${FUNCTION_MODIFIER_A_EVENT}: Released"
          FN_A_PRESSED=false
        fi
      ;;
      (${FUNCTION_MODIFIER_B_EVENT})
        if [[ "${line}" =~ ${PRESS} ]]; then
          ${DEBUG} && log $0 "${FUNCTION_MODIFIER_B_EVENT}: Pressed"
          FN_B_PRESSED=true
        elif [[ "${line}" =~ ${RELEASE} ]]; then
          ${DEBUG} && log $0 "${FUNCTION_MODIFIER_B_EVENT}: Released"
          FN_B_PRESSED=false
        fi
      ;;
      (${FUNCTION_VOLUME_UP_EVENT})
        if [[ "${line}" =~ ${PRESS} ]]; then
          ${DEBUG} && log $0 "Volume Up: Pressed"
          VOLUME_UP_PRESSED=true
          # Only start volume repeat if no function keys are pressed
          if [ "${FN_A_PRESSED}" = false ] && [ "${FN_B_PRESSED}" = false ]; then
            start_level_hold volume up
          elif [ "${FN_A_PRESSED}" = true ] && [ "${FN_B_PRESSED}" = false ] && [ "${FN_A_ACTION_UP}" = "brightness up" ]; then
            start_level_hold brightness up
          else
            # If function keys are pressed, use the original behavior
            execute_action up
          fi
        elif [[ "${line}" =~ ${RELEASE} ]]; then
          ${DEBUG} && log $0 "Volume Up: Released"
          VOLUME_UP_PRESSED=false
          release_level_hold "${line}"
        fi
      ;;
      (${FUNCTION_VOLUME_DOWN_EVENT})
        if [[ "${line}" =~ ${PRESS} ]]; then
          ${DEBUG} && log $0 "Volume Down: Pressed"
          VOLUME_DOWN_PRESSED=true
          # Only start volume repeat if no function keys are pressed
          if [ "${FN_A_PRESSED}" = false ] && [ "${FN_B_PRESSED}" = false ]; then
            start_level_hold volume down
          elif [ "${FN_A_PRESSED}" = true ] && [ "${FN_B_PRESSED}" = false ] && [ "${FN_A_ACTION_DOWN}" = "brightness down" ]; then
            start_level_hold brightness down
          else
            # If function keys are pressed, use the original behavior
            execute_action down
          fi
        elif [[ "${line}" =~ ${RELEASE} ]]; then
          ${DEBUG} && log $0 "Volume Down: Released"
          VOLUME_DOWN_PRESSED=false
          release_level_hold "${line}"
        fi
      ;;
      (${FUNCTION_POWER_PRESSED_EVENT})
        ${DEBUG} && log $0 "${FUNCTION_POWER_PRESSED_EVENT}: Pressed"
        ${FAKE_SUSPEND} power &
      ;;
      (${FUNCTION_LID_CLOSE_EVENT})
        ${DEBUG} && log $0 "${FUNCTION_LID_CLOSE_EVENT}: Close"
        ${FAKE_SUSPEND} lid close &
      ;;
      (${FUNCTION_LID_OPEN_EVENT})
        ${DEBUG} && log $0 "${FUNCTION_LID_OPEN_EVENT}: Open"
        ${FAKE_SUSPEND} lid open &
      ;;
    esac

    # Hotkey logic
    case ${line} in
      (${FUNCTION_HOTKEY_A_EVENT})
        if [[ "${line}" =~ ${PRESS} ]]; then
          ${DEBUG} && log $0 "${FUNCTION_HOTKEY_A_EVENT}: Pressed"
          HOTKEY_A_PRESSED=true
        elif [[ "${line}" =~ ${RELEASE} ]]; then
          ${DEBUG} && log $0 "${FUNCTION_HOTKEY_A_EVENT}: Released"
          HOTKEY_A_PRESSED=false
        fi
      ;;
      (${FUNCTION_HOTKEY_B_EVENT})
        if [[ "${line}" =~ ${PRESS} ]]; then
          ${DEBUG} && log $0 "${FUNCTION_HOTKEY_B_EVENT}: Pressed"
          HOTKEY_B_PRESSED=true
          # Example: if A and C are also pressed => kill something
          if [ "${HOTKEY_A_PRESSED}" = true ] && [ "${HOTKEY_C_PRESSED}" = true ] && ${HOTKEY_EXIT_ENABLED}; then
            execute_kill
          fi
        elif [[ "${line}" =~ ${RELEASE} ]]; then
          ${DEBUG} && log $0 "${FUNCTION_HOTKEY_B_EVENT}: Released"
          HOTKEY_B_PRESSED=false
        fi
      ;;
      (${FUNCTION_HOTKEY_C_EVENT})
        if [[ "${line}" =~ ${PRESS} ]]; then
          ${DEBUG} && log $0 "${FUNCTION_HOTKEY_C_EVENT}: Pressed"
          HOTKEY_C_PRESSED=true
          # Example: if A and B are also pressed => kill something
          if [ "${HOTKEY_A_PRESSED}" = true ] && [ "${HOTKEY_B_PRESSED}" = true ] && ${HOTKEY_EXIT_ENABLED}; then
            execute_kill
          fi
        elif [[ "${line}" =~ ${RELEASE} ]]; then
          ${DEBUG} && log $0 "${FUNCTION_HOTKEY_C_EVENT}: Released"
          HOTKEY_C_PRESSED=false
        fi
      ;;
      (${FUNCTION_HOTKEY_DPAD_UP_EVENT}|${FUNCTION_HOTKEY_HAT_UP_EVENT})
        if [ "${FN_A_PRESSED}" = true ] && [ "${DPAD_EVENTS}" = true ] && ${HOTKEY_VOLUME_ENABLED}; then
          ${DEBUG} && log $0 "${FUNCTION_HOTKEY_DPAD_UP_EVENT}${FUNCTION_HOTKEY_HAT_UP_EVENT}: Volume Up"
          start_level_hold volume up
        fi
      ;;
      (${FUNCTION_HOTKEY_DPAD_DOWN_EVENT}|${FUNCTION_HOTKEY_HAT_DOWN_EVENT})
        if [ "${FN_A_PRESSED}" = true ] && [ "${DPAD_EVENTS}" = true ] && ${HOTKEY_VOLUME_ENABLED}; then
          ${DEBUG} && log $0 "${FUNCTION_HOTKEY_DPAD_DOWN_EVENT}${FUNCTION_HOTKEY_HAT_DOWN_EVENT}: Volume Down"
          start_level_hold volume down
        fi
      ;;
      (${FUNCTION_HOTKEY_DPAD_RIGHT_EVENT}|${FUNCTION_HOTKEY_HAT_RIGHT_EVENT})
        if [ "${FN_A_PRESSED}" = true ] && [ "${DPAD_EVENTS}" = true ] && ${HOTKEY_BRIGHTNESS_ENABLED}; then
          ${DEBUG} && log $0 "${FUNCTION_HOTKEY_DPAD_RIGHT_EVENT}${FUNCTION_HOTKEY_HAT_RIGHT_EVENT}: Brightness Up"
          start_level_hold brightness up
        fi
      ;;
      (${FUNCTION_HOTKEY_DPAD_LEFT_EVENT}|${FUNCTION_HOTKEY_HAT_LEFT_EVENT})
        if [ "${FN_A_PRESSED}" = true ] && [ "${DPAD_EVENTS}" = true ] && ${HOTKEY_BRIGHTNESS_ENABLED}; then
          ${DEBUG} && log $0 "${FUNCTION_HOTKEY_DPAD_LEFT_EVENT}${FUNCTION_HOTKEY_HAT_LEFT_EVENT}: Brightness Down"
          start_level_hold brightness down
        fi
      ;;
      (${FUNCTION_HOTKEY_TOUCH_EVENT})
        if [ "${FN_A_PRESSED}" = true ] && [ "${TOUCHSCREEN_EVENTS}" = true ]; then
          ${DEBUG} && log $0 "${FUNCTION_HOTKEY_TOUCH_EVENT}: Toggle Touchscreen Keyboard"
          kill -34 $(pidof wvkbd-mobintl)
        fi
      ;;
      (${FUNCTION_HOTKEY_SCREENSHOT_EVENT})
        if [ "${HOTKEY_A_PRESSED}" = true ] && ${HOTKEY_SCREENSHOT_ENABLED}; then
          ${DEBUG} && log $0 "${FUNCTION_HOTKEY_SCREENSHOT_EVENT}: Screenshot"
          /usr/bin/archr-screenshot
          # Display notification if 'success' exit code
          SCREENSHOT_SUCCESS=$?
          [ "$SCREENSHOT_SUCCESS" -eq 0 ] && /usr/bin/mako-notify "Screenshot Saved" -no-ra
        fi
      ;;
     (${FUNCTION_HOTKEY_MANGOHUD_EVENT})
        if [ "${HOTKEY_A_PRESSED}" = true ] && ${HOTKEY_MANGOHUD_ENABLED}; then
          ${DEBUG} && log $0 "${FUNCTION_HOTKEY_MANGOHUD_EVENT}: Config MangoHud"
          /usr/bin/mangohud_set toggle
        fi
      ;;
     (${FUNCTION_HOTKEY_BTN_BACK_EVENT}|${FUNCTION_HOTKEY_KEY_RECORD_EVENT})
       if [ "${HOTKEY_A_PRESSED}" = true ]; then
         ${DEBUG} && log $0 "${FUNCTION_HOTKEY_BTN_BACK_EVENT}: Switch Screen Output"
         /usr/bin/screen_switch
       fi
     ;;
     (${FUNCTION_HOTKEY_BTN_NORTH_EVENT})
       if [ "${HOTKEY_A_PRESSED}" = true ]; then
         ${DEBUG} && log $0 "${FUNCTION_HOTKEY_BTN_NORTH_EVENT}: Opening Game Guide"
         /usr/bin/game-guides-tool
       fi
     ;;
     (*", value 0")
       # A level held with the dpad stops when its button is released.
       release_level_hold "${line}"
     ;;
  esac
done
