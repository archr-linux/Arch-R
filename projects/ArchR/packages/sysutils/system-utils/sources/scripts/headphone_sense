#!/bin/bash

# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2020-present Shanti Gilbert (https://github.com/shantigilbert)
# Copyright (C) 2023 JELOS (https://github.com/JustEnoughLinuxOS)

. "${ARCHR_PROFILE:-/etc/profile}"

if [[ ${AUDIO_MANAGEMENT} == "UCM" ]]; then
    volume restore
    exit 0
fi

# The switch value that means headphones in. On most of these boards the
# switch is inverted (0 = headphones in); a quirk sets 1 where the jack
# reads the right way round.
HP_IN="${DEVICE_HEADPHONE_INSERTED:-0}"

# Sync with the REAL jack state at startup. The kernel keeps the switch
# state in the input device (EV_SW/SW_HEADPHONE_INSERT), so query it via
# evtest --query (exit 10 = bit set, 0 = clear) instead of trusting a
# saved setting or the legacy /sys/class/gpio number, which mainline
# kernels don't even expose.
# Fallback order: input switch, legacy gpio node when it exists, speakers.
JACK_STATE="speakers"
if [ -n "${DEVICE_HEADPHONE_DEV}" ] && [ -e "${DEVICE_HEADPHONE_DEV}" ]; then
  evtest --query "${DEVICE_HEADPHONE_DEV}" EV_SW SW_HEADPHONE_INSERT
  case "${HP_IN}:$?" in
    0:0 | 1:10) JACK_STATE="headphone" ;;
  esac
elif [ -n "${DEVICE_JACK}" ] && [ -e "/sys/class/gpio/gpio${DEVICE_JACK}/value" ]; then
  [ "$(cat /sys/class/gpio/gpio${DEVICE_JACK}/value)" = "0" ] && JACK_STATE="headphone"
fi

### Set the default audio path, needed for some devices
if [ -z "${DEVICE_PLAYBACK_PATH}" ]
then
  DEVICE_PLAYBACK_PATH="Playback Path"
fi

# Moves the mux and records where the sound goes, in that order: when the
# mixer refuses (no such control, no such item, no card yet) audio.device
# keeps saying where the sound really is, and the journal says why.
# Where the speaker sits on the same lines as the headphones (the mux
# alone cannot take the sound off it), DEVICE_SPEAKER_SWITCH names the
# mixer switch that gates it: off for headphones, on for speakers.
set_path() {
  if ! amixer -c 0 cset "name=${DEVICE_PLAYBACK_PATH}" "${1}" >/dev/null; then
    echo "headphone_sense: could not set '${DEVICE_PLAYBACK_PATH}' to '${1}' for ${2}; audio.device left as it was" >&2
    return
  fi
  if [ -n "${DEVICE_SPEAKER_SWITCH}" ]; then
    local gate=on
    [ "${2}" = headphone ] && gate=off
    if ! amixer -c 0 cset "name=${DEVICE_SPEAKER_SWITCH}" "${gate}" >/dev/null; then
      echo "headphone_sense: could not set '${DEVICE_SPEAKER_SWITCH}' to '${gate}' for ${2}; audio.device left as it was" >&2
      return
    fi
  fi
  set_setting "audio.device" "${2}"
}

# An explicit request wins; "auto" (or nothing) follows the jack state
# detected above, so a reboot with headphones plugged starts on HP.
case "${2:-${JACK_STATE}}" in
    "headphone")
        set_path "${DEVICE_PLAYBACK_PATH_HP}" headphone
    ;;
    "auto"|"speakers"|*)
        set_path "${DEVICE_PLAYBACK_PATH_SPK}" speakers
    ;;
esac

volume restore

# Headphone sensing
DEVICE="${DEVICE_HEADPHONE_DEV}"

# No jack input device on this board: nothing to watch, the initial
# path set above is all there is (evtest on an empty path would just
# die and burn a service restart cycle).
if [ -z "${DEVICE}" ] || [ ! -e "${DEVICE}" ]; then
    exit 0
fi

HP_ON="*(SW_HEADPHONE_INSERT), value ${HP_IN}*"
HP_OFF="*(SW_HEADPHONE_INSERT), value $((1 - HP_IN))*"

evtest "${DEVICE}" | while read line; do
    case $line in
	(${HP_ON})
	set_path "${DEVICE_PLAYBACK_PATH_HP}" headphone
	;;
	(${HP_OFF})
	set_path "${DEVICE_PLAYBACK_PATH_SPK}" speakers
	;;
    esac
done
