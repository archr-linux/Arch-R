#!/bin/bash

# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026-present ArchR (https://github.com/archr-linux/Arch-R)

# archr-port-install install|uninstall <port.zip>
#
# Exit codes: 0 done, 2 bad arguments, 3 already installed (not by an app:
# its files are in place), 4 not in the catalog, other: harbourmaster's.
#
# A port from the official PortMaster catalog, by its catalog name, through
# PortMaster's own harbourmaster: it downloads from the PortMaster release,
# checks the md5, unpacks into /storage/roms/ports and fetches the runtimes the
# port needs. The launcher runs this for apps of modules (API 4, port.install):
# only a catalog name ever reaches it, never a file or a URL.

action=$1
name=$2
case "$action" in
  install | uninstall) ;;
  *) echo "usage: archr-port-install install|uninstall <port.zip>" >&2; exit 2 ;;
esac
if ! [[ "$name" =~ ^[a-z0-9][a-z0-9._-]{0,59}\.zip$ ]]; then
  echo "invalid port name: $name" >&2
  exit 2
fi

. /etc/profile
. /usr/bin/portmaster_prepare >/dev/null 2>&1

cd /storage/roms/ports/PortMaster || exit 1

# A port the user already has (any of its files in place) is theirs: an app
# never installs over it. The file list comes from the official catalog,
# cached for an hour.
if [ "$action" = install ]; then
  catalog=/tmp/archr-ports.json
  if [ -z "$(find "$catalog" -mmin -60 2>/dev/null)" ]; then
    curl -fsSL --max-time 60 -o "$catalog.part" \
      https://github.com/PortsMaster/PortMaster-New/releases/latest/download/ports.json &&
      mv "$catalog.part" "$catalog"
  fi
  items=$(jq -r --arg n "$name" '.ports[$n].items[]? // empty' "$catalog" 2>/dev/null) || items=
  if [ -z "$items" ]; then
    echo "Unable to find $name in the PortMaster catalog" >&2
    exit 4
  fi
  while IFS= read -r item; do
    case "$item" in /* | *..*) echo "bad item in catalog: $item" >&2; exit 4 ;; esac
    if [ -e "/storage/roms/ports/$item" ] || [ -L "/storage/roms/ports/$item" ]; then
      echo "port already installed" >&2
      exit 3
    fi
  done <<< "$items"
fi

set -o pipefail
# pm/: the PortMaster repository only. harbourmaster draws its download bars
# as "<done> <unit> / <total> <unit>"; they become "PROGRESS <0-100>" lines.
target=$name
[ "$action" = install ] && target="pm/$name"
# Stopped half way (a timeout, a game starting): take back what was unpacked.
if [ "$action" = install ]; then
  trap './harbourmaster --quiet uninstall "$name" >/dev/null 2>&1; exit 143' TERM INT
fi
# The bars are redrawn with carriage returns: one per line for awk.
./harbourmaster --quiet "$action" "$target" 2>&1 | tr '\r' '\n' | awk '
  function bytes(n, u) { return n * (u == "KB" ? 1e3 : u == "MB" ? 1e6 : u == "GB" ? 1e9 : 1) }
  {
    line = $0
    while (match(line, /[0-9.]+ [KMG]?B \/ [0-9.]+ [KMG]?B/)) {
      split(substr(line, RSTART, RLENGTH), f, " ")
      total = bytes(f[4], f[5])
      p = total > 0 ? int(100 * bytes(f[1], f[2]) / total) : 0
      if (p != last) { print "PROGRESS " p; fflush(); last = p }
      line = substr(line, RSTART + RLENGTH)
    }
  }
  /^(Unable|Error|Failed)/ { print > "/dev/stderr" }'
