# shellcheck source=/dev/null
. "${ARCHR_SCREENSHOT_PROFILE:-/etc/profile}"

# The running game (runemu.sh records its ROM path) names the file as
# RetroArch names its own captures, <rom>-AAMMDD-HHMMSS.png, so the
# launcher shows it among that game's screenshots. Without a game: the date.
# Characters a FAT/exFAT card refuses become "_". Two ROMs whose names
# differ only in those characters ("A:B" and "A?B") then share captures
# "A_B-...": the launcher lists them under both games. Rare, and harmless
# (no file is overwritten: the time is in the name).
CURRENT_GAME="${ARCHR_CURRENT_GAME:-/run/archr/current-game}"
# runemu.sh writes the ROM path, then its PID: a record whose runemu.sh is
# no longer running belongs to no game.
screenshot_name() {
  local rom="" pid="" stem
  if [ -r "${CURRENT_GAME}" ]; then
    { IFS= read -r rom; IFS= read -r pid; } <"${CURRENT_GAME}"
  fi
  [[ "${pid}" =~ ^[0-9]+$ ]] && kill -0 "${pid}" 2>/dev/null || rom=""
  stem="${rom##*/}"
  stem="${stem%.*}"
  if [ -n "${stem}" ]; then
    printf '%s-%s.png' "${stem//[:?*\"<>|\\]/_}" "$(date +'%y%m%d-%H%M%S')"
  else
    printf '%s.png' "$(date +'%Y-%m-%d-%H%M%S')"
  fi
}

# The shortcut's on/off state (hotkey.screenshot.enabled) belongs to
# input_sense, which only calls this script when it is on.

# RetroArch is no exception: it runs fullscreen as a client of the sway
# session, so grim captures what the player sees, the same way it does for
# the other emulators, and the name above is the one RetroArch gives its
# own captures (auto_screenshot_filename), so the launcher lists both alike.

# Folder to save screenshots
SAVE_DIR="${ARCHR_SCREENSHOT_DIR:-/storage/roms/screenshots}"

# Create the folder if it doesn't exist
mkdir -p "$SAVE_DIR"

# The game's name and the time
FILENAME="$(screenshot_name)"
FULL_PATH="${SAVE_DIR}/${FILENAME}"

# Get focused window geometry
GEOMETRY=$(swaymsg -t get_tree | jq -r '
..
  | select(.type? == "con" and .focused == true)
  | "\(.rect.x),\(.rect.y) \(.rect.width)x\(.rect.height)"' | head -n 1
)

# Take screenshot of the focused window (the whole output when sway reports
# none focused). A failed capture leaves no file and exits 1.
if [ -n "$GEOMETRY" ]; then
  grim -g "$GEOMETRY" "$FULL_PATH"
else
  grim "$FULL_PATH"
fi
if [ ! -s "$FULL_PATH" ]; then
  rm -f "$FULL_PATH"
  exit 1
fi

# 'success' (screenshot taken) exit code
exit 0
