# Minimal per-device config: wire up the temperature sensors so System
# Information (archr-info) and the launcher show CPU/GPU temps. The
# quirks loader matches the folder name against /proc/device-tree/model
# exactly, so this folder name MUST equal the DTS `model` string.
# The playback mux position that reaches the speaker depends on which
# card the overlay enabled. rk817-sound-amplified feeds the external amp
# from HPOL/HPOR, so the speaker is on "HP" too (the codec has no
# use-ext-amplifier here, so "SPK" goes to the unconnected class-D) and
# the amp is gated by the card's "Internal Speakers" pin. The other
# cards drive the speaker from the class-D, on "SPK" (Arch-R#35).
DT="${ARCHR_DT:-/proc/device-tree}"
card_on() { [ "$(tr -d '\0' <"${DT}/${1}/status" 2>/dev/null)" = "okay" ]; }
if card_on rk817-sound-amplified; then
  SPK_PATH="HP" JACK_DEV="/dev/input/by-path/platform-rk817-sound-amplified-event"
elif card_on rk817-sound-simple; then
  SPK_PATH="SPK" JACK_DEV="/dev/input/by-path/platform-rk817-sound-simple-event"
else
  SPK_PATH="SPK" JACK_DEV="/dev/input/by-path/platform-rk817-sound-event"
fi

cat <<CONF >"${ARCHR_PROFILE_DIR:-/storage/.config/profile.d}/001-device_config"
# LED nodes use color+function (no label), so sysfs is blue:power.
# Surfaces the DISABLE POWER LED switch in ES (the var is already in
# the 999-export allowlist; no quirk ever set it, so the item was
# invisible on every device).
DEVICE_PWR_LED_CONTROL="true"
DEVICE_POWER_LED="blue:power"
# Playback mux and jack input of the active card (see above).
DEVICE_PLAYBACK_PATH_SPK="${SPK_PATH}"
DEVICE_PLAYBACK_PATH_HP="HP"
DEVICE_HEADPHONE_DEV="${JACK_DEV}"
DEVICE_TEMP_SENSOR="/sys/devices/virtual/thermal/thermal_zone0/temp"
DEVICE_GPU_TEMP_SENSOR="/sys/devices/virtual/thermal/thermal_zone1/temp"
CONF
