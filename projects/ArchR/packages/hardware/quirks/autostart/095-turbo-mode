. /etc/profile.d/001-functions

# Get Turbo Mode state. 
TURBO_MODE_STATE=$(get_setting "enable.turbo-mode")
if [ ! -n "${TURBO_MODE_STATE}" ]; then
  TURBO_MODE_STATE=0
  set_setting "enable.turbo-mode" "0"
fi

# Set turbo-mode at boot (set_cpu_boost leaves a SoC with no boost OPP,
# such as the RK3562, alone).
. /etc/profile.d/099-freqfunctions
set_cpu_boost "${TURBO_MODE_STATE}"
