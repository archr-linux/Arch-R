# Panfrost / Mali-G31 (Bifrost) tuning. Sourced by /etc/profile so the vars
# reach login shells AND every emulator launched from runemu.sh / start_*.sh
# (which both do `. /etc/profile`). Previously these lived in a quirks/
# autostart subshell that exited immediately, so the shader cache and Mesa
# error-skip flags never reached emulator processes.

# Skip GL error checking — emulators don't query glGetError defensively.
export MESA_NO_ERROR=1

# Persistent shader cache via the FHS bridge symlink set up by the
# archr meta-package: /var/cache/mesa -> /storage/.cache/mesa_shader_cache.
# Surfaces an Arch-friendly path while the writes still land on the rw
# storage overlay so the cache survives reboots.
export MESA_SHADER_CACHE_DIR=/var/cache/mesa
export MESA_SHADER_CACHE_MAX_SIZE=128MB

# Vulkan (PanVK, Mesa) on the Mali-G31: Mesa refuses Bifrost (v7) unless this
# is set ("panvk is not well-tested on v7"). Exported only while panfrost
# drives the GPU, so every process (emulators, ports, vulkaninfo) finds the
# Vulkan 1.0 device; on libmali the PanVK ICD is masked and nothing changes.
[ -d /sys/module/panfrost ] && export PAN_I_WANT_A_BROKEN_VULKAN_DRIVER=1
