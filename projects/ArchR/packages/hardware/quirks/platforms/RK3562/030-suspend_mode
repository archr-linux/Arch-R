# Kernel suspend does not survive on the RK3562 with linux 7.3 either: an
# AISLPC RG43V PRO set to a kernel sleep state froze in "PM: suspend entry
# (deep)" until a reset (error report, 2026-11-28), as the RK3326 does.
# So the power button always takes the archr-fake-suspend path (display
# off, audio muted, powersave governors, input grabbed):
#  - the launcher reads 030-suspend-kernel and offers no kernel state;
#  - a kernel state saved before (the launcher offered them) goes back to
#    "off", the same as an empty key.
#
# Runs in two roles: at boot, and from the suspendmode script when the
# user picks "default".
. /etc/profile

mkdir -p /storage/.config/profile.d
cat <<CFG >/storage/.config/profile.d/030-suspend-kernel
DEVICE_SUSPEND_KERNEL="false"
CFG

if [ "$(get_setting system.suspendmode)" != "off" ]; then
  /usr/bin/suspendmode off >/dev/null 2>&1
fi
