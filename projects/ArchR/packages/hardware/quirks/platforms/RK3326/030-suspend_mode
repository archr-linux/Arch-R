# Kernel suspend does not survive on px30 mainline (mem hangs on entry,
# freeze never wakes, RTC alarm included; tested 2026-07-07 on the
# Soysauce, and seen again on R36S consoles in 2026-11: the power button
# froze them in "PM: suspend entry (deep)" until a reset). So the power
# button always takes the archr-fake-suspend path (display off, audio
# muted, powersave governors, input grabbed):
#  - the launcher reads 030-suspend-kernel and offers no kernel state;
#  - a kernel state saved before (an older launcher offered them) goes
#    back to "off", the same as an empty key.
#
# Runs in two roles: at boot, and from the suspendmode script when the
# user picks "default".
. /etc/profile

mkdir -p /storage/.config/profile.d
cat <<CFG >/storage/.config/profile.d/030-suspend-kernel
DEVICE_SUSPEND_KERNEL="false"
CFG

if [ "$(get_setting system.suspendmode)" != "off" ]; then
  /usr/bin/suspendmode off >/dev/null 2>&1
fi
