#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2026 ArchR (https://github.com/archr-linux/Arch-R)
#
# archr-error-report: an anonymous text report of one failure, queued and
# sent to arch-r.io, so the developers see what breaks without anyone
# opening an issue. Settings > System > Error reports turns it off
# (system.error_reports=0; on when the key is missing). Nothing runs until
# something fails:
#
#   archr-error-report game RC SECONDS OFFSET SYSTEM EMULATOR CORE -- ARGS...
#       runemu.sh, after a game or app exited with RC; OFFSET is where this
#       run's output starts in exec.log, ARGS what runemu.sh was given.
#   archr-error-report port RC SECONDS OFFSET SCRIPT -- ARGS...
#       runemu.sh, after every port (PortMaster, Itch.io) or Windows run:
#       its script often exits 0 when the game inside failed, so the run's
#       output decides (see port_failures).
#   archr-error-report unit UNIT       a service failed (OnFailure= of archr-*, iwd,
#                                      connman and sway)
#   archr-error-report kernel          at boot: an oops or panic kept in pstore
#   archr-error-report launcher RC     the launcher exited with RC (its session)
#   archr-error-report module ID RC    a launcher module exited with RC
#   archr-error-report send            the queue goes out (archr-error-report.path:
#                                      a new report or a network change)
#
# One report per error: its signature (event, what failed and its first
# error lines with the numbers taken out) is sent once; a repeat only counts
# up in "seen". At most 10 reports a day, 20 waiting. Reports are filtered by
# archr-report --sanitize, then lose addresses (IPv4, IPv6, MAC), Wi-Fi
# names and the user's account names. The game's name stays: games are
# public. Files: /storage/.cache/error-reports/{queue,sent}/<date>_<time>.txt,
# the last 20 sent are kept for the launcher's viewer.
#
# ARCHR_ERROR_REPORT_ROOT prefixes every file (tests); ARCHR_ERROR_REPORT_URL
# replaces the server, ARCHR_ERROR_REPORT_ROUTE_WAIT the wait for a
# network and ARCHR_ERROR_REPORT_DISPLAY_WAIT the one for a screen (tests
# only).

ROOT="${ARCHR_ERROR_REPORT_ROOT:-}"
URL="${ARCHR_ERROR_REPORT_URL:-https://arch-r.io/api/reports}"
DIR="${ROOT}/storage/.cache/error-reports"
QUEUE="${DIR}/queue"
SENT="${DIR}/sent"
CFG="${ROOT}/storage/.config/system/configs/system.cfg"
EXEC_LOG="${ROOT}/var/log/exec.log"
DAILY=10
WAITING=20
KEEP=20
CAP=$((256 * 1024))
LIMIT=10
ROUTE_WAIT="${ARCHR_ERROR_REPORT_ROUTE_WAIT:-20}"
DISPLAY_WAIT="${ARCHR_ERROR_REPORT_DISPLAY_WAIT:-60}"
TODAY=$(date +%F)

setting() { sed -n "s/^$1=//p" "${CFG}" 2>/dev/null | tail -n 1; }
enabled() { [ "$(setting system.error_reports)" != 0 ]; }
# CMD... with a time limit; nothing when CMD is missing.
run() { command -v "$1" >/dev/null 2>&1 && timeout "${LIMIT}" "$@" 2>&1; }
section() {
  echo
  echo "--- $1 ---"
}

# "date created sent" of today (zeros on a new day).
counts() {
  local day created sent
  read -r day created sent 2>/dev/null <"${DIR}/today"
  [ "${day}" = "${TODAY}" ] || created=0 sent=0
  echo "${created:-0} ${sent:-0}"
}
bump() {
  local created sent
  read -r created sent <<<"$(counts)"
  case "$1" in
    created) created=$((created + 1)) ;;
    sent) sent=$((sent + 1)) ;;
  esac
  echo "${TODAY} ${created} ${sent}" >"${DIR}/today"
}

# "128+n" is signal n. TERM, KILL, INT and HUP come from outside (the exit
# hotkey, a shutdown), not from a bug; a KILL from the OOM killer counts.
describe() {
  local rc=$1
  if [ "${rc}" -gt 128 ] && [ "${rc}" -lt 160 ]; then
    echo "${rc} (SIG$(kill -l $((rc - 128)) 2>/dev/null))"
  else
    echo "${rc}"
  fi
}
external() {
  case "$1" in
    0 | 129 | 130 | 143) return 0 ;;
    137) ! run dmesg | tail -n 80 | grep -qiE 'out of memory|oom-kill' ;;
    *) return 1 ;;
  esac
}

# The error lines that make a signature: numbers, addresses and quotes
# taken out, so the same fault matches on every run and every console.
errors() {
  # A core asking for an option this build does not define logs it as an
  # [ERROR] on every run (flycast2021_cpu_mode): not why a game failed.
  grep -aiE 'error|fail|fatal|abort|assert|segmentation|exception|panic|cannot|unable|not found|unhandled|internal error|bug:' |
    grep -avE 'GET_VARIABLE: .* - Invalid value' |
    sed -E 's/0x[0-9a-fA-F]+/#/g; s/[0-9]+/#/g; s/"[^"]*"/""/g; s/^[[:space:]#.:-]*//' | head -n "${1:-3}"
}

# Names that would point at the user: account and Wi-Fi names, the
# netplay nickname and the host name, one per line.
personal() {
  local f name
  setting global.retroachievements.username
  setting global.netplay.nickname
  sed -n 's/^cheevos_username *= *"\(.*\)"/\1/p' "${ROOT}/storage/.config/retroarch/retroarch.cfg" 2>/dev/null
  sed -n 's/^user *= *"\(.*\)"/\1/p' "${ROOT}/storage/.config/archr-launcher/scraper.toml" 2>/dev/null
  # The host name only when it is the console's own (archr-1a2b).
  grep -v '^archr$' "${ROOT}/proc/sys/kernel/hostname" 2>/dev/null
  for f in "${ROOT}"/storage/.cache/iwd/*.psk "${ROOT}"/storage/.cache/iwd/*.open "${ROOT}"/storage/.cache/iwd/*.8021x; do
    [ -e "${f}" ] || continue
    name=${f##*/}
    name=${name%.*}
    # iwd writes names it cannot keep as "=" and hex.
    if [[ "${name}" == =* ]]; then
      name=$(printf '%b' "$(sed 's/../\\x&/g' <<<"${name#=}")")
    fi
    echo "${name}"
  done
}
# archr-report's filter, then addresses and the names above.
scrub() {
  local names
  names=$(personal | awk 'length($0) >= 3' | sort -u)
  archr-report --sanitize | NAMES="${names}" LC_ALL=C gawk '
    BEGIN {
      IGNORECASE = 1
      n = split(ENVIRON["NAMES"], name, "\n")
    }
    {
      line = $0
      for (i = 1; i <= n; i++) {
        out = ""
        while ((at = index(tolower(line), tolower(name[i]))) > 0) {
          out = out substr(line, 1, at - 1) "<name>"
          line = substr(line, at + length(name[i]))
        }
        line = out line
      }
      line = gensub(/([0-9a-f]{2}[:-]){5}[0-9a-f]{2}/, "<mac>", "g", line)
      line = gensub(/([0-9a-f]{1,4}:){7}[0-9a-f]{1,4}/, "<ip>", "g", line)
      # "::" with a group on at least one side ("r36s :: 1900..." is a pad).
      line = gensub(/(^|[^[:alnum:]_:])(([0-9a-f]{1,4}(:[0-9a-f]{1,4}){0,6})?::[0-9a-f]{1,4}(:[0-9a-f]{1,4}){0,6}|[0-9a-f]{1,4}(:[0-9a-f]{1,4}){0,6}::)(%[[:alnum:]]+)?($|[^[:alnum:]_:(<])/, "\\1<ip>\\8", "g", line)
      line = gensub(/(^|[^0-9.])([0-9]{1,3}\.){3}[0-9]{1,3}/, "\\1<ip>", "g", line)
      line = gensub(/((ssid|essid)["]?[[:space:]]*[=:][[:space:]]*["]?)[^[:space:]",;]+/, "\\1<name>", "g", line)
      print line
    }'
}

# The pieces every report carries after its own: state, packages, kernel.
common() {
  section state
  archr-report --state 2>/dev/null
  section packages
  run pacman -Q archr archr-launcher "$@"
  section "kernel log (last 60 lines)"
  run dmesg | tail -n 60
}

# Queue the report BUILD ARGS... writes (a function) unless its signature
# was reported before or a limit is reached.
queue() {
  # Locals with a leading _: BUILD sees the event function's own (bash
  # scoping is dynamic), which a plain "name" here would hide.
  local _signature=$1 _build=$2 _created _name _tmp
  shift 2
  mkdir -p "${QUEUE}" "${SENT}" || return 1
  exec 9>"${DIR}/.lock"
  # BusyBox flock has no -w: the lock outlives the timed child (same file).
  timeout 30 flock -x 9 || return 1
  if grep -q "^${_signature} " "${DIR}/seen" 2>/dev/null; then
    awk -v s="${_signature}" -v d="${TODAY}" '$1 == s { $2++; $3 = d } 1' "${DIR}/seen" >"${DIR}/seen.tmp" &&
      mv -f "${DIR}/seen.tmp" "${DIR}/seen"
    echo "archr-error-report: ${_signature} seen before, counted" >&2
    return 0
  fi
  read -r _created _ <<<"$(counts)"
  if [ "${_created}" -ge "${DAILY}" ] ||
    [ "$(find "${QUEUE}" -name '*.txt' | wc -l)" -ge "${WAITING}" ]; then
    echo "archr-error-report: limit reached, ${_signature} not reported" >&2
    return 0
  fi
  _name="$(date +%F_%H-%M-%S).txt"
  while [ -e "${QUEUE}/${_name}" ] || [ -e "${SENT}/${_name}" ]; do
    sleep 1
    _name="$(date +%F_%H-%M-%S).txt"
  done
  _tmp="${DIR}/.${_name}"
  {
    echo "ArchR error report"
    echo "when: $(date '+%F %T %z')"
    "${_build}" "$@"
  } 2>&1 | scrub >"${_tmp}.full"
  if [ "$(stat -c %s "${_tmp}.full")" -gt "${CAP}" ]; then
    head -c "$((CAP - 64))" "${_tmp}.full" >"${_tmp}"
    printf '\n[cut at 256 KB]\n' >>"${_tmp}"
    rm -f "${_tmp}.full"
  else
    mv -f "${_tmp}.full" "${_tmp}"
  fi
  echo "${_signature} 1 ${TODAY}" >>"${DIR}/seen"
  bump created
  mv -f "${_tmp}" "${QUEUE}/${_name}"
  echo "archr-error-report: queued ${_name} (${_signature})" >&2
}
# --- ports ---

# Lines that say a port failed, whatever the script returned: a crash, a
# missing library or file, a script error (bash's "x.sh: line N: ...",
# the way a missing PortMaster/control.txt shows), an interpreter's
# traceback, a graphics or runtime that did not start. Built from real
# port logs: PortMaster's own noise (sway fullscreen retries, the
# arcajs localStorage on a first run, device_info's null byte, GTK and
# libcurl warnings) matches none of them.
PORT_FAILS='(Segmentation fault|Illegal instruction|Bus error|Floating point exception|Aborted)( |$|\()|core dumped'
PORT_FAILS+='|error while loading shared libraries|cannot open shared object file|GLIBC_[0-9.]+. not found'
PORT_FAILS+='|\.(sh|txt): line [0-9]+: |^(ba)?sh: |command not found|exec format error'
PORT_FAILS+='|Traceback \(most recent call last\)|stack traceback:|^(lua|love|python[0-9.]*): |Error: \[string'
PORT_FAILS+='|Unhandled [Ee]xception|Exception in thread|DllNotFoundException|TypeLoadException'
PORT_FAILS+='|FATAL|[Ff]atal( error)?:|Fatal error|[Ff]ailed to (load|initiali[sz]e|create|open (display|window))'
PORT_FAILS+='|(Could not|Unable to|Couldn.t) (initiali[sz]e|create|open (display|window|audio)|load)'
# NextOS ports: NXExtract's verdict, and a crash their wrappers log.
PORT_FAILS+='|TERMINAL ERROR NXE[0-9]+|(signal|signum|child_signal)[ =]+(4|6|7|8|11)([^0-9]|$)'
PORT_FAILS+='|SDL_(CreateWindow|Init|GL_CreateContext|CreateRenderer)|EGL_(BAD|NOT)_|eglInitialize|GL_INVALID|GLSL.*error'
PORT_FAILS+='|Error loading needed lib|Unimplemented Opcode|PltResolver|[Ff]ailed to start [Ww]eston|westonpack.*(error|fail)'
PORT_FAILS+='|gmloader.*(error|[Ff]ailed|abort)|Missing runtime|requires the latest PortMaster|[Nn]o such runtime'
# Never a failure: warnings, and what ArchR's helpers print on every run.
PORT_NOISE='[Ww][Aa][Rr][Nn]|ignored null byte|no version information available|Failed, waiting to try again'
PORT_NOISE+='|^[[:space:]]*"(success|parse_error|error)":|localStorage load file|arm_release_ver'
# NetSurf with no translation for the locale (it falls back to English).
PORT_NOISE+='|Message translations failed to load'
# bash reporting a job it lost to a signal from outside (the exit hotkey).
PORT_NOISE+='|line [0-9]+: +[0-9]+ (Killed|Terminated|Hangup|Interrupt)'
# Lines that only look like errors: they count on a run that ended
# within SHORT seconds (nothing was played).
PORT_SOFT='[Ee]rror|ERROR|[Ff]ail|[Cc]annot|[Uu]nable to|not found|No such file'
SHORT=5

# The failure lines of a run (stdin), the strongest first; a "Killed"
# counts only when the kernel's OOM killer did it (else it is the exit
# hotkey or a shutdown).
port_failures() {
  local seconds=$1 out
  out=$(grep -av -E "${PORT_NOISE}")
  grep -a -E "${PORT_FAILS}" <<<"${out}"
  if grep -aqE '(^| )Killed( |$)' <<<"${out}" && run dmesg | tail -n 80 | grep -qiE 'out of memory|oom-kill'; then
    grep -aE '(^| )Killed( |$)' <<<"${out}"
  fi
  [ "${seconds}" -lt "${SHORT}" ] && grep -a -E "${PORT_SOFT}" <<<"${out}" | grep -av -E "${PORT_FAILS}"
  :
}
# A line with what varies taken out: paths down to the file name, numbers.
normalize() {
  sed -E 's#[^ :"'"'"'(]*/([^/ :"'"'"')]*)#\1#g; s/0x[0-9a-fA-F]+/#/g; s/[0-9]+/#/g; s/^[[:space:]#.:-]*//'
}
# The port's folder: the one whose port.json lists the script, else the
# script's GAMEDIR=.../<folder>.
port_dir() {
  local script=$1 base=${1##*/} json dir
  for json in "${script%/*}"/*/port.json; do
    [ -f "${json}" ] || continue
    jq -e --arg s "${base}" '.items // [] | index($s)' "${json}" >/dev/null 2>&1 && {
      echo "${json%/port.json}"
      return
    }
  done
  dir=$(sed -n 's#^[[:space:]]*GAMEDIR=.*/\([^/"$ ]*\)"\{0,1\}[[:space:]]*$#\1#p' "${script}" 2>/dev/null | head -n 1)
  [ -n "${dir}" ] && [ -d "${script%/*}/${dir}" ] && echo "${script%/*}/${dir}"
}

# The port's own logs written during this run, one per line.
port_logs() {
  [ -d "$1" ] || return 0
  find "$1" -maxdepth 2 -type f \( -name '*.log' -o -name 'log.txt' -o -name '*log*.txt' \) \
    -newermt "@$(($(date +%s) - $2 - 5))" 2>/dev/null | head -n 3
}
# Whether the script tees that log: then it is the run output already.
teed() { grep -q "tee .*${1##*/}" "$2" 2>/dev/null; }

port() {
  local rc=$1 seconds=$2 offset=$3 script="${ROOT}$4" dir json pm name failures own f
  shift 4
  [ "$1" = -- ] && shift
  OUTPUT=$(tail -c +"$((offset + 1))" "${EXEC_LOG}" 2>/dev/null | tail -n 300)
  dir=$(port_dir "${script}")
  # Many ports write their own log and nothing to exec.log: their failure
  # lines are there.
  LOGS=$(port_logs "${dir}" "${seconds}")
  own=$(while IFS= read -r f; do
    [ -n "${f}" ] && ! teed "${f}" "${script}" && tail -n 300 "${f}"
  done <<<"${LOGS}")
  # A NextOS port whose game files are missing or broken (NXExtract's source
  # errors; before 1.2.10 only the message) says so on the screen: the
  # user's to fix, not a failure.
  grep -aqE 'TERMINAL ERROR NXE200[12]|ERROR: no APK, APKM, APKS, XAPK' <<<"${own}" && return 0
  failures=$(printf '%s\n%s\n' "${OUTPUT}" "${own}" | port_failures "${seconds}" | awk '!seen[$0]++' | head -n 20)
  # Nothing failed: a clean exit, or one from outside.
  if [ -z "${failures}" ]; then
    { [ "${rc}" = 0 ] || external "${rc}"; } && return 0
  fi
  json="${dir}/port.json"
  pm="${ROOT}/storage/roms/ports/PortMaster"
  name=$(jq -r '.attr.title // .name // empty' "${json}" 2>/dev/null)
  name=${name:-$(basename "${script}" .sh)}
  FAILURES=${failures}
  build() {
    local f elf=0 runtime
    echo "event: port"
    echo "what: ${name}"
    echo "game: ${script##*/}"
    echo "exit: $(describe "${rc}") after ${seconds} s"
    echo "signature: ${SIGNATURE}"
    section "failure lines"
    printf '%s\n' "${FAILURES:-(none matched; the script exited ${rc})}"
    section port
    echo "script: ${script#"${ROOT}"}"
    echo "folder: ${dir:+${dir#"${ROOT}"}}"
    if [ -f "${json}" ]; then
      jq -r '"package: \(.name) (port.json version \(.version))",
        "porter: \((.attr.porter // []) | join(", "))",
        "arch: \((.attr.arch // []) | join(", "))",
        "runtime: \((.attr.runtime // []) | if type == "array" then join(", ") else . end | if . == "" then "none" else . end)",
        "source: \(.status.source // "?") \(.status.md5 // "")"' "${json}" 2>&1
    fi
    sed -n 's#.*<name>\(.*\)</name>.*#gameinfo name: \1#p' "${dir}/gameinfo.xml" 2>/dev/null | head -n 1
    echo "portmaster: $(cat "${pm}/version" 2>/dev/null || echo missing)"
    [ -f "${pm}/control.txt" ] || echo "control.txt: MISSING"
    # The device as PortMaster sees it: from the run's output, else its file.
    f=$(grep -aE '^(CFW_NAME|CFW_VERSION|DEVICE_NAME|DISPLAY_WIDTH|DISPLAY_HEIGHT|ANALOG_STICKS)=' <<<"${OUTPUT}")
    [ -n "${f}" ] || f=$(cd "${pm}" 2>/dev/null && bash -c '. ./device_info.txt >/dev/null 2>&1
      for v in CFW_NAME CFW_VERSION DEVICE_NAME DISPLAY_WIDTH DISPLAY_HEIGHT ANALOG_STICKS; do echo "$v=${!v}"; done')
    printf '%s\n' "${f}" | sort -u
    if [ -f "${json}" ]; then
      while IFS= read -r runtime; do
        [ -n "${runtime}" ] || continue
        if [ -e "${pm}/libs/${runtime}" ] || [ -e "${pm}/libs/${runtime}.squashfs" ]; then
          echo "runtime ${runtime}: present"
        else
          echo "runtime ${runtime}: MISSING from PortMaster/libs"
        fi
      done < <(jq -r '.attr.runtime // [] | if type == "array" then .[] else . end' "${json}" 2>/dev/null)
    fi
    if grep -q 'GPTOKEYB' "${script}" 2>/dev/null; then
      echo "gptokeyb: used by the script$(ls "${dir}"/*.gptk >/dev/null 2>&1 && echo ", .gptk present" || echo ", no .gptk in the folder")$(pgrep -x gptokeyb >/dev/null 2>&1 && echo "; still running" || echo "; not running now")"
    fi
    echo "gpu: $(timeout 5 gpudriver 2>/dev/null | head -n 1)"
    section "missing libraries (ldd, the port's libs first)"
    if [ -d "${dir}" ]; then
      while IFS= read -r -d '' f; do
        [ "$(head -c 4 "${f}" 2>/dev/null | od -An -c | tr -d ' ')" = '177ELF' ] || continue
        elf=$((elf + 1))
        [ "${elf}" -le 20 ] || break
        LD_LIBRARY_PATH="${dir}/libs:${dir}/lib:${dir}/libs.${DEVICE_ARCH:-aarch64}:/usr/lib/compat" \
          run ldd "${f}" | grep 'not found' | sed "s#^#${f#"${dir}/"}: #"
      done < <(find "${dir}" -maxdepth 3 -type f -size +1k -print0 2>/dev/null)
    fi
    section "script (first 80 lines)"
    head -n 80 "${script}" 2>/dev/null
    common
    section "run output (exec.log, last 300 lines)"
    printf '%s\n' "${OUTPUT}"
    # The port's own logs written during this run.
    while IFS= read -r f; do
      [ -n "${f}" ] || continue
      section "port log ${f#"${dir}/"} (last 80 lines)"
      # Most scripts tee their log: it is the run output above.
      if teed "${f}" "${script}"; then
        echo "(the script tees it: same as the run output)"
      else
        tail -n 80 "${f}"
      fi
    done <<<"${LOGS}"
  }
  SIGNATURE=$(head -n 1 <<<"${failures}" | normalize | sign port "${name}")
  queue "${SIGNATURE}" build "$@"
}

sign() { { printf '%s\n' "$@"; cat; } | sha1sum | cut -c1-8; }

# Size, space taken and first bytes of a game file. A copy the card left
# before it was written out keeps its size with nothing in it: fewer
# blocks than bytes, and zeros where the header should be.
game_file() {
  local f="${ROOT}$1"
  if [ ! -f "${f}" ]; then
    echo "${1##*/}: not found"
    return
  fi
  echo "${1##*/}: $(stat -c '%s bytes, %b blocks of %B allocated' "${f}"), starts$(head -c 16 "${f}" | od -An -tx1 | tr -s ' ' | sed 's/ *$//')"
}

# The game file, and the files a .cue or .m3u names (one level down
# again, for an .m3u of .cue files).
game_files() {
  local rom=$1 depth=${2:-0} dir name
  game_file "${rom}"
  [ "${depth}" -lt 2 ] || return 0
  dir=${rom%/*}
  case "${rom,,}" in
  *.cue) sed -n 's/^[[:space:]]*FILE[[:space:]]*"\{0,1\}\([^"]*\)"\{0,1\}[[:space:]]\{1,\}[A-Z0-9]*[[:space:]]*$/\1/p' "${ROOT}${rom}" 2>/dev/null ;;
  *.m3u) grep -v '^[[:space:]]*#' "${ROOT}${rom}" 2>/dev/null | tr -d '\r' | grep . ;;
  *) return 0 ;;
  esac | head -n 8 | while IFS= read -r name; do
    [ "${name#/}" = "${name}" ] && name="${dir}/${name}"
    game_files "${name}" $((depth + 1))
  done
}

# --- events ---

game() {
  local rc=$1 seconds=$2 offset=$3 system=$4 emulator=$5 core=$6 what full rom
  shift 6
  [ "$1" = -- ] && shift
  external "${rc}" && return 0
  rom=$1
  what=${core:-${emulator:-${system}}}
  [ "${emulator}" = retroarch ] && what="retroarch/${core}"
  full=$(grep -A2 "<name>${system}</name>" "${ROOT}/usr/share/archr/systems.cfg" 2>/dev/null |
    sed -n 's/.*<fullname>\(.*\)<\/fullname>.*/\1/p' | head -n 1)
  OUTPUT=$(tail -c +"$((offset + 1))" "${EXEC_LOG}" 2>/dev/null | tail -n 300)
  # A start script that finds no program of the user's own on the card
  # (PICO-8's pico8_64, bought and copied to roms/pico-8): the user's to
  # add, not a failure.
  [ "${rc}" = 127 ] &&
    grep -aqE '^/usr/bin/start_[^:]*: line [0-9]+: /storage/[^:]*: No such file or directory' <<<"${OUTPUT}" &&
    return 0
  build() {
    echo "event: game"
    echo "what: ${what}"
    echo "system: ${system}${full:+ (${full})}"
    echo "game: ${rom##*/}"
    echo "exit: $(describe "${rc}") after ${seconds} s"
    echo "signature: ${SIGNATURE}"
    section command
    # Each argument in single quotes: copied as is, and "-Pgb" is not
    # taken for a password option by the filter.
    printf 'runemu.sh'
    printf " '%s'" "${@//\'/\'\\\'\'}"
    echo
    section "packages involved"
    if [ "${emulator}" = retroarch ]; then
      run pacman -Qo /usr/bin/retroarch "/usr/lib/libretro/${core}_libretro.so"
    else
      run pacman -Qo "/usr/bin/start_${core%-*}.sh"
    fi
    section "game file"
    game_files "${rom}"
    common
    section "run output (exec.log, last 300 lines)"
    printf '%s\n' "${OUTPUT}"
    section "journal since the start (warnings)"
    run journalctl --no-pager -q -o short-monotonic -p warning --since "@$(($(date +%s) - seconds - 5))" | tail -n 80
    section "core dump"
    if command -v coredumpctl >/dev/null 2>&1; then
      run coredumpctl info --no-pager --since "@$(($(date +%s) - seconds - 5))" -1
    else
      echo "none: core_pattern is $(cat "${ROOT}/proc/sys/kernel/core_pattern" 2>/dev/null); the kernel log has the faulting address"
    fi
    if [ "${emulator}" = retroarch ]; then
      section "retroarch config lent to the game (/tmp/.retroarch.cfg)"
      head -n 150 "${ROOT}/tmp/.retroarch.cfg" 2>/dev/null
      section "retroarch.cfg (drivers)"
      grep -E '^(video_(driver|context_driver|threaded|vsync|smooth|shader_enable|scale_integer|frame_delay|max_swapchain_images|hard_sync)|audio_(driver|latency)|input_(joypad_)?driver|menu_driver|savestate_auto_(load|save)|run_ahead_enabled) ' \
        "${ROOT}/storage/.config/retroarch/retroarch.cfg" 2>/dev/null
    fi
  }
  SIGNATURE=$(errors <<<"${OUTPUT}" | sign game "${what}" "${system}" "${rom##*/}" "${rc}")
  queue "${SIGNATURE}" build "$@"
}

unit() {
  local name=$1 show
  case "${name}" in
    archr-error-report* | archr-mod-*) return 0 ;; # itself; modules: the launcher reports
  esac
  show=$(run systemctl show -p Result,ExecMainCode,ExecMainStatus,NRestarts,FragmentPath "${name}")
  # Back up by now (a restart whose stop timed out, Restart=): no failure.
  grep -q '^Result=success$' <<<"${show}" && return 0
  JOURNAL=$(run journalctl -u "${name}" -n 200 --no-pager -q -o short-monotonic)
  build() {
    echo "event: unit"
    echo "what: ${name}"
    echo "exit: $(sed -n 's/^Result=//p' <<<"${show}") (status $(sed -n 's/^ExecMainStatus=//p' <<<"${show}"))"
    echo "signature: ${SIGNATURE}"
    section "unit"
    printf '%s\n' "${show}"
    sed -n 's/^FragmentPath=\(..*\)/\1/p' <<<"${show}" | xargs -r pacman -Qo 2>&1
    common
    section "journal of ${name} (last 200 lines)"
    printf '%s\n' "${JOURNAL}"
  }
  SIGNATURE=$(errors <<<"${JOURNAL}" | tail -n 3 | sign unit "${name}" "$(sed -n 's/^Result=//p' <<<"${show}")")
  queue "${SIGNATURE}" build
}

kernel() {
  local f found="" mark kind=oops
  for f in "${ROOT}"/sys/fs/pstore/dmesg-*; do
    [ -f "${f}" ] && found+=" ${f}"
  done
  for f in "${ROOT}"/sys/fs/pstore/console-*; do
    [ -f "${f}" ] && grep -aqE 'Kernel panic|Internal error:|Unable to handle kernel|BUG:' "${f}" && found+=" ${f}"
  done
  [ -n "${found}" ] || return 0
  # Records stay in pstore until cleared: each is reported at one boot only.
  # shellcheck disable=SC2086 # the list of files
  mark=$(cat ${found} | sha1sum | cut -c1-16)
  [ "$(cat "${DIR}/pstore" 2>/dev/null)" = "${mark}" ] && return 0
  mkdir -p "${DIR}" && echo "${mark}" >"${DIR}/pstore"
  # shellcheck disable=SC2086
  grep -aq 'Kernel panic' ${found} && kind=panic
  build() {
    echo "event: kernel"
    echo "what: kernel ${kind} (previous boot)"
    echo "exit: ${kind}"
    echo "signature: ${SIGNATURE}"
    common
    for f in ${found}; do
      section "pstore ${f##*/}"
      tail -c 120000 "${f}" | tr -d '\0'
    done
  }
  # shellcheck disable=SC2086
  SIGNATURE=$(cat ${found} | grep -aE 'Kernel panic|Internal error:|Unable to handle|BUG:|pc :|lr :' |
    sed -E 's/^\[[ 0-9.]*\] *//' | errors 4 | sign kernel "${kind}")
  queue "${SIGNATURE}" build
}

# sway's outputs, as swaymsg prints them; nothing without sway.
outputs() {
  local sock=${SWAYSOCK:-}
  if [ -z "${sock}" ]; then
    for sock in "${XDG_RUNTIME_DIR:-/var/run/0-runtime-dir}"/sway-ipc.*.sock; do
      [ -S "${sock}" ] && break
    done
  fi
  SWAYSOCK=${sock} run swaymsg -t get_outputs
}
# Whether a screen is on within DISPLAY_WAIT seconds.
display_comes() {
  local i=0
  while :; do
    outputs | grep -q '"active": true' && return 0
    [ "${i}" -lt "${DISPLAY_WAIT}" ] || return 1
    sleep 1
    i=$((i + 1))
  done
}

launcher() {
  local rc=$1 NODISPLAY=
  external "${rc}" && return 0
  JOURNAL=$(run journalctl -u archr-launcher-session -n 200 --no-pager -q -o short-monotonic)
  # No screen yet: at boot the panel can come after the session's 10 s
  # wait (seen on R36S consoles), and the launcher fails until it is
  # there. A screen that comes is no failure; one reporter waits for it,
  # the session's next tries leave it to that one.
  if tail -n 5 <<<"${JOURNAL}" | grep -aq 'did not add any displays'; then
    exec 8>"${ROOT}/run/archr-error-report.display" && flock -n 8 || return 0
    display_comes && return 0
    NODISPLAY=1
  fi
  build() {
    local f
    echo "event: launcher"
    echo "what: archr-launcher"
    echo "exit: $(describe "${rc}")"
    echo "signature: ${SIGNATURE}"
    common
    if [ -n "${NODISPLAY:-}" ]; then
      section "display (sway outputs, DRM connectors)"
      outputs | grep -aE '"(name|make|model|active|power|current_mode)"|"width"|"height"'
      for f in "${ROOT}"/sys/class/drm/card*-*/status; do
        [ -f "${f}" ] && echo "${f#"${ROOT}"/sys/class/drm/}: $(cat "${f}")"
      done
    fi
    section "launcher journal (last 200 lines)"
    printf '%s\n' "${JOURNAL}"
    section "session log"
    tail -n 40 "${ROOT}/var/log/archr-launcher-session.log" 2>/dev/null
  }
  SIGNATURE=$( { grep -a 'panicked at' <<<"${JOURNAL}"; errors <<<"${JOURNAL}"; } | head -n 3 | sign launcher "${rc}")
  queue "${SIGNATURE}" build
}

module() {
  local id=$1 rc=$2 version
  external "${rc}" && return 0
  [[ "${id}" =~ ^[A-Za-z0-9._-]+$ ]] || return 1
  version=$(sed -n 's/^version *= *"\(.*\)"/\1/p' "${ROOT}/storage/.config/archr-launcher/modules/${id}/module.toml" 2>/dev/null)
  JOURNAL=$(run journalctl -u archr-launcher-session -n 2000 --no-pager -q -o short-monotonic | grep -aF "Module ${id}" | tail -n 120)
  build() {
    echo "event: module"
    echo "what: ${id}${version:+ ${version}}"
    echo "exit: $(describe "${rc}")"
    echo "signature: ${SIGNATURE}"
    common
    section "module lines of the launcher journal"
    printf '%s\n' "${JOURNAL}"
  }
  SIGNATURE=$(errors <<<"${JOURNAL}" | sign module "${id}" "${version}" "${rc}")
  queue "${SIGNATURE}" build
}

# --- sending ---

send() {
  local f name code sent
  mkdir -p "${QUEUE}" "${SENT}" || return 1
  if ! enabled; then
    # Turned off: what waits is never sent.
    rm -f "${QUEUE}"/*.txt
    return 0
  fi
  # A network event may come before DHCP is done: a short wait, then the
  # next event or report tries again.
  for _ in $(seq "${ROUTE_WAIT}"); do
    [ -n "$(run ip route show default)" ] && break
    sleep 1
  done
  [ -n "$(run ip route show default)" ] || return 0
  exec 9>"${DIR}/.lock"
  timeout 30 flock -x 9 || return 0
  for f in "${QUEUE}"/*.txt; do
    [ -f "${f}" ] || continue
    read -r _ sent <<<"$(counts)"
    [ "${sent}" -lt "${DAILY}" ] || break
    name=${f##*/}
    code=$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 10 --max-time 60 -X PUT \
      -H 'Content-Type: text/plain; charset=utf-8' --data-binary "@${f}" \
      "${URL}/${name%.txt}_$(od -An -N2 -tx1 /dev/urandom | tr -d ' \n').txt" 2>/dev/null)
    case "${code}" in
      201 | 204)
        mv -f "${f}" "${SENT}/${name}" && touch "${SENT}/${name}"
        bump sent
        echo "archr-error-report: sent ${name}" >&2
        ;;
      429)
        echo "archr-error-report: rate limited, ${name} waits" >&2
        break
        ;;
      4??)
        echo "archr-error-report: server refused ${name} (${code}), dropped" >&2
        rm -f "${f}"
        ;;
      *)
        echo "archr-error-report: could not send ${name} (${code:-none}), it waits" >&2
        break
        ;;
    esac
  done
  # The last few stay for the launcher's viewer.
  find "${SENT}" -name '*.txt' | sort | head -n -"${KEEP}" | xargs -r rm -f
}

case "${1:-}" in
  game | port | unit | kernel | launcher | module)
    enabled || exit 0
    event=$1
    shift
    "${event}" "$@"
    ;;
  send) send ;;
  *)
    sed -n '10,25s/^# \{0,3\}//p' "$0" >&2
    exit 2
    ;;
esac
