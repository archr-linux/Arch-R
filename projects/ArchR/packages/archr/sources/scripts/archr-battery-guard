#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2026-present ArchR (https://github.com/archr-linux/Arch-R)
#
# Watches the battery (Configurações › Sistema › Energia):
#   power.battery.low=10       percent: a warning on screen (archr-osd), once
#                              per discharge; 0 turns it off
#   power.battery.critical=3   percent: a countdown on screen, then the game
#                              is saved and closed (archr-game-save-exit
#                              battery) and the device powers off; 0 off
# The percentage is the fuel gauge's counter, which can sit at 0% on a pack
# that is not empty (issue 50), so it never acts alone. The warning needs
# the voltage under the design minimum + SOFT_MARGIN; the countdown needs
# the level at or under the critical one with the voltage under the design
# minimum - LOW_DROP, for CUT_READINGS readings in a row (a half pack sags
# to 3.49 V under load), and still so at every step of the countdown and
# just before the power off. A voltage that recovers cancels.
# And the voltage cuts by itself, whatever the percentage says (an old pack
# must not die unsaved), but only for a pack that is empty under load: the
# design minimum is the empty point at rest, and these packs sag 200-300 mV
# under load (Wi-Fi, CPU) at 30-50%. So the cut is under the design minimum
# - CUT_DROP for CUT_READINGS readings in a row (a minute); a reading at or
# over it starts the count over. Voltages outside 2.7-4.45 V, or unreadable,
# are discarded (2.7-3.0 V is a real, deep discharge): they neither count
# nor start it over, and during a countdown they keep it going, only a
# recovered voltage cancels. A design minimum outside 3.3-3.5 V (or missing)
# is taken as 3.4 V. The card of the cut says 0%: the pack is empty, the
# gauge's percentage is not the reason.
# For both, a reading at or over the threshold (or a level over the critical
# one) starts the count over. A charger cancels the countdown, and so does a
# level that rose during it; with a charger nothing happens at all. The
# kernel says "Not charging" with a charger in and a full battery: anything
# but "Discharging" is a charger.

# shellcheck source=/dev/null
. "${BATTERY_GUARD_PROFILE:-/etc/profile.d/001-functions}"

: "${BATTERY:=/sys/class/power_supply/battery}"
: "${CURRENT_GAME:=/run/archr/current-game}"
: "${SAVE_EXIT:=/usr/bin/archr-game-save-exit}"
: "${POWEROFF:=systemctl poweroff}"
: "${GRIM:=grim}"
: "${OSD:=archr-osd}"
: "${SOFT_MARGIN:=150000}" # microvolts over the design minimum (warning)
: "${LOW_DROP:=50000}" # microvolts under the design minimum (percentage)
: "${CUT_DROP:=150000}" # microvolts under the design minimum
: "${CUT_READINGS:=6}"
: "${INTERVAL:=10}"
: "${COUNTDOWN:=8}"
# Host tests stop after this many readings.
: "${ROUNDS:=0}"

percent() {
  local value
  value=$(get_setting "$1")
  [[ "${value}" =~ ^[0-9]{1,2}$ ]] && echo "${value}" || echo "$2"
}

charging() {
  [ "$(cat "${BATTERY}/status" 2>/dev/null)" != Discharging ]
}

level() {
  cat "${BATTERY}/capacity" 2>/dev/null
}

# The battery voltage in microvolts, nothing when unreadable or implausible.
volts() {
  local volt
  volt=$(cat "${BATTERY}/voltage_avg" 2>/dev/null)
  [[ "${volt}" =~ ^[0-9]+$ ]] && [ "${volt}" -ge 2700000 ] && [ "${volt}" -le 4450000 ] &&
    echo "${volt}"
}

# The design minimum, kept to what a lithium pack can have.
design_min() {
  local min
  min=$(cat "${BATTERY}/voltage_min_design" 2>/dev/null)
  if [[ "${min}" =~ ^[0-9]+$ ]] && [ "${min}" -ge 3300000 ] && [ "${min}" -le 3500000 ]; then
    echo "${min}"
  else
    echo 3400000
  fi
}

# Whether the voltage now is under the design minimum + $1 (a negative $1
# goes under it; false when the voltage is not readable).
volt_under() {
  local volt
  volt=$(volts)
  [ -n "${volt}" ] && [ "${volt}" -lt $(($(design_min) + $1)) ]
}

# Whether the reason that started the countdown ($1: percent or volts) holds:
# a reading that cannot be used keeps it, only a recovered voltage ends it.
still() {
  local margin=$((-CUT_DROP))
  [ "$1" = percent ] && margin=$((-LOW_DROP))
  [ -z "$(volts)" ] || volt_under "${margin}"
}

# For the percentage, whether the level is still at or under the critical
# one; an unreadable level keeps it.
level_still() {
  local now
  now=$(level)
  [ "$1" != percent ] || ! [[ "${now}" =~ ^[0-9]+$ ]] || [ "${now}" -le "${CRITICAL}" ]
}

game_running() {
  local rom="" pid=""
  [ -r "${CURRENT_GAME}" ] && { IFS= read -r rom; IFS= read -r pid; } <"${CURRENT_GAME}"
  [ -n "${rom}" ] && [[ "${pid}" =~ ^[0-9]+$ ]] && kill -0 "${pid}" 2>/dev/null
}

# The countdown on screen, a message a second; 0 when it ran out, 1 when a
# charger came, the voltage recovered, or (for the percentage) the level rose
# above the one it started at.
countdown() {
  local level="$1" game="$2" mode="$3" left now
  rose() {
    now=$(level)
    [ "${mode}" = percent ] && [[ "${now}" =~ ^[0-9]+$ ]] && [ "${now}" -gt "${level}" ]
  }
  for ((left = COUNTDOWN; left > 0; left--)); do
    charging && return 1
    still "${mode}" || return 1
    rose && return 1
    ${OSD} send battery "${level}" "${left}" "${COUNTDOWN}" "${game}" 2>/dev/null
    sleep 1
  done
  ! charging && still "${mode}" && ! rose
}

# The countdown, the save and the power off; 0 when it powered off. $3 is
# the reason, for the log.
power_off() {
  local level="$1" mode="$2" why="$3" game=menu shot=""
  if game_running; then
    game=game
    # The game as it is, before the card covers it.
    shot=$(mktemp "${TMPDIR:-/tmp}/battery-shot.XXXXXX") &&
      XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/var/run/0-runtime-dir}" WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"         "${GRIM}" -t png "${shot}" 2>/dev/null
  fi
  if countdown "${level}" "${game}" "${mode}"; then
    echo "archr-battery-guard: ${why} (now $(volts) uV), powering off"
    [ "${game}" = game ] && PICTURE_FROM="${shot}" "${SAVE_EXIT}" battery
    rm -f "${shot}"
    # The save took time: a charger, a recovered voltage or (for the
    # percentage) a level back over the critical one still cancels.
    if ! charging && still "${mode}" && level_still "${mode}"; then
      ${POWEROFF}
      return 0
    fi
    return 1
  fi
  rm -f "${shot}"
  return 1
}

WARNED=0
BELOW=0
CUT=0
READS=""
LOWREADS=""
ROUND=0
while :; do
  LEVEL=$(level)
  if ! charging && { [[ "${LEVEL}" =~ ^[0-9]+$ ]] || [ -n "$(volts)" ]; }; then
    LOW=$(percent power.battery.low 10)
    CRITICAL=$(percent power.battery.critical 3)
    # The warning counts only with the voltage low too.
    LEVELOK=0
    [[ "${LEVEL}" =~ ^[0-9]+$ ]] && volt_under "${SOFT_MARGIN}" && LEVELOK=1
    # At the critical level the countdown says it all (and the game's
    # picture, taken before it, must not hold this warning).
    if [ "${LEVELOK}" = 1 ] && [ "${LOW}" -gt 0 ] && [ "${LEVEL}" -le "${LOW}" ] && [ "${WARNED}" = 0 ] &&
       { [ "${CRITICAL}" -eq 0 ] || [ "${LEVEL}" -gt "${CRITICAL}" ]; }; then
      ${OSD} send battery-low "${LEVEL}" 2>/dev/null
      WARNED=1
    fi
    # A discarded voltage leaves both counts as they are.
    VOLT=$(volts)
    LOWOFF=$(($(design_min) - LOW_DROP))
    CUTOFF=$(($(design_min) - CUT_DROP))
    # The critical level, with the voltage low for as long as the cut's.
    if [ "${CRITICAL}" -eq 0 ] || ! [[ "${LEVEL}" =~ ^[0-9]+$ ]] || [ "${LEVEL}" -gt "${CRITICAL}" ]; then
      BELOW=0 LOWREADS=""
    elif [ -n "${VOLT}" ] && [ "${VOLT}" -lt "${LOWOFF}" ]; then
      # The first reading under the limit: a later rise above it cancels.
      [ "${BELOW}" -eq 0 ] && FIRST=${LEVEL}
      BELOW=$((BELOW + 1)) LOWREADS="${LOWREADS:+${LOWREADS} }${VOLT}"
    elif [ -n "${VOLT}" ]; then
      BELOW=0 LOWREADS=""
    fi
    # The voltage alone, with the percentage on, as the critical setting
    # says.
    if [ "${CRITICAL}" -eq 0 ]; then
      CUT=0 READS=""
    elif [ -n "${VOLT}" ] && [ "${VOLT}" -lt "${CUTOFF}" ]; then
      CUT=$((CUT + 1)) READS="${READS:+${READS} }${VOLT}"
    elif [ -n "${VOLT}" ]; then
      CUT=0 READS=""
    fi
    MODE=""
    [ "${BELOW}" -ge "${CUT_READINGS}" ] && MODE=percent
    [ "${CUT}" -ge "${CUT_READINGS}" ] && MODE=volts
    if [ -n "${MODE}" ]; then
      if [ "${MODE}" = volts ]; then
        WHY="battery voltage under ${CUTOFF} uV for ${CUT} readings (${READS} uV; gauge at ${LEVEL:-?}%)"
        FIRST=0
      else
        WHY="battery at ${FIRST}% and under ${LOWOFF} uV for ${BELOW} readings (${LOWREADS} uV)"
      fi
      power_off "${FIRST}" "${MODE}" "${WHY}" && exit 0
      BELOW=0 LOWREADS=""
      CUT=0 READS=""
    fi
  else
    # A charger (or no reading): the next discharge warns again.
    WARNED=0
    BELOW=0 LOWREADS=""
    CUT=0 READS=""
  fi
  ROUND=$((ROUND + 1))
  [ "${ROUNDS}" -gt 0 ] && [ "${ROUND}" -ge "${ROUNDS}" ] && exit 0
  sleep "${INTERVAL}"
done
