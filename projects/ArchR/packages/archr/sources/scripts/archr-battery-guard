#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2026-present ArchR (https://github.com/archr-linux/Arch-R)
#
# Watches the battery (Configurações › Sistema › Energia):
#   power.battery.low=10       percent: a warning on screen (archr-osd), once
#                              per discharge; 0 turns it off
#   power.battery.critical=3   percent: a countdown on screen, then the game
#                              is saved and closed (archr-game-save-exit
#                              battery) and the device powers off; 0 off
# The design minimum is the pack's empty point at rest (3.574 V OCV at 0%
# on these packs, read as 3.5 V; outside 3.3-3.5 V or missing, 3.4 V), and
# a pack at 30-50% sags under it under load (Wi-Fi, CPU). So the guard
# counts readings, one every INTERVAL, and powers off on CUT_READINGS low
# ones in a row (6: about a minute) on either path:
#   voltage alone   under the design minimum - CUT_DROP, whatever the
#                   percentage says (an old pack must not die unsaved);
#                   the card says 0%, the pack is empty
#   percentage      the level at or under the critical one and the voltage
#                   under the design minimum - LOW_DROP; the gauge can sit
#                   at 0% on a pack that is not empty (issue 50), so it
#                   never acts alone. A pack at 0% rests over it: the guard
#                   acts under load, or once the voltage at rest falls
#                   under it
# A voltage outside 2.7-4.45 V, or unreadable, skips the reading: nothing
# counts, resets or is decided on it (2.7-3.0 V is a real, deep discharge).
# A valid voltage at or over a path's threshold resets that path; a level
# over the critical one resets the percentage, an unreadable one leaves it.
# The countdown and the check after the save follow the same rules: a
# charger, a recovered voltage or (percentage) a level over the critical one
# cancel; a skipped reading waits, up to COUNTDOWN seconds, then cancels.
# The warning needs the voltage under the design minimum + SOFT_MARGIN.
# The kernel says "Not charging" with a charger in and a full battery:
# anything but "Discharging" is a charger, and with a charger nothing
# happens at all.

# shellcheck source=/dev/null
. "${BATTERY_GUARD_PROFILE:-/etc/profile.d/001-functions}"

: "${BATTERY:=/sys/class/power_supply/battery}"
: "${CURRENT_GAME:=/run/archr/current-game}"
: "${SAVE_EXIT:=/usr/bin/archr-game-save-exit}"
: "${POWEROFF:=systemctl poweroff}"
: "${GRIM:=grim}"
: "${OSD:=archr-osd}"
: "${SOFT_MARGIN:=150000}" # microvolts over the design minimum (warning)
: "${LOW_DROP:=100000}" # microvolts under the design minimum (percentage)
: "${CUT_DROP:=150000}" # microvolts under the design minimum (voltage)
: "${CUT_READINGS:=6}"
: "${INTERVAL:=10}"
: "${COUNTDOWN:=8}"
# Host tests replace the wait between readings, and stop after ROUNDS.
: "${SLEEP:=sleep}"
: "${ROUNDS:=0}"

percent() {
  local value
  value=$(get_setting "$1")
  [[ "${value}" =~ ^[0-9]{1,2}$ ]] && echo "${value}" || echo "$2"
}

charging() {
  [ "$(cat "${BATTERY}/status" 2>/dev/null)" != Discharging ]
}

level() {
  cat "${BATTERY}/capacity" 2>/dev/null
}

# The battery voltage in microvolts, nothing when unreadable or implausible.
volts() {
  local volt
  volt=$(cat "${BATTERY}/voltage_avg" 2>/dev/null)
  [[ "${volt}" =~ ^[0-9]+$ ]] && [ "${volt}" -ge 2700000 ] && [ "${volt}" -le 4450000 ] &&
    echo "${volt}"
}

# The design minimum, kept to what a lithium pack can have.
design_min() {
  local min
  min=$(cat "${BATTERY}/voltage_min_design" 2>/dev/null)
  if [[ "${min}" =~ ^[0-9]+$ ]] && [ "${min}" -ge 3300000 ] && [ "${min}" -le 3500000 ]; then
    echo "${min}"
  else
    echo 3400000
  fi
}

# A path's threshold ($1: percent or volts), in microvolts.
threshold() {
  if [ "$1" = percent ]; then
    echo $(($(design_min) - LOW_DROP))
  else
    echo $(($(design_min) - CUT_DROP))
  fi
}

# Whether the reason for the power off ($1) holds now: 0 yes, 1 no (a
# charger, a recovered voltage, a level over the critical one), 2 a skipped
# reading.
verdict() {
  local volt now
  charging && return 1
  volt=$(volts)
  [ -n "${volt}" ] || return 2
  [ "${volt}" -lt "$(threshold "$1")" ] || return 1
  now=$(level)
  [ "$1" = percent ] && [[ "${now}" =~ ^[0-9]+$ ]] && [ "${now}" -gt "${CRITICAL}" ] && return 1
  return 0
}

# A verdict on a valid reading, waiting out skipped ones (up to COUNTDOWN
# seconds, then no).
confirm() {
  local tries rc
  for ((tries = 0; tries <= COUNTDOWN; tries++)); do
    verdict "$1"
    rc=$?
    [ "${rc}" -ne 2 ] && return "${rc}"
    [ "${tries}" -lt "${COUNTDOWN}" ] && sleep 1
  done
  return 1
}

game_running() {
  local rom="" pid=""
  [ -r "${CURRENT_GAME}" ] && { IFS= read -r rom; IFS= read -r pid; } <"${CURRENT_GAME}"
  [ -n "${rom}" ] && [[ "${pid}" =~ ^[0-9]+$ ]] && kill -0 "${pid}" 2>/dev/null
}

# The countdown on screen, a message a second (a skipped reading waits
# without a step); 0 when it ran out and the reason still holds.
countdown() {
  local level="$1" game="$2" mode="$3" left=${COUNTDOWN} blind=0 rc
  while [ "${left}" -gt 0 ]; do
    verdict "${mode}"
    rc=$?
    [ "${rc}" = 1 ] && return 1
    if [ "${rc}" = 2 ]; then
      blind=$((blind + 1))
      [ "${blind}" -gt "${COUNTDOWN}" ] && return 1
    else
      blind=0
      ${OSD} send battery "${level}" "${left}" "${COUNTDOWN}" "${game}" 2>/dev/null
      left=$((left - 1))
    fi
    sleep 1
  done
  confirm "${mode}"
}

# The countdown, the save and the power off; 0 when it powered off. $3 is
# the reason, for the log.
power_off() {
  local level="$1" mode="$2" why="$3" game=menu shot=""
  if game_running; then
    game=game
    # The game as it is, before the card covers it.
    shot=$(mktemp "${TMPDIR:-/tmp}/battery-shot.XXXXXX") &&
      XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/var/run/0-runtime-dir}" WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}" \
        "${GRIM}" -t png "${shot}" 2>/dev/null
  fi
  if countdown "${level}" "${game}" "${mode}"; then
    echo "archr-battery-guard: ${why} (now $(volts) uV), powering off"
    [ "${game}" = game ] && PICTURE_FROM="${shot}" "${SAVE_EXIT}" battery
    rm -f "${shot}"
    # The save took time: the same checks again.
    if confirm "${mode}"; then
      ${POWEROFF}
      return 0
    fi
    return 1
  fi
  rm -f "${shot}"
  return 1
}

WARNED=0
BELOW=0 LOWREADS=""
CUT=0 READS=""
ROUND=0
while :; do
  LEVEL=$(level)
  if charging; then
    # The next discharge warns again.
    WARNED=0
    BELOW=0 LOWREADS=""
    CUT=0 READS=""
  else
    LOW=$(percent power.battery.low 10)
    CRITICAL=$(percent power.battery.critical 3)
    VOLT=$(volts)
    # The warning, with the voltage low too; at the critical level the
    # countdown says it all (and the game's picture, taken before it, must
    # not hold this warning).
    if [ -n "${VOLT}" ] && [ "${VOLT}" -lt $(($(design_min) + SOFT_MARGIN)) ] &&
       [[ "${LEVEL}" =~ ^[0-9]+$ ]] && [ "${LOW}" -gt 0 ] && [ "${LEVEL}" -le "${LOW}" ] &&
       [ "${WARNED}" = 0 ] && { [ "${CRITICAL}" -eq 0 ] || [ "${LEVEL}" -gt "${CRITICAL}" ]; }; then
      ${OSD} send battery-low "${LEVEL}" 2>/dev/null
      WARNED=1
    fi
    MODE=""
    if [ "${CRITICAL}" -eq 0 ]; then
      BELOW=0 LOWREADS=""
      CUT=0 READS=""
    elif [ -n "${VOLT}" ]; then
      # The voltage alone.
      CUTOFF=$(threshold volts)
      if [ "${VOLT}" -lt "${CUTOFF}" ]; then
        CUT=$((CUT + 1)) READS="${READS:+${READS} }${VOLT}"
        [ "${CUT}" -ge "${CUT_READINGS}" ] && MODE=volts
      else
        CUT=0 READS=""
      fi
      # The percentage.
      LOWOFF=$(threshold percent)
      if [ "${VOLT}" -ge "${LOWOFF}" ]; then
        BELOW=0 LOWREADS=""
      elif ! [[ "${LEVEL}" =~ ^[0-9]+$ ]]; then
        : # an unreadable level: the count stays as it is
      elif [ "${LEVEL}" -gt "${CRITICAL}" ]; then
        BELOW=0 LOWREADS=""
      else
        [ "${BELOW}" -eq 0 ] && FIRST=${LEVEL}
        BELOW=$((BELOW + 1)) LOWREADS="${LOWREADS:+${LOWREADS} }${VOLT}"
        [ "${BELOW}" -ge "${CUT_READINGS}" ] && [ -z "${MODE}" ] && MODE=percent
      fi
    fi
    if [ -n "${MODE}" ]; then
      if [ "${MODE}" = volts ]; then
        WHY="battery voltage under ${CUTOFF} uV for ${CUT} readings (${READS} uV; gauge at ${LEVEL:-?}%)"
        FIRST=0
      else
        WHY="battery at ${FIRST}% and under ${LOWOFF} uV for ${BELOW} readings (${LOWREADS} uV)"
      fi
      power_off "${FIRST}" "${MODE}" "${WHY}" && exit 0
      BELOW=0 LOWREADS=""
      CUT=0 READS=""
    fi
  fi
  ROUND=$((ROUND + 1))
  [ "${ROUNDS}" -gt 0 ] && [ "${ROUND}" -ge "${ROUNDS}" ] && exit 0
  ${SLEEP} "${INTERVAL}"
done
