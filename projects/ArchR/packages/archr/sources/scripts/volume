# The volume belongs to archr-levels (decibel curve, saved once it settles).
#   volume [get] | up | down | <0-100> | restore     prints the level

case ${1} in
  ""|get)    exec archr-levels volume ;;
  "+"|"up")   exec archr-levels volume +2 ;;
  "-"|"down") exec archr-levels volume -2 ;;
  *)         exec archr-levels volume "${1}" ;;
esac
