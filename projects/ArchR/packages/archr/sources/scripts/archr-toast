#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2026 ArchR (https://github.com/archr-linux/Arch-R)
#
# archr-toast KIND CATEGORY TITLE [DETAIL]
#   KIND done|info|error, CATEGORY updates|network|storage|errors.
#
# A toast in the launcher: a file in its spool, /run/archr/notify (the
# contract is archr-launcher's docs/avisos.md). Written under another name
# and renamed, so the launcher never reads half of it; it shows when the
# launcher is on screen again, as written (translate before). One line
# each: line breaks in TITLE and DETAIL become spaces.
# ARCHR_TOAST_DIR replaces the spool (tests).

dir=${ARCHR_TOAST_DIR:-/run/archr/notify}
case "$1" in done | info | error) ;; *) exit 2 ;; esac
case "$2" in updates | network | storage | errors) ;; *) exit 2 ;; esac
[ -n "$3" ] || exit 2
title=${3//$'\n'/ }
detail=${4//$'\n'/ }
mkdir -p "${dir}" || exit 1
f="${dir}/archr-${2}-$$"
{
  printf '%s\n%s\n%s\n' "$1" "$2" "${title:0:300}"
  [ -n "${detail}" ] && printf '%s\n' "${detail:0:600}"
} >"${f}.tmp" && mv -f "${f}.tmp" "${f}.toast"
