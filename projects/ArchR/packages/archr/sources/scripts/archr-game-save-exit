#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2026-present ArchR (https://github.com/archr-linux/Arch-R)
#
# "Save and exit", called from outside the emulator: by the switcher
# shortcut (input_sense), the critical battery guard and the power off that
# follows a long suspend.
#
#   archr-game-save-exit switch|battery|suspend|shutdown
#       Saves the running game's state where its emulator can do it from
#       outside, closes the emulator the clean way and records the result.
#       Exit 0 once the game has closed (with or without a state), 1 when no
#       game runs, 2 for a wrong argument.
#   archr-game-save-exit --forget ROM
#       runemu.sh, as a game starts: its old record goes (the state no longer
#       holds the latest progress), and so does the "last game" mark.
#
# How each emulator saves:
#   retroarch    SIGTERM is RetroArch's "quit": it writes the automatic state
#                (savestate_auto_save, on for every run while runemu.sh
#                exports ARCHR_SAVE_ON_EXIT=1) and the cartridge save.
#   mupen64plus  F5 (Kbd Mapping Save State) on a short-lived uinput keyboard,
#                then SIGTERM (SDL turns it into a clean stop).
#   ppsspp       F2 (start_ppsspp.sh maps it to Save State), then SIGTERM.
#   flycast      SIGTERM: Dreamcast.AutoSaveState (start_flycast.sh) writes
#                the state as the game unloads.
#   the others   SIGTERM only: the cartridge save is written, no state.
# A state counts only when its file changed during this run. Whatever does
# not close in time is killed, as the exit shortcut always did.
#
# Records, newest first, at most 20 (one per ROM), tab separated:
#   time reason platform emulator core state picture rom
# in ${RESUME_DIR}/resume.tsv; the line of the game closed last is also
# ${RESUME_DIR}/resume-last, which the launcher reads at power on. The
# picture is the screen just before saving. "switch" leaves ${SWITCHER} for
# the launcher to open its switcher; ${SAVING} holds this script's PID while
# it works, so the launcher waits for the record.

: "${CURRENT_GAME:=/run/archr/current-game}"
: "${RESUME_DIR:=/storage/.config/archr}"
: "${SWITCHER:=/run/archr/switcher}"
: "${SAVING:=/run/archr/saving}"
: "${STATES_DIR:=/storage/roms/savestates}"
: "${MUPEN_STATES:=/storage/roms/n64}"
: "${PPSSPP_STATES:=/storage/roms/savestates/psp/ppsspp-sa}"
: "${FLYCAST_STATES:=/storage/.local/share/flycast /storage/.config/flycast}"
: "${KEYPRESS:=/usr/bin/archr-keypress}"
: "${GRIM:=grim}"
: "${KILL_DATA:=/tmp/.process-kill-data}"
# Tenths of a second: for the state file after the key, and for the game to
# close after the signal.
: "${STATE_WAIT:=50}"
: "${CLOSE_WAIT:=150}"
: "${TICK:=0.1}"
KEEP=20

TSV="${RESUME_DIR}/resume.tsv"
LAST="${RESUME_DIR}/resume-last"

# Removes ROM's line from the records (and the last mark when it is ROM's).
forget() {
  local rom="$1" tmp
  if [ -f "${TSV}" ]; then
    tmp="${TSV}.$$"
    awk -F'\t' -v rom="${rom}" '$8 != rom' "${TSV}" >"${tmp}" && mv -f "${tmp}" "${TSV}"
  fi
  if [ -f "${LAST}" ] && [ "$(cut -f8 "${LAST}")" = "${rom}" ]; then
    rm -f "${LAST}"
  fi
}

# Writes LINE first in the records and as the last mark, atomically.
record() {
  local line="$1" rom="$2" tmp
  mkdir -p "${RESUME_DIR}" || return 1
  tmp="${TSV}.$$"
  {
    printf '%s\n' "${line}"
    [ -f "${TSV}" ] && awk -F'\t' -v rom="${rom}" '$8 != rom' "${TSV}"
  } | head -n "${KEEP}" >"${tmp}" && mv -f "${tmp}" "${TSV}" || return 1
  printf '%s\n' "${line}" >"${LAST}.$$" && mv -f "${LAST}.$$" "${LAST}"
}

# The newest file under the folders (one level) matching the pattern that
# changed after the marker, if any.
fresh() {
  local marker="$1" pattern="$2" dir
  shift 2
  for dir in "$@"; do
    [ -d "${dir}" ] && find "${dir}" -maxdepth 2 -type f -name "${pattern}" -newer "${marker}" \
      -printf '%T@ %p\n' 2>/dev/null
  done | sort -rn | head -n1 | cut -d' ' -f2-
}

# Waits up to STATE_WAIT tenths for a fresh state file.
wait_state() {
  local n=0 found
  while [ "${n}" -lt "${STATE_WAIT}" ]; do
    found=$(fresh "$@")
    [ -n "${found}" ] && sleep 0.5 && return 0
    sleep "${TICK}"
    n=$((n + 1))
  done
  return 1
}

alive() {
  kill -0 "$1" 2>/dev/null
}

case "$1" in
  --forget)
    [ -n "$2" ] || exit 2
    forget "$2"
    exit 0
    ;;
  switch|battery|suspend|shutdown) REASON="$1" ;;
  *)
    echo "usage: archr-game-save-exit switch|battery|suspend|shutdown | --forget ROM" >&2
    exit 2
    ;;
esac

ROM="" PID="" PLATFORM="" EMULATOR="" CORE=""
if [ -r "${CURRENT_GAME}" ]; then
  { IFS= read -r ROM; IFS= read -r PID; IFS= read -r PLATFORM; IFS= read -r EMULATOR; IFS= read -r CORE; } <"${CURRENT_GAME}"
fi
if [ -z "${ROM}" ] || [[ ! "${PID}" =~ ^[0-9]+$ ]] || ! alive "${PID}"; then
  echo "archr-game-save-exit: no game is running" >&2
  exit 1
fi

# One run at a time: a second press while the first saves does nothing.
mkdir -p "${SAVING%/*}"
exec 9>"${SAVING}.lock"
flock -n 9 || exit 0
printf '%s\n' "$$" >"${SAVING}"
trap 'rm -f "${SAVING}"' EXIT
[ "${REASON}" = switch ] && : >"${SWITCHER}"

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/var/run/0-runtime-dir}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"

STEM="${ROM##*/}"
STEM="${STEM%.*}"
MARK=$(mktemp "${TMPDIR:-/tmp}/save-exit.XXXXXX") || exit 1
trap 'rm -f "${SAVING}" "${MARK}"' EXIT

# The screen as the player left it, for the switcher and the power on.
PICTURE="${RESUME_DIR}/pictures/${PLATFORM}/${STEM//[:?*\"<>|\\]/_}.png"
mkdir -p "${PICTURE%/*}" && "${GRIM}" "${PICTURE}.$$" 2>/dev/null &&
  mv -f "${PICTURE}.$$" "${PICTURE}" || { rm -f "${PICTURE}.$$"; PICTURE=""; }

# The processes to close: the names the exit shortcut kills (set_kill),
# without its -9.
TARGETS=""
[ -r "${KILL_DATA}" ] && TARGETS=$(tr -s ' ' '\n' <"${KILL_DATA}" | grep -v '^-' | tr '\n' ' ')
[ -n "${TARGETS// /}" ] || TARGETS="${EMULATOR}"
signal() {
  local name
  for name in ${TARGETS}; do
    pkill "-$1" -x "${name}" 2>/dev/null
  done
}

STATE=""
case "${EMULATOR}" in
  retroarch)
    CANDIDATE="${STATES_DIR}/${PLATFORM}/${STEM}.state.auto"
    ;;
  mupen64plus)
    "${KEYPRESS}" F5 && wait_state "${MARK}" '*.st[0-9]' "${MUPEN_STATES}"
    ;;
  ppsspp)
    "${KEYPRESS}" F2 && wait_state "${MARK}" '*.ppst' "${PPSSPP_STATES}"
    ;;
esac

signal TERM
n=0
while alive "${PID}" && [ "${n}" -lt "${CLOSE_WAIT}" ]; do
  sleep "${TICK}"
  n=$((n + 1))
done
if alive "${PID}"; then
  echo "archr-game-save-exit: ${TARGETS} did not close, killing it" >&2
  signal KILL
fi

# shellcheck disable=SC2086 # FLYCAST_STATES is a list of folders
case "${EMULATOR}" in
  retroarch) [ "${CANDIDATE}" -nt "${MARK}" ] && STATE="${CANDIDATE}" ;;
  mupen64plus) STATE=$(fresh "${MARK}" '*.st[0-9]' "${MUPEN_STATES}") ;;
  ppsspp) STATE=$(fresh "${MARK}" '*.ppst' "${PPSSPP_STATES}") ;;
  flycast) STATE=$(fresh "${MARK}" "${STEM}*.state" ${FLYCAST_STATES}) ;;
esac
sync

LINE=$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' "$(date +%s)" "${REASON}" "${PLATFORM}" \
  "${EMULATOR}" "${CORE}" "${STATE}" "${PICTURE}" "${ROM}")
record "${LINE}" "${ROM}" || echo "archr-game-save-exit: cannot write ${TSV}" >&2
echo "archr-game-save-exit: ${REASON} ${EMULATOR} state=${STATE:-none}"
exit 0
