#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2026 ArchR (https://github.com/archr-linux/Arch-R)
#
# archr-update: wrapper around pacman to surface the same CLI ArchR
# users were promised before, while the actual update mechanism is
# pacman -Syu against the repo published on GitHub Releases.
#
# Release channel is read from system.cfg "updates.branch" and maps to
# the matching mirror tag on github.com/archr-linux/archr-repo:
#   stable -> repo-stable
#   next   -> repo-next
#   dev    -> repo-dev
#
# The mirrorlist that points to those tags is installed by the pacman
# package (/etc/pacman.d/mirrorlist).

. /etc/profile

BRANCH="$(get_setting updates.branch 2>/dev/null)"
# Anything that is not a real channel falls back to stable: the ES
# settings screen historically stored values like "auto" here, which
# would point the mirrorlist at a repo tag that does not exist.
case "${BRANCH}" in
    stable|next|dev) ;;
    *) BRANCH="stable" ;;
esac

# Channel is reflected by a single line in mirrorlist; rewrite it on
# the fly so the user can switch channels by changing the setting.
write_mirrorlist() {
    cat >/etc/pacman.d/mirrorlist <<EOF
# Generated by archr-update from system.cfg updates.branch=${BRANCH}
Server = https://github.com/archr-linux/archr-repo/releases/download/repo-${BRANCH}
EOF
}

network_ok() {
    ping -c 1 -W 3 8.8.8.8 >/dev/null 2>&1
}

usage() {
    cat <<EOF
Usage: ${0##*/} [check|update|info|seed]

  check     Sync repo metadata and report whether updates are available.
  update    Sync metadata and apply pending updates (pacman -Syu).
  info      Show current OS version, channel, and configured mirror.
  seed      Record this image's packages in an empty pacman database.

Channel is configured via system.cfg "updates.branch" (stable|next|dev).
EOF
}

# A freshly flashed image carries no pacman local db, so pacman has no
# installed list to compare against and every check reports "no
# updates". Seed it once from the db the image build recorded of its own
# packages (/usr/share/archr/pacman-image-db.tar.gz). Never from the
# repo: its seed lists the repo's newest versions, so a device seeded
# after the repo moved looked current and skipped every update since its
# image, migrations included. A db made for another build is refused.
IMAGE_DB=/usr/share/archr/pacman-image-db.tar.gz
PACMAN_DB=/var/lib/pacman
OS_RELEASE=/etc/os-release

seed_local_db() {
    [ -n "$(ls -A "${PACMAN_DB}/local" 2>/dev/null | grep -v '^ALPM_DB_VERSION$')" ] && return 0
    local build stage old="" entry want
    build="$(sed -n 's/^BUILD_ID="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "${OS_RELEASE}")"
    if [ ! -f "${IMAGE_DB}" ] || [ -z "${build}" ]; then
        echo "No package database for this image; cannot seed. Reflash to update." >&2
        return 1
    fi
    # Built next to the live db (same filesystem) and published with a
    # rename, so the live db is either still empty or complete: a failed
    # or interrupted attempt (disk full, power loss) leaves at most a
    # .seed-* or .empty-* directory, which the next attempt removes.
    mkdir -p "${PACMAN_DB}" || return 1
    rm -rf "${PACMAN_DB}"/.seed-* "${PACMAN_DB}"/.empty-*
    stage="$(mktemp -d "${PACMAN_DB}/.seed-XXXXXX")" || return 1
    want="$(tar -tzf "${IMAGE_DB}" 2>/dev/null | sed -n 's#^local/\([^/]*\)/desc$#\1#p')"
    if [ -z "${want}" ] || ! tar -xzf "${IMAGE_DB}" -C "${stage}" ||
       [ "$(cat "${stage}/archr-image-build" 2>/dev/null)" != "${build}" ]; then
        echo "The image package database is unreadable or not for build ${build}; not seeding." >&2
        rm -rf "${stage}"
        return 1
    fi
    for entry in ${want}; do
        if [ ! -s "${stage}/local/${entry}/desc" ] || [ ! -s "${stage}/local/${entry}/files" ]; then
            echo "The image package database is incomplete (${entry}); not seeding." >&2
            rm -rf "${stage}"
            return 1
        fi
    done
    sync
    # Set the empty db aside, then publish. Interrupted in between, there
    # is no db, which counts as empty: the next attempt seeds again.
    if [ -e "${PACMAN_DB}/local" ]; then
        old="${PACMAN_DB}/.empty-$$"
        mv "${PACMAN_DB}/local" "${old}" || { rm -rf "${stage}"; return 1; }
    fi
    if ! mv "${stage}/local" "${PACMAN_DB}/local"; then
        [ -n "${old}" ] && mv "${old}" "${PACMAN_DB}/local"
        rm -rf "${stage}"
        return 1
    fi
    rm -rf "${stage}" ${old:+"${old}"}
    echo "Seeded $(ls -1 "${PACMAN_DB}/local" | grep -vc '^ALPM_DB_VERSION$') package entries (build ${build})."
}

cmd_check() {
    write_mirrorlist
    seed_local_db || return 1
    pacman -Sy --noconfirm >/dev/null 2>&1 || {
        echo "Failed to sync repo metadata. Check network."
        return 1
    }
    pending=$(pacman -Qu | wc -l)
    if [ "${pending}" -eq 0 ]; then
        echo "No updates available."
        return 1
    fi
    echo "Updates available: ${pending} package(s)."
    pacman -Qu
}

cmd_update() {
    write_mirrorlist
    seed_local_db || return 1
    pacman -Syu --noconfirm
}

cmd_info() {
    echo "OS:         ${OS_NAME:-ArchR} ${OS_VERSION:-?}"
    echo "Build:      ${OS_BUILD:-?}"
    echo "Channel:    ${BRANCH}"
    echo "Mirror:     https://github.com/archr-linux/archr-repo/releases/download/repo-${BRANCH}"
    echo "Pacman:     $(pacman --version | head -1 | awk '{print $3}')"
}

# Seeding needs no network (004-seed-pacmandb runs it at boot).
if [ "${1:-}" = seed ]; then
    seed_local_db
    exit $?
fi

if ! network_ok; then
    echo "Network connection unavailable."
    exit 1
fi

case "${1:-update}" in
    check)  cmd_check ;;
    update) cmd_update ;;
    info)   cmd_info ;;
    -h|--help|help) usage ;;
    *)      usage; exit 2 ;;
esac
