#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2026 ArchR (https://github.com/archr-linux/Arch-R)
#
# archr-update: wrapper around pacman to surface the same CLI ArchR
# users were promised before, while the actual update mechanism is
# pacman -Syu against the repo published on GitHub Releases.
#
# Release channel is read from system.cfg "updates.branch" and maps to
# the matching mirror tag on github.com/archr-linux/archr-repo:
#   stable -> repo-stable
#   next   -> repo-next
#   dev    -> repo-dev
#
# The mirrorlist that points to those tags is installed by the pacman
# package (/etc/pacman.d/mirrorlist).
#
# Machine interface (archr-launcher, Settings > System > Updates):
#
#   archr-update check --json
#     One JSON object on stdout and exit 0, also when nothing is pending:
#       {"os_version":"2.1.1","channel":"stable","total":1,
#        "download_size":32925696,"reboot_required":true,
#        "reboot_reason":"kernel","new_version":"2.1.2","news":"...",
#        "packages":[{"name":"linux","old":"6.12.94-3","new":"6.12.95-1",
#                     "size":32925696}]}
#     "old" is empty for a new dependency, "size" is the download in bytes.
#     reboot_reason is "kernel", "launcher" or "" (no restart needed).
#     A failure is {"error":"<reason>","message":"..."} and exit 1.
#
#   archr-update update --progress
#     One JSON object per line, in this order:
#       {"phase":"sync"}
#       {"phase":"download","package":"retroarch","bytes":..,"total":..,
#        "percent":66,"speed":1887436}           (every second; speed in B/s)
#       {"phase":"install","package":"retroarch","current":2,"count":4,
#        "percent":50}
#       {"phase":"hooks","message":"(1/3) Arming ConditionNeedsUpdate..."}
#       {"phase":"done","count":4,"reboot_required":true,
#        "reboot_reason":"kernel","old_version":"2.1.1","new_version":"2.1.2"}
#     or, at any point, the last line and exit 1:
#       {"phase":"error","reason":"download","message":"...",
#        "line":"error: failed retrieving file ...","changed":false}
#     Reasons: busy, network, battery, space, seed, sync, download,
#     cancelled, install. "line" is pacman's own error line, when there is
#     one; "changed" is true once pacman started replacing packages.
#     The download (pacman -Suw) is separate from the install (pacman -Su):
#     SIGTERM or the file /run/archr-update.cancel cancels it (pacman gets
#     SIGINT and keeps its partial files for the next try). From the install
#     on SIGTERM, SIGHUP and SIGINT are ignored, by this script and by
#     pacman, and pacman writes only to a file, so a frontend that goes away
#     cannot interrupt it; systemd-inhibit blocks sleep, shutdown and the
#     power and suspend keys meanwhile (logind sees the R36S power key).
#     Every line also goes to /run/archr-update.progress, rewritten by each
#     run once it holds the lock: archr-launcher starts the run as its own
#     unit (systemd-run), outside its session, and follows that file, also
#     after a restart of its own.
#     Before downloading: network, battery (at least 30% or charging, read
#     like archr-launcher reads it) and free space for the download; the
#     battery is checked again before installing. pacman's CheckSpace
#     guards the install itself.
#
#   Release notes: a release may carry changelog.txt next to the repo
#   (repo-<channel>/changelog.txt). Its first line is the version the
#   release brings (e.g. 2.1.2), the rest are the notes. Without it,
#   new_version and news are empty. After an update that names a version,
#   it is recorded in /var/lib/archr-update/version and reported as
#   os_version from then on (the image's /etc/os-release is not packaged).
#
#   Everything, pacman's output included, is appended to
#   /storage/.config/archr-update.log. Check and update hold
#   /run/archr-update.lock (flock) while they run: a second run fails with
#   "busy", and archr-fake-suspend does not suspend (nor power off later).

. "${ARCHR_UPDATE_PROFILE:-/etc/profile}"

# Paths can be moved for the host test (tests/archr-update-test.sh).
: "${MIRRORLIST:=/etc/pacman.d/mirrorlist}"
: "${PACMAN_DB:=/var/lib/pacman}"
: "${PACMAN_CACHE:=/var/cache/pacman/pkg}"
: "${OS_RELEASE:=/etc/os-release}"
: "${IMAGE_DB:=/usr/share/archr/pacman-image-db.tar.gz}"
: "${UPDATE_LOG:=/storage/.config/archr-update.log}"
: "${UPDATE_LOCK:=/run/archr-update.lock}"
: "${UPDATE_STATE:=/var/lib/archr-update}"
: "${POWER_SUPPLY:=/sys/class/power_supply}"
: "${UPDATE_PROGRESS:=/run/archr-update.progress}"
: "${UPDATE_CANCEL:=/run/archr-update.cancel}"
: "${TICK:=1}"
REPO="https://github.com/archr-linux/archr-repo/releases/download"
MIN_BATTERY=30
# Free space kept beyond the download; pacman's CheckSpace guards the install.
SPACE_MARGIN=$((64 * 1024 * 1024))
# Packages whose new version only runs after a restart.
REBOOT_KERNEL='^linux(-.*)?$'
REBOOT_LAUNCHER='^archr-launcher$'

BRANCH="$(get_setting updates.branch 2>/dev/null)"
# Anything that is not a real channel falls back to stable: the ES
# settings screen historically stored values like "auto" here, which
# would point the mirrorlist at a repo tag that does not exist.
case "${BRANCH}" in
    stable|next|dev) ;;
    *) BRANCH="stable" ;;
esac

# Channel is reflected by a single line in mirrorlist; rewrite it on
# the fly so the user can switch channels by changing the setting.
write_mirrorlist() {
    cat >"${MIRRORLIST}" <<EOF
# Generated by archr-update from system.cfg updates.branch=${BRANCH}
Server = ${REPO}/repo-${BRANCH}
EOF
}

network_ok() {
    ping -c 1 -W 3 8.8.8.8 >/dev/null 2>&1
}

usage() {
    cat <<EOF
Usage: ${0##*/} [check [--json]|update [--progress]|info|seed]

  check     Sync repo metadata and report whether updates are available.
            --json: one JSON report for frontends.
  update    Sync metadata and apply pending updates (pacman -Syu).
            --progress: download, then install, with JSON progress lines.
  info      Show current OS version, channel, and configured mirror.
  seed      Record this image's packages in an empty pacman database.

Channel is configured via system.cfg "updates.branch" (stable|next|dev).
EOF
}

# A freshly flashed image carries no pacman local db, so pacman has no
# installed list to compare against and every check reports "no
# updates". Seed it once from the db the image build recorded of its own
# packages (/usr/share/archr/pacman-image-db.tar.gz). Never from the
# repo: its seed lists the repo's newest versions, so a device seeded
# after the repo moved looked current and skipped every update since its
# image, migrations included. A db made for another build is refused.

seed_local_db() {
    [ -n "$(ls -A "${PACMAN_DB}/local" 2>/dev/null | grep -v '^ALPM_DB_VERSION$')" ] && return 0
    local build stage old="" entry want
    build="$(sed -n 's/^BUILD_ID="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "${OS_RELEASE}")"
    if [ ! -f "${IMAGE_DB}" ] || [ -z "${build}" ]; then
        echo "No package database for this image; cannot seed. Reflash to update." >&2
        return 1
    fi
    # Built next to the live db (same filesystem) and published with a
    # rename, so the live db is either still empty or complete: a failed
    # or interrupted attempt (disk full, power loss) leaves at most a
    # .seed-* or .empty-* directory, which the next attempt removes.
    mkdir -p "${PACMAN_DB}" || return 1
    rm -rf "${PACMAN_DB}"/.seed-* "${PACMAN_DB}"/.empty-*
    stage="$(mktemp -d "${PACMAN_DB}/.seed-XXXXXX")" || return 1
    want="$(tar -tzf "${IMAGE_DB}" 2>/dev/null | sed -n 's#^local/\([^/]*\)/desc$#\1#p')"
    if [ -z "${want}" ] || ! tar -xzf "${IMAGE_DB}" -C "${stage}" ||
       [ "$(cat "${stage}/archr-image-build" 2>/dev/null)" != "${build}" ]; then
        echo "The image package database is unreadable or not for build ${build}; not seeding." >&2
        rm -rf "${stage}"
        return 1
    fi
    for entry in ${want}; do
        if [ ! -s "${stage}/local/${entry}/desc" ] || [ ! -s "${stage}/local/${entry}/files" ]; then
            echo "The image package database is incomplete (${entry}); not seeding." >&2
            rm -rf "${stage}"
            return 1
        fi
    done
    sync
    # Set the empty db aside, then publish. Interrupted in between, there
    # is no db, which counts as empty: the next attempt seeds again.
    if [ -e "${PACMAN_DB}/local" ]; then
        old="${PACMAN_DB}/.empty-$$"
        mv "${PACMAN_DB}/local" "${old}" || { rm -rf "${stage}"; return 1; }
    fi
    if ! mv "${stage}/local" "${PACMAN_DB}/local"; then
        [ -n "${old}" ] && mv "${old}" "${PACMAN_DB}/local"
        rm -rf "${stage}"
        return 1
    fi
    rm -rf "${stage}" ${old:+"${old}"}
    echo "Seeded $(ls -1 "${PACMAN_DB}/local" | grep -vc '^ALPM_DB_VERSION$') package entries (build ${build})."
}

### Shared by every mode

logf() {
    printf '%s %s\n' "$(date '+%F %T')" "$*" >>"${UPDATE_LOG}" 2>/dev/null
}

# A JSON string: control characters dropped, quotes and newlines escaped.
json() {
    local s
    s="$(printf '%s' "$1" | tr -d '\000-\010\013\014\016-\037')"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\t'/\\t}"
    s="${s//$'\r'/}"
    s="${s//$'\n'/\\n}"
    printf '"%s"' "${s}"
}

emit() {
    printf '{%s}\n' "$1"
    if [ -n "${FOLLOWED}" ]; then
        printf '{%s}\n' "$1" >>"${UPDATE_PROGRESS}"
    fi
}

# fail REASON MESSAGE [PACMAN_LINE]: report in the mode in use and exit 1.
fail() {
    logf "failed (${1}): ${2}${3:+: ${3}}"
    case "${MODE}" in
        progress)
            emit "\"phase\":\"error\",\"reason\":$(json "$1"),\"message\":$(json "$2"),\"line\":$(json "${3:-}"),\"changed\":${CHANGED}"
            ;;
        json) emit "\"error\":$(json "$1"),\"message\":$(json "$2")" ;;
        *) echo "${2}${3:+: ${3}}" ;;
    esac
    exit 1
}

# One archr-update at a time, and none while another pacman runs. The lock
# stays held by pacman too (it inherits fd 9) if this script goes away.
take_lock() {
    mkdir -p "${UPDATE_LOCK%/*}" 2>/dev/null
    exec 9>>"${UPDATE_LOCK}" || fail busy "Cannot open ${UPDATE_LOCK}"
    flock -n 9 || fail busy "Another archr-update is running."
    if [ -e "${PACMAN_DB}/db.lck" ]; then
        pgrep -x pacman >/dev/null 2>&1 && fail busy "pacman is running."
        # Left by a pacman that was killed: nothing holds it any more.
        logf "removing a stale ${PACMAN_DB}/db.lck"
        rm -f "${PACMAN_DB}/db.lck"
    fi
}

# The capacity when it is below MIN_BATTERY and no charger is connected.
# Same supply as archr-launcher: the first named "battery" or of type Battery.
battery_low() {
    local dir capacity
    for dir in "${POWER_SUPPLY}"/*; do
        [ "${dir##*/}" = battery ] || [ "$(cat "${dir}/type" 2>/dev/null)" = Battery ] || continue
        case "$(cat "${dir}/status" 2>/dev/null)" in
            Charging|Full) return 1 ;;
        esac
        capacity="$(cat "${dir}/capacity" 2>/dev/null)"
        case "${capacity}" in
            ""|*[!0-9]*) return 1 ;;
        esac
        [ "${capacity}" -lt "${MIN_BATTERY}" ] || return 1
        echo "${capacity}"
        return 0
    done
    return 1
}

os_version() {
    if [ -s "${UPDATE_STATE}/version" ]; then
        cat "${UPDATE_STATE}/version"
    else
        sed -n 's/^VERSION="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "${OS_RELEASE}"
    fi
}

# pacman's last error line in an output file, else its last line.
last_error() {
    local line
    line="$(grep '^error:' "$1" 2>/dev/null | tail -n 1)"
    [ -n "${line}" ] || line="$(grep -v '^[[:space:]]*$' "$1" 2>/dev/null | tail -n 1)"
    printf '%s' "${line}"
}

# Run a command with its output in a file and in the log.
logged() {
    local out=$1 rc
    shift
    LC_ALL=C "$@" >"${out}" 2>&1
    rc=$?
    cat "${out}" >>"${UPDATE_LOG}" 2>/dev/null
    return ${rc}
}

sync_repo() {
    write_mirrorlist
    seed_local_db >>"${UPDATE_LOG}" 2>&1 ||
        fail seed "No package database for this image; reflash to update."
    logged "${WORK}/sync" pacman -Sy --noconfirm --color never ||
        fail sync "Failed to sync repo metadata." "$(last_error "${WORK}/sync")"
}

# Every package the upgrade brings, one per line: "name old new size file",
# old "-" for a new dependency. Read from the db the sync just fetched.
list_targets() {
    local name version size location out
    local -A installed=()
    while read -r name version; do
        installed["${name}"]="${version}"
    done < <(LC_ALL=C pacman -Q 2>/dev/null)
    out="$(LC_ALL=C pacman -Sup --color never --print-format '%n %v %s %l' 2>"${WORK}/targets")" ||
        return 1
    while read -r name version size location; do
        case "${size}" in
            ""|*[!0-9]*) continue ;;
        esac
        echo "${name} ${installed[${name}]:--} ${version} ${size} ${location##*/}"
    done <<<"${out}"
}

# The release's changelog.txt: the version it brings, then the notes.
fetch_notes() {
    local notes
    notes="$(curl -fsSL --max-time 10 --max-filesize 65536 \
        "${REPO}/repo-${BRANCH}/changelog.txt" 2>/dev/null)" || notes=""
    NEW_VERSION="$(printf '%s\n' "${notes}" | sed -n '1s/^[[:space:]]*\([^[:space:]]*\)[[:space:]]*$/\1/p')"
    case "${NEW_VERSION}" in
        *[!0-9A-Za-z._-]*) NEW_VERSION="" ;;
    esac
    if [ -n "${NEW_VERSION}" ]; then
        NEWS="$(printf '%s\n' "${notes}" | sed '1d' | sed '/[^[:space:]]/,$!d')"
    else
        NEWS="${notes}"
    fi
    NEWS="${NEWS:0:2000}"
}

# "kernel", "launcher" or nothing, from target lines on stdin.
reboot_reason() {
    local name reason=""
    while read -r name _; do
        [[ ${name} =~ ${REBOOT_KERNEL} ]] && { echo kernel; return; }
        [[ ${name} =~ ${REBOOT_LAUNCHER} ]] && reason=launcher
    done
    echo "${reason}"
}

reboot_fields() {
    local required=false
    [ -n "$1" ] && required=true
    printf '"reboot_required":%s,"reboot_reason":%s' "${required}" "$(json "$1")"
}

### check --json

cmd_check_json() {
    local targets packages="" total=0 size=0 name old new bytes file
    take_lock
    network_ok || fail network "Network connection unavailable."
    sync_repo
    targets="$(list_targets)" ||
        fail sync "Cannot list the upgrade." "$(last_error "${WORK}/targets")"
    fetch_notes
    while read -r name old new bytes file; do
        [ -n "${name}" ] || continue
        [ "${old}" = - ] && old=""
        packages="${packages:+${packages},}{\"name\":$(json "${name}"),\"old\":$(json "${old}"),\"new\":$(json "${new}"),\"size\":${bytes}}"
        total=$((total + 1))
        size=$((size + bytes))
    done <<<"${targets}"
    logf "check: ${total} package(s), ${size} bytes on ${BRANCH}"
    emit "\"os_version\":$(json "$(os_version)"),\"channel\":$(json "${BRANCH}"),\"total\":${total},\"download_size\":${size},$(reboot_fields "$(reboot_reason <<<"${targets}")"),\"new_version\":$(json "${NEW_VERSION}"),\"news\":$(json "${NEWS}"),\"packages\":[${packages}]"
}

### update --progress

# "bytes package": what the targets already have in the cache, finished or
# partial, and the package being written. pacman 7 downloads into
# download-*/ under the cache and moves the file up when it is complete.
cached_bytes() {
    find "${PACMAN_CACHE}" -maxdepth 2 -type f -name '*.pkg.tar*' -printf '%f %s\n' 2>/dev/null |
        awk -v list="${WORK}/files" '
            BEGIN { while ((getline line < list) > 0) { split(line, f, " "); want[f[1]] = f[2]; pkg[f[1]] = f[3] } }
            { file = $1; sub(/\.part$/, "", file)
              if (!(file in want)) next
              if ($2 > got[file]) got[file] = $2
              if ($1 ~ /\.part$/) part = pkg[file] }
            END { for (name in got) sum += (got[name] > want[name] ? want[name] : got[name])
                  printf "%d %s\n", sum, part }'
}

cancel() {
    CANCELLED=1
    [ -n "${PID}" ] && kill -INT "${PID}" 2>/dev/null
}

run_download() {
    local rc state bytes package speed=0 previous percent waited=0 now then
    LC_ALL=C pacman -Suw --noconfirm --noprogressbar --color never >"${WORK}/download" 2>&1 &
    PID=$!
    state="$(cached_bytes)"
    previous="${state%% *}"
    then=$(date +%s%3N)
    while :; do
        state="$(cached_bytes)"
        bytes="${state%% *}"
        package="${state#* }"
        now=$(date +%s%3N)
        # Bytes per second, smoothed over two ticks.
        [ "${now}" -gt "${then}" ] &&
            speed=$(((speed + (bytes - previous) * 1000 / (now - then)) / 2))
        [ "${speed}" -lt 0 ] && speed=0
        previous="${bytes}"
        then="${now}"
        percent=100
        [ "${TOTAL}" -gt 0 ] && percent=$((bytes * 100 / TOTAL))
        kill -0 "${PID}" 2>/dev/null || break
        emit "\"phase\":\"download\",\"package\":$(json "${package}"),\"bytes\":${bytes},\"total\":${TOTAL},\"percent\":${percent},\"speed\":${speed}"
        sleep "${TICK}"
        [ -e "${UPDATE_CANCEL}" ] && [ -z "${CANCELLED}" ] && cancel
        # pacman stops at SIGINT; one that does not is ended after 10 ticks.
        if [ -n "${CANCELLED}" ]; then
            waited=$((waited + 1))
            [ "${waited}" -ge 10 ] && kill -TERM "${PID}" 2>/dev/null
        fi
    done
    wait "${PID}"
    rc=$?
    PID=""
    cat "${WORK}/download" >>"${UPDATE_LOG}" 2>/dev/null
    [ -n "${CANCELLED}" ] && fail cancelled "Download cancelled."
    [ "${rc}" -eq 0 ] || fail download "Download failed." "$(last_error "${WORK}/download")"
    emit "\"phase\":\"download\",\"package\":\"\",\"bytes\":${TOTAL},\"total\":${TOTAL},\"percent\":100,\"speed\":0"
}

# New complete lines of pacman's output: package starts and hook steps.
install_lines() {
    local lines line package
    lines=$(wc -l <"${WORK}/install")
    [ "${lines}" -gt "${SEEN}" ] || return 0
    while IFS= read -r line; do
        case "${line}" in
            "upgrading "*...|"installing "*...|"reinstalling "*...|"downgrading "*...)
                CHANGED=true
                package="${line#* }"
                package="${package%...}"
                CURRENT=$((CURRENT + 1))
                [ "${CURRENT}" -gt "${COUNT}" ] && CURRENT=${COUNT}
                emit "\"phase\":\"install\",\"package\":$(json "${package}"),\"current\":${CURRENT},\"count\":${COUNT},\"percent\":$((CURRENT * 100 / COUNT))"
                ;;
            ":: Running post-transaction hooks"*)
                HOOKS=1
                emit "\"phase\":\"hooks\",\"message\":\"\""
                ;;
            "("*") "*)
                [ -n "${HOOKS}" ] && emit "\"phase\":\"hooks\",\"message\":$(json "${line}")"
                ;;
        esac
    done < <(sed -n "$((SEEN + 1)),${lines}p" "${WORK}/install")
    SEEN=${lines}
}

run_install() {
    local rc line
    # Past this point nothing stops pacman: not this script's signals, not
    # pacman's (ignored dispositions survive exec), not a closed reader.
    trap '' TERM HUP INT
    (trap '' TERM HUP INT; LC_ALL=C exec pacman -Su --noconfirm --noprogressbar --color never) \
        >"${WORK}/install" 2>&1 </dev/null &
    PID=$!
    # No sleep, power off or power/suspend key while pacman runs. A holder
    # process keeps the inhibitor: pacman is not systemd-inhibit's child,
    # whose signals it would reset. It ends with this script at the latest.
    local holder=""
    if command -v systemd-inhibit >/dev/null 2>&1; then
        systemd-inhibit --what=sleep:shutdown:handle-power-key:handle-suspend-key \
            --mode=block --who=archr-update --why="System update in progress" \
            tail --pid="${PID}" -f /dev/null >/dev/null 2>&1 9>&- &
        holder=$!
    fi
    SEEN=0
    CURRENT=0
    while kill -0 "${PID}" 2>/dev/null; do
        install_lines
        sleep 0.5
    done
    wait "${PID}"
    rc=$?
    [ -n "${holder}" ] && kill "${holder}" 2>/dev/null
    install_lines
    cat "${WORK}/install" >>"${UPDATE_LOG}" 2>/dev/null
    [ "${rc}" -eq 0 ] && return 0
    line="$(last_error "${WORK}/install")"
    case "${line}" in
        *"too full"*|*"not enough free disk space"*)
            fail space "Not enough free space to install." "${line}" ;;
    esac
    fail install "Install failed." "${line}"
}

cmd_update_progress() {
    local low targets old space cached reason
    take_lock
    # Only the lock's holder rewrites the file a frontend follows.
    rm -f "${UPDATE_CANCEL}"
    : >"${UPDATE_PROGRESS}" && FOLLOWED=1
    emit '"phase":"sync"'
    network_ok || fail network "Network connection unavailable."
    low="$(battery_low)" &&
        fail battery "Battery at ${low}%; connect the charger (needs ${MIN_BATTERY}%)."
    old="$(os_version)"
    sync_repo
    targets="$(list_targets)" ||
        fail sync "Cannot list the upgrade." "$(last_error "${WORK}/targets")"
    fetch_notes
    if [ -z "${targets}" ]; then
        logf "update: nothing to do on ${BRANCH}"
        emit "\"phase\":\"done\",\"count\":0,$(reboot_fields ""),\"old_version\":$(json "${old}"),\"new_version\":$(json "${old}")"
        return 0
    fi
    COUNT=$(wc -l <<<"${targets}")
    TOTAL=$(awk '{ sum += $4 } END { printf "%d", sum }' <<<"${targets}")
    awk '{ print $5, $4, $1 }' <<<"${targets}" >"${WORK}/files"
    reason="$(reboot_reason <<<"${targets}")"
    logf "update: ${COUNT} package(s), ${TOTAL} bytes on ${BRANCH}"
    mkdir -p "${PACMAN_CACHE}"
    space=$(df -Pk "${PACMAN_CACHE}" 2>/dev/null | awk 'NR == 2 { print $4 }')
    cached="$(cached_bytes)"
    if [ -n "${space}" ] && [ $((space * 1024)) -lt $((TOTAL - ${cached%% *} + SPACE_MARGIN)) ]; then
        fail space "Not enough free space to download $((TOTAL / 1048576)) MiB."
    fi
    run_download
    low="$(battery_low)" &&
        fail battery "Battery at ${low}%; connect the charger (needs ${MIN_BATTERY}%)."
    run_install
    if [ -n "${NEW_VERSION}" ]; then
        mkdir -p "${UPDATE_STATE}" && echo "${NEW_VERSION}" >"${UPDATE_STATE}/version"
    fi
    logf "update: done"
    emit "\"phase\":\"done\",\"count\":${COUNT},$(reboot_fields "${reason}"),\"old_version\":$(json "${old}"),\"new_version\":$(json "$(os_version)")"
}

### Human CLI

cmd_check() {
    take_lock
    write_mirrorlist
    seed_local_db || return 1
    pacman -Sy --noconfirm >/dev/null 2>&1 || {
        echo "Failed to sync repo metadata. Check network."
        return 1
    }
    pending=$(pacman -Qu | wc -l)
    if [ "${pending}" -eq 0 ]; then
        echo "No updates available."
        return 1
    fi
    echo "Updates available: ${pending} package(s)."
    pacman -Qu
}

cmd_update() {
    take_lock
    write_mirrorlist
    seed_local_db || return 1
    pacman -Syu --noconfirm
}

cmd_info() {
    echo "OS:         ${OS_NAME:-ArchR} ${OS_VERSION:-?}"
    echo "Build:      ${OS_BUILD:-?}"
    echo "Channel:    ${BRANCH}"
    echo "Mirror:     ${REPO}/repo-${BRANCH}"
    echo "Pacman:     $(pacman --version | head -1 | awk '{print $3}')"
}

# Seeding needs no network (004-seed-pacmandb runs it at boot).
if [ "${1:-}" = seed ]; then
    seed_local_db
    exit $?
fi

MODE=plain
CHANGED=false
case "${1:-update} ${2:-}" in
    "check --json") MODE=json ;;
    "update --progress") MODE=progress ;;
esac
if [ "${MODE}" != plain ]; then
    # A reader that goes away must not kill the run: writes just fail.
    trap '' PIPE
    mkdir -p "${UPDATE_LOG%/*}" 2>/dev/null
    WORK="$(mktemp -d)" || exit 1
    trap 'rm -rf "${WORK}"; if [ -n "${FOLLOWED}" ]; then rm -f "${UPDATE_CANCEL}"; fi' EXIT
    logf "archr-update ${1} ${2} (channel ${BRANCH})"
    if [ "${MODE}" = json ]; then
        cmd_check_json
    else
        trap cancel TERM
        cmd_update_progress
    fi
    exit $?
fi

if ! network_ok; then
    echo "Network connection unavailable."
    exit 1
fi

case "${1:-update}" in
    check)  cmd_check ;;
    update) cmd_update ;;
    info)   cmd_info ;;
    -h|--help|help) usage ;;
    *)      usage; exit 2 ;;
esac
