#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2026 ArchR (https://github.com/archr-linux/Arch-R)
#
# archr-update: wrapper around pacman to surface the same CLI ArchR
# users were promised before, while the actual update mechanism is
# pacman -Syu against the repo published on GitHub Releases.
#
# Release channel is read from system.cfg "updates.branch" and maps to
# the matching mirror tag on github.com/archr-linux/archr-repo:
#   stable -> repo-stable
#   next   -> repo-next (not published yet: reads stable)
#   dev    -> repo-dev  (not published yet: reads stable)
#
# The mirrorlist that points to those tags is installed by the pacman
# package (/etc/pacman.d/mirrorlist).
#
# Machine interface (archr-launcher, Settings > System > Updates):
#
#   archr-update check --json
#     One JSON object on stdout and exit 0, also when nothing is pending:
#       {"os_version":"2.1.1","channel":"stable","total":1,
#        "download_size":32925696,"reboot_required":true,
#        "reboot_reason":"kernel","new_version":"2.1.2","news":"...",
#        "packages":[{"name":"linux","old":"6.12.94-3","new":"6.12.95-1",
#                     "size":32925696}]}
#     "old" is empty for a new dependency, "size" is the download in bytes.
#     reboot_reason is "kernel", "launcher" or "" (no restart needed).
#     A failure is {"error":"<reason>","message":"..."} and exit 1; a
#     refusal (busy, network, battery, space, cancelled: the console's
#     state, not a fault) exits 75 instead.
#
#   archr-update update --progress
#     One JSON object per line, in this order:
#       {"phase":"sync"}
#       {"phase":"download","package":"retroarch","bytes":..,"total":..,
#        "percent":66,"speed":1887436}           (every second; speed in B/s)
#       {"phase":"install","package":"retroarch","current":2,"count":4,
#        "percent":50}
#       {"phase":"hooks","message":"(1/3) Arming ConditionNeedsUpdate..."}
#       {"phase":"done","count":4,"reboot_required":true,
#        "reboot_reason":"kernel","old_version":"2.1.1","new_version":"2.1.2"}
#     or, at any point, the last line and exit 1 (75 for a refusal):
#       {"phase":"error","reason":"download","message":"...",
#        "line":"error: failed retrieving file ...","changed":false}
#     Reasons: busy, network, battery, space, seed, sync, download,
#     cancelled, install. "line" is pacman's own error line, when there is
#     one; "changed" is true once pacman started replacing packages.
#     The download (pacman -Suw) is separate from the install (pacman -Su):
#     SIGTERM or the file /run/archr-update.cancel cancels it (pacman gets
#     SIGINT and keeps its partial files for the next try). From the install
#     on SIGTERM, SIGHUP and SIGINT are ignored, by this script and by
#     pacman, and pacman writes only to a file, so a frontend that goes away
#     cannot interrupt it; systemd-inhibit blocks sleep, shutdown and the
#     power and suspend keys meanwhile (logind sees the R36S power key).
#     Every line also goes to /run/archr-update.progress, rewritten by each
#     run once it holds the lock: archr-launcher starts the run as its own
#     unit (systemd-run), outside its session, and follows that file, also
#     after a restart of its own.
#     Before downloading: network, battery (at least 30% or charging, read
#     like archr-launcher reads it) and free space for the download; the
#     battery is checked again before installing. pacman's CheckSpace
#     guards the install itself.
#
#   Release notes: a release may carry changelog.txt next to the repo
#   (repo-<channel>/changelog.txt). Its first line is the version the
#   release brings (e.g. 2.1.2), the rest are the notes. Without it,
#   new_version and news are empty. After an update that names a version,
#   it is recorded in /var/lib/archr-update/version (the image's
#   /etc/os-release is not packaged).
#
#   archr-update version
#     The system's version: the recorded one when newer than the image's,
#     else /etc/os-release. The one place that decides it; os_version and
#     archr-launcher's Information page use it.
#
#   Installed update id: every successful update records the id it brought
#   (e.g. 20261113.4) in /var/lib/archr-update/update-id: the network path
#   when the release's changelog.txt names one, the offline path always (the
#   bundle's manifest id). Consoles updated before this file existed have
#   the same id in /var/lib/archr-update/version (changelog.txt's first
#   line), which is read when it has an id's shape. A console never updated
#   has none ("current" is empty), and any bundle counts as newer for it.
#
#   Update without network (a bundle on the card):
#     The bundle is one uncompressed tar, archr-update*.tar, in
#     /storage/roms/update/ (roms/update/ on the card from a PC), made by
#     scripts/repo/gen-offline-update: archr-update.txt (id=, channel=,
#     created=), archr.db and archr.db.sig (the repo db and its signature),
#     changelog.txt and the .pkg.tar.zst files, all top-level.
#
#   archr-update offline [--json]
#     Creates the folder when missing, then reads only the manifest and
#     changelog of every bundle in it (no extraction) and reports the
#     newest one (by id; one of this console's channel first). One JSON line and exit 0 in both cases:
#       {"found":false}
#       {"found":true,"file":"/storage/roms/update/archr-update.tar",
#        "id":"20261113.4","channel":"stable","newer":true,
#        "current":"20261112.6","changelog":["- ...","- ..."]}
#     newer compares the ids only; a bundle is installable when newer is
#     true and channel is this console's. changelog: the "- " lines of the
#     bundle's changelog.txt above the first id not newer than current
#     (only the first id's lines when current is empty). Without --json,
#     one human line.
#
#   archr-update update --from <tar> [--progress]
#     JSON progress lines like update --progress (with or without
#     --progress), with an extract phase before sync and no download:
#       {"phase":"extract","bytes":..,"total":..,"percent":40}
#       {"phase":"sync"} {"phase":"install",..} {"phase":"hooks",..}
#       {"phase":"done",..}
#     Same lock, battery, space and cancel rules (SIGTERM or the cancel
#     file stop it while extracting). The bundle is extracted into
#     /storage/.archr-update-offline (free space: the tar's size plus a
#     margin; CheckSpace guards the install) and pacman runs with a copy of
#     /etc/pacman.conf whose [archr] Server is file://<that dir> and whose
#     CacheDir is that dir; SigLevel is untouched, so pacman checks the db
#     signature against the archr keyring as it does online. The work dir
#     is always removed; the tar only after a successful install. Never
#     touches the network. Extra reasons:
#       offline-invalid     unreadable tar or manifest, another channel, or
#                           pacman rejected the db (signature)    (exit 1)
#       offline-old         its id is not newer than the installed one (75)
#       offline-incomplete  this console needs a package the bundle does
#                           not carry: older than every supported image,
#                           reflash                                (75)
#
#   Everything, pacman's output included, is appended to
#   /storage/.config/archr-update.log. Check and update hold
#   /run/archr-update.lock (flock) while they run: a second run fails with
#   "busy", and archr-fake-suspend does not suspend (nor power off later).

. "${ARCHR_UPDATE_PROFILE:-/etc/profile}"

# Paths can be moved for the host test (tests/archr-update-test.sh).
: "${MIRRORLIST:=/etc/pacman.d/mirrorlist}"
: "${PACMAN_DB:=/var/lib/pacman}"
: "${PACMAN_CACHE:=/var/cache/pacman/pkg}"
: "${OS_RELEASE:=/etc/os-release}"
: "${IMAGE_DB:=/usr/share/archr/pacman-image-db.tar.gz}"
: "${UPDATE_LOG:=/storage/.config/archr-update.log}"
: "${UPDATE_LOCK:=/run/archr-update.lock}"
: "${UPDATE_STATE:=/var/lib/archr-update}"
: "${POWER_SUPPLY:=/sys/class/power_supply}"
: "${UPDATE_PROGRESS:=/run/archr-update.progress}"
: "${UPDATE_CANCEL:=/run/archr-update.cancel}"
: "${TICK:=1}"
: "${DOWNLOAD_TRIES:=3}"
: "${RETRY_TICKS:=5}"
: "${PACMAN_CONF:=/etc/pacman.conf}"
: "${ARCHR_UPDATE_OFFLINE_DIR:=/storage/roms/update}"
: "${OFFLINE_WORK:=/storage/.archr-update-offline}"
# Extra pacman options: the offline path's temporary config; empty online.
PACMAN_ARGS=()
REPO="https://github.com/archr-linux/archr-repo/releases/download"
MIN_BATTERY=30
# Free space kept beyond the download; pacman's CheckSpace guards the install.
SPACE_MARGIN=$((64 * 1024 * 1024))
# Packages whose new version only runs after a restart.
REBOOT_KERNEL='^linux(-.*)?$'
REBOOT_LAUNCHER='^archr-launcher$'

BRANCH="$(get_setting updates.branch 2>/dev/null)"
# Only channels with a published repo tag; anything else falls back to
# stable. The ES settings screen stored values like "auto" here, and the
# launcher offered next and dev before repo-next/repo-dev existed: both
# pointed the mirrorlist at a tag that does not exist, and the update
# could not reach the repository. Add a channel here when its tag ships.
case "${BRANCH}" in
    stable) ;;
    *) BRANCH="stable" ;;
esac

# Channel is reflected by a single line in mirrorlist; rewrite it on
# the fly so the user can switch channels by changing the setting.
write_mirrorlist() {
    cat >"${MIRRORLIST}" <<EOF
# Generated by archr-update from system.cfg updates.branch=${BRANCH}
Server = ${REPO}/repo-${BRANCH}
EOF
}

network_ok() {
    ping -c 1 -W 3 8.8.8.8 >/dev/null 2>&1
}

usage() {
    cat <<EOF
Usage: ${0##*/} [check [--json]|update [--progress] [--from TAR]|offline [--json]|info|seed|version]

  check     Sync repo metadata and report whether updates are available.
            --json: one JSON report for frontends.
  update    Sync metadata and apply pending updates (pacman -Syu).
            --progress: download, then install, with JSON progress lines.
            --from TAR: install an update bundle from the card, no network.
  offline   Look for an update bundle in ${ARCHR_UPDATE_OFFLINE_DIR}.
            --json: one JSON report for frontends.
  info      Show current OS version, channel, and configured mirror.
  seed      Record this image's packages in an empty pacman database.
  version   Print the system's version.

Channel is configured via system.cfg "updates.branch"; only stable is
published, any other value reads stable.
EOF
}

# A freshly flashed image carries no pacman local db, so pacman has no
# installed list to compare against and every check reports "no
# updates". Seed it once from the db the image build recorded of its own
# packages (/usr/share/archr/pacman-image-db.tar.gz). Never from the
# repo: its seed lists the repo's newest versions, so a device seeded
# after the repo moved looked current and skipped every update since its
# image, migrations included. A db made for another build is refused.

seed_local_db() {
    [ -n "$(ls -A "${PACMAN_DB}/local" 2>/dev/null | grep -v '^ALPM_DB_VERSION$')" ] && return 0
    local build stage old="" entry want
    build="$(sed -n 's/^BUILD_ID="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "${OS_RELEASE}")"
    if [ ! -f "${IMAGE_DB}" ] || [ -z "${build}" ]; then
        echo "No package database for this image; cannot seed. Reflash to update." >&2
        return 1
    fi
    # Built next to the live db (same filesystem) and published with a
    # rename, so the live db is either still empty or complete: a failed
    # or interrupted attempt (disk full, power loss) leaves at most a
    # .seed-* or .empty-* directory, which the next attempt removes.
    mkdir -p "${PACMAN_DB}" || return 1
    rm -rf "${PACMAN_DB}"/.seed-* "${PACMAN_DB}"/.empty-*
    stage="$(mktemp -d "${PACMAN_DB}/.seed-XXXXXX")" || return 1
    want="$(tar -tzf "${IMAGE_DB}" 2>/dev/null | sed -n 's#^local/\([^/]*\)/desc$#\1#p')"
    if [ -z "${want}" ] || ! tar -xzf "${IMAGE_DB}" -C "${stage}" ||
       [ "$(cat "${stage}/archr-image-build" 2>/dev/null)" != "${build}" ]; then
        echo "The image package database is unreadable or not for build ${build}; not seeding." >&2
        rm -rf "${stage}"
        return 1
    fi
    for entry in ${want}; do
        if [ ! -s "${stage}/local/${entry}/desc" ] || [ ! -s "${stage}/local/${entry}/files" ]; then
            echo "The image package database is incomplete (${entry}); not seeding." >&2
            rm -rf "${stage}"
            return 1
        fi
    done
    sync
    # Set the empty db aside, then publish. Interrupted in between, there
    # is no db, which counts as empty: the next attempt seeds again.
    if [ -e "${PACMAN_DB}/local" ]; then
        old="${PACMAN_DB}/.empty-$$"
        mv "${PACMAN_DB}/local" "${old}" || { rm -rf "${stage}"; return 1; }
    fi
    if ! mv "${stage}/local" "${PACMAN_DB}/local"; then
        [ -n "${old}" ] && mv "${old}" "${PACMAN_DB}/local"
        rm -rf "${stage}"
        return 1
    fi
    rm -rf "${stage}" ${old:+"${old}"}
    echo "Seeded $(ls -1 "${PACMAN_DB}/local" | grep -vc '^ALPM_DB_VERSION$') package entries (build ${build})."
}

### Shared by every mode

logf() {
    printf '%s %s\n' "$(date '+%F %T')" "$*" >>"${UPDATE_LOG}" 2>/dev/null
}

# A JSON string: control characters dropped, quotes and newlines escaped.
json() {
    local s
    s="$(printf '%s' "$1" | tr -d '\000-\010\013\014\016-\037')"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\t'/\\t}"
    s="${s//$'\r'/}"
    s="${s//$'\n'/\\n}"
    printf '"%s"' "${s}"
}

emit() {
    printf '{%s}\n' "$1"
    if [ -n "${FOLLOWED}" ]; then
        printf '{%s}\n' "$1" >>"${UPDATE_PROGRESS}"
    fi
}

# fail REASON MESSAGE [PACMAN_LINE]: report in the mode in use and exit 1,
# or 75 when the console refused (low battery, no network, no space, another
# update, the player cancelled): archr-update.service takes 75 as success,
# so those never become error reports.
fail() {
    logf "failed (${1}): ${2}${3:+: ${3}}"
    case "${MODE}" in
        progress)
            emit "\"phase\":\"error\",\"reason\":$(json "$1"),\"message\":$(json "$2"),\"line\":$(json "${3:-}"),\"changed\":${CHANGED}"
            ;;
        json) emit "\"error\":$(json "$1"),\"message\":$(json "$2")" ;;
        *) echo "${2}${3:+: ${3}}" ;;
    esac
    case "$1" in
        busy|network|battery|space|cancelled|offline-old|offline-incomplete) exit 75 ;;
    esac
    exit 1
}

# One archr-update at a time, and none while another pacman runs. The lock
# stays held by pacman too (it inherits fd 9) if this script goes away.
take_lock() {
    mkdir -p "${UPDATE_LOCK%/*}" 2>/dev/null
    exec 9>>"${UPDATE_LOCK}" || fail busy "Cannot open ${UPDATE_LOCK}"
    flock -n 9 || fail busy "Another archr-update is running."
    if [ -e "${PACMAN_DB}/db.lck" ]; then
        # pidof matches the basename: BusyBox pgrep -x compares the whole
        # argv[0] and would miss a pacman started as /usr/bin/pacman.
        pidof pacman >/dev/null 2>&1 && fail busy "pacman is running."
        # Left by a pacman that was killed: nothing holds it any more.
        logf "removing a stale ${PACMAN_DB}/db.lck"
        rm -f "${PACMAN_DB}/db.lck"
    fi
}

# The capacity when it is below MIN_BATTERY and no charger is connected.
# Same supply as archr-launcher: the first named "battery" or of type Battery.
battery_low() {
    local dir capacity
    for dir in "${POWER_SUPPLY}"/*; do
        [ "${dir##*/}" = battery ] || [ "$(cat "${dir}/type" 2>/dev/null)" = Battery ] || continue
        case "$(cat "${dir}/status" 2>/dev/null)" in
            Charging|Full) return 1 ;;
        esac
        capacity="$(cat "${dir}/capacity" 2>/dev/null)"
        case "${capacity}" in
            ""|*[!0-9]*) return 1 ;;
        esac
        [ "${capacity}" -lt "${MIN_BATTERY}" ] || return 1
        echo "${capacity}"
        return 0
    done
    return 1
}

# The recorded version when newer than the image's (a newer image flashed
# over an updated one wins), else the image's.
os_version() {
    local image recorded
    image="$(sed -n 's/^VERSION="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "${OS_RELEASE}")"
    recorded="$(cat "${UPDATE_STATE}/version" 2>/dev/null)"
    if [ -n "${recorded}" ] &&
       [ "$(printf '%s\n%s\n' "${image}" "${recorded}" | sort -V | tail -n 1)" = "${recorded}" ]; then
        echo "${recorded}"
    else
        echo "${image}"
    fi
}

# pacman's last error line in an output file, else its last line.
last_error() {
    local line
    line="$(grep '^error:' "$1" 2>/dev/null | tail -n 1)"
    [ -n "${line}" ] || line="$(grep -v '^[[:space:]]*$' "$1" 2>/dev/null | tail -n 1)"
    printf '%s' "${line}"
}

# Run a command with its output in a file and in the log.
logged() {
    local out=$1 rc
    shift
    LC_ALL=C "$@" >"${out}" 2>&1
    rc=$?
    cat "${out}" >>"${UPDATE_LOG}" 2>/dev/null
    return ${rc}
}

sync_repo() {
    write_mirrorlist
    seed_local_db >>"${UPDATE_LOG}" 2>&1 ||
        fail seed "No package database for this image; reflash to update."
    logged "${WORK}/sync" pacman -Sy --noconfirm --color never ||
        fail sync "Failed to sync repo metadata." "$(last_error "${WORK}/sync")"
}

# Every package the upgrade brings, one per line: "name old new size file",
# old "-" for a new dependency. Read from the db the sync just fetched.
list_targets() {
    local name version size location out
    local -A installed=()
    while read -r name version; do
        installed["${name}"]="${version}"
    done < <(LC_ALL=C pacman -Q 2>/dev/null)
    out="$(LC_ALL=C pacman -Sup --color never --print-format '%n %v %s %l' "${PACMAN_ARGS[@]}" 2>"${WORK}/targets")" ||
        return 1
    while read -r name version size location; do
        case "${size}" in
            ""|*[!0-9]*) continue ;;
        esac
        echo "${name} ${installed[${name}]:--} ${version} ${size} ${location##*/}"
    done <<<"${out}"
}

# The release's changelog.txt: the version it brings, then the notes.
fetch_notes() {
    local notes
    notes="$(curl -fsSL --max-time 10 --max-filesize 65536 \
        "${REPO}/repo-${BRANCH}/changelog.txt" 2>/dev/null)" || notes=""
    NEW_VERSION="$(printf '%s\n' "${notes}" | sed -n '1s/^[[:space:]]*\([^[:space:]]*\)[[:space:]]*$/\1/p')"
    case "${NEW_VERSION}" in
        *[!0-9A-Za-z._-]*) NEW_VERSION="" ;;
    esac
    if [ -n "${NEW_VERSION}" ]; then
        NEWS="$(printf '%s\n' "${notes}" | sed '1d' | sed '/[^[:space:]]/,$!d')"
    else
        NEWS="${notes}"
    fi
    NEWS="${NEWS:0:2000}"
}

# "kernel", "launcher" or nothing, from target lines on stdin.
reboot_reason() {
    local name reason=""
    while read -r name _; do
        [[ ${name} =~ ${REBOOT_KERNEL} ]] && { echo kernel; return; }
        [[ ${name} =~ ${REBOOT_LAUNCHER} ]] && reason=launcher
    done
    echo "${reason}"
}

reboot_fields() {
    local required=false
    [ -n "$1" ] && required=true
    printf '"reboot_required":%s,"reboot_reason":%s' "${required}" "$(json "$1")"
}

### check --json

cmd_check_json() {
    local targets packages="" total=0 size=0 name old new bytes file
    take_lock
    network_ok || fail network "Network connection unavailable."
    sync_repo
    targets="$(list_targets)" ||
        fail sync "Cannot list the upgrade." "$(last_error "${WORK}/targets")"
    fetch_notes
    while read -r name old new bytes file; do
        [ -n "${name}" ] || continue
        [ "${old}" = - ] && old=""
        packages="${packages:+${packages},}{\"name\":$(json "${name}"),\"old\":$(json "${old}"),\"new\":$(json "${new}"),\"size\":${bytes}}"
        total=$((total + 1))
        size=$((size + bytes))
    done <<<"${targets}"
    logf "check: ${total} package(s), ${size} bytes on ${BRANCH}"
    emit "\"os_version\":$(json "$(os_version)"),\"channel\":$(json "${BRANCH}"),\"total\":${total},\"download_size\":${size},$(reboot_fields "$(reboot_reason <<<"${targets}")"),\"new_version\":$(json "${NEW_VERSION}"),\"news\":$(json "${NEWS}"),\"packages\":[${packages}]"
}

### update --progress

# "bytes package": what the targets already have in the cache, finished or
# partial, and the package being written. pacman 7 downloads into
# download-*/ under the cache and moves the file up when it is complete.
# -H: on the device the cache is a symlink into /storage/.pacman/cache,
# and find does not enter a starting point that is a symlink without it
# (the download progress sat at 0 % until the end).
cached_bytes() {
    find -H "${PACMAN_CACHE}" -maxdepth 2 -type f -name '*.pkg.tar*' -printf '%f %s\n' 2>/dev/null |
        awk -v list="${WORK}/files" '
            BEGIN { while ((getline line < list) > 0) { split(line, f, " "); want[f[1]] = f[2]; pkg[f[1]] = f[3] } }
            { file = $1; sub(/\.part$/, "", file)
              if (!(file in want)) next
              if ($2 > got[file]) got[file] = $2
              if ($1 ~ /\.part$/) part = pkg[file] }
            END { for (name in got) sum += (got[name] > want[name] ? want[name] : got[name])
                  printf "%d %s\n", sum, part }'
}

cancel() {
    CANCELLED=1
    [ -n "${PID}" ] && kill -INT "${PID}" 2>/dev/null
}

# A download that stalls or drops (weak Wi-Fi, the link coming back after
# sleep) is tried again, up to DOWNLOAD_TRIES times: pacman keeps the
# partial files and resumes them.
run_download() {
    local try=1
    while :; do
        download_once && break
        [ -n "${CANCELLED}" ] && fail cancelled "Download cancelled."
        [ "${try}" -ge "${DOWNLOAD_TRIES}" ] &&
            fail download "Download failed." "$(last_error "${WORK}/download")"
        logf "download failed (try ${try} of ${DOWNLOAD_TRIES}): $(last_error "${WORK}/download"); trying again"
        try=$((try + 1))
        # A pause in ticks, so a cancel is seen at once.
        for _ in $(seq 1 "${RETRY_TICKS}"); do
            sleep "${TICK}"
            [ -e "${UPDATE_CANCEL}" ] && CANCELLED=1
            [ -n "${CANCELLED}" ] && fail cancelled "Download cancelled."
        done
    done
    emit "\"phase\":\"download\",\"package\":\"\",\"bytes\":${TOTAL},\"total\":${TOTAL},\"percent\":100,\"speed\":0"
}

download_once() {
    local rc state bytes package speed=0 previous percent waited=0 now then
    LC_ALL=C pacman -Suw --noconfirm --noprogressbar --color never >"${WORK}/download" 2>&1 &
    PID=$!
    state="$(cached_bytes)"
    previous="${state%% *}"
    then=$(date +%s%3N)
    while :; do
        state="$(cached_bytes)"
        bytes="${state%% *}"
        package="${state#* }"
        now=$(date +%s%3N)
        # Bytes per second, smoothed over two ticks.
        [ "${now}" -gt "${then}" ] &&
            speed=$(((speed + (bytes - previous) * 1000 / (now - then)) / 2))
        [ "${speed}" -lt 0 ] && speed=0
        previous="${bytes}"
        then="${now}"
        percent=100
        [ "${TOTAL}" -gt 0 ] && percent=$((bytes * 100 / TOTAL))
        kill -0 "${PID}" 2>/dev/null || break
        emit "\"phase\":\"download\",\"package\":$(json "${package}"),\"bytes\":${bytes},\"total\":${TOTAL},\"percent\":${percent},\"speed\":${speed}"
        sleep "${TICK}"
        [ -e "${UPDATE_CANCEL}" ] && [ -z "${CANCELLED}" ] && cancel
        # pacman stops at SIGINT; one that does not is ended after 10 ticks.
        if [ -n "${CANCELLED}" ]; then
            waited=$((waited + 1))
            [ "${waited}" -ge 10 ] && kill -TERM "${PID}" 2>/dev/null
        fi
    done
    wait "${PID}"
    rc=$?
    PID=""
    cat "${WORK}/download" >>"${UPDATE_LOG}" 2>/dev/null
    [ -z "${CANCELLED}" ] && [ "${rc}" -eq 0 ]
}

# New complete lines of pacman's output: package starts and hook steps.
install_lines() {
    local lines line package
    lines=$(wc -l <"${WORK}/install")
    [ "${lines}" -gt "${SEEN}" ] || return 0
    while IFS= read -r line; do
        case "${line}" in
            "upgrading "*...|"installing "*...|"reinstalling "*...|"downgrading "*...)
                CHANGED=true
                package="${line#* }"
                package="${package%...}"
                CURRENT=$((CURRENT + 1))
                [ "${CURRENT}" -gt "${COUNT}" ] && CURRENT=${COUNT}
                emit "\"phase\":\"install\",\"package\":$(json "${package}"),\"current\":${CURRENT},\"count\":${COUNT},\"percent\":$((CURRENT * 100 / COUNT))"
                ;;
            ":: Running post-transaction hooks"*)
                HOOKS=1
                emit "\"phase\":\"hooks\",\"message\":\"\""
                ;;
            "("*") "*)
                [ -n "${HOOKS}" ] && emit "\"phase\":\"hooks\",\"message\":$(json "${line}")"
                ;;
        esac
    done < <(sed -n "$((SEEN + 1)),${lines}p" "${WORK}/install")
    SEEN=${lines}
}

# Installed: the cache lives on the storage partition and nothing else
# empties it, so every update's packages stayed for good. Only after a
# successful install; an interrupted download stays and the next run
# resumes it.
drop_cache() {
    find -H "${PACMAN_CACHE}" -maxdepth 1 -type f -name '*.pkg.tar*' -delete 2>/dev/null
    return 0
}

run_install() {
    local rc line
    # Past this point nothing stops pacman: not this script's signals, not
    # pacman's (ignored dispositions survive exec), not a closed reader.
    trap '' TERM HUP INT
    (trap '' TERM HUP INT; LC_ALL=C exec pacman -Su --noconfirm --noprogressbar --color never "${PACMAN_ARGS[@]}") \
        >"${WORK}/install" 2>&1 </dev/null &
    PID=$!
    # No sleep, power off or power/suspend key while pacman runs. A holder
    # process keeps the inhibitor: pacman is not systemd-inhibit's child,
    # whose signals it would reset. It ends with this script at the latest.
    local holder=""
    if command -v systemd-inhibit >/dev/null 2>&1; then
        systemd-inhibit --what=sleep:shutdown:handle-power-key:handle-suspend-key \
            --mode=block --who=archr-update --why="System update in progress" \
            tail --pid="${PID}" -f /dev/null >/dev/null 2>&1 9>&- &
        holder=$!
    fi
    SEEN=0
    CURRENT=0
    while kill -0 "${PID}" 2>/dev/null; do
        install_lines
        sleep 0.5
    done
    wait "${PID}"
    rc=$?
    [ -n "${holder}" ] && kill "${holder}" 2>/dev/null
    install_lines
    cat "${WORK}/install" >>"${UPDATE_LOG}" 2>/dev/null
    [ "${rc}" -eq 0 ] && return 0
    line="$(last_error "${WORK}/install")"
    case "${line}" in
        *"too full"*|*"not enough free disk space"*)
            fail space "Not enough free space to install." "${line}" ;;
        *"failed retrieving file"*)
            [ -n "${OFFLINE}" ] && fail offline-incomplete "${INCOMPLETE_MESSAGE}" "${line}" ;;
    esac
    fail install "Install failed." "${line}"
}

cmd_update_progress() {
    local low targets old space cached reason
    take_lock
    # Only the lock's holder rewrites the file a frontend follows.
    rm -f "${UPDATE_CANCEL}"
    : >"${UPDATE_PROGRESS}" && FOLLOWED=1
    emit '"phase":"sync"'
    network_ok || fail network "Network connection unavailable."
    low="$(battery_low)" &&
        fail battery "Battery at ${low}%; connect the charger (needs ${MIN_BATTERY}%)."
    old="$(os_version)"
    sync_repo
    targets="$(list_targets)" ||
        fail sync "Cannot list the upgrade." "$(last_error "${WORK}/targets")"
    fetch_notes
    if [ -z "${targets}" ]; then
        logf "update: nothing to do on ${BRANCH}"
        emit "\"phase\":\"done\",\"count\":0,$(reboot_fields ""),\"old_version\":$(json "${old}"),\"new_version\":$(json "${old}")"
        return 0
    fi
    COUNT=$(wc -l <<<"${targets}")
    TOTAL=$(awk '{ sum += $4 } END { printf "%d", sum }' <<<"${targets}")
    awk '{ print $5, $4, $1 }' <<<"${targets}" >"${WORK}/files"
    reason="$(reboot_reason <<<"${targets}")"
    logf "update: ${COUNT} package(s), ${TOTAL} bytes on ${BRANCH}"
    mkdir -p "${PACMAN_CACHE}"
    space=$(df -Pk "${PACMAN_CACHE}" 2>/dev/null | awk 'NR == 2 { print $4 }')
    cached="$(cached_bytes)"
    if [ -n "${space}" ] && [ $((space * 1024)) -lt $((TOTAL - ${cached%% *} + SPACE_MARGIN)) ]; then
        fail space "Not enough free space to download $((TOTAL / 1048576)) MiB."
    fi
    run_download
    low="$(battery_low)" &&
        fail battery "Battery at ${low}%; connect the charger (needs ${MIN_BATTERY}%)."
    run_install
    drop_cache
    if [ -n "${NEW_VERSION}" ]; then
        mkdir -p "${UPDATE_STATE}" && echo "${NEW_VERSION}" >"${UPDATE_STATE}/version"
        is_update_id "${NEW_VERSION}" && record_update_id "${NEW_VERSION}"
    fi
    logf "update: done"
    emit "\"phase\":\"done\",\"count\":${COUNT},$(reboot_fields "${reason}"),\"old_version\":$(json "${old}"),\"new_version\":$(json "$(os_version)")"
}

### Update without network: a bundle on the card

INCOMPLETE_MESSAGE="This update file lacks packages this console needs: the console is older than every image the file supports. Reflash the latest image."
# The names a bundle holds, all top-level.
BUNDLE_ENTRY='^(archr-update\.txt|archr\.db|archr\.db\.sig|changelog\.txt|[A-Za-z0-9@._+:-]+\.pkg\.tar\.zst)$'

# An update id: the date, then an optional .N (20261113, 20261113.4).
is_update_id() {
    [[ $1 =~ ^[0-9]{8}(\.[0-9]+)?$ ]]
}

record_update_id() {
    mkdir -p "${UPDATE_STATE}" && echo "$1" >"${UPDATE_STATE}/update-id"
}

# The id of the last update this console installed, or nothing.
installed_update_id() {
    local id
    for id in "$(cat "${UPDATE_STATE}/update-id" 2>/dev/null)" \
              "$(cat "${UPDATE_STATE}/version" 2>/dev/null)"; do
        is_update_id "${id}" && { echo "${id}"; return 0; }
    done
}

# id_newer A B: A is a newer update id than B; any id is newer than none.
id_newer() {
    [ -z "$2" ] && return 0
    [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$1" ]
}

# read_manifest TAR: B_ID and B_CHANNEL from its archr-update.txt, without
# extracting anything else. Fails on an unreadable tar or manifest.
read_manifest() {
    local text
    B_ID=""
    B_CHANNEL=""
    text="$(tar -xOf "$1" archr-update.txt 2>/dev/null | head -c 4096 | tr -d '\r')" || return 1
    B_ID="$(printf '%s\n' "${text}" | sed -n 's/^id=//p' | head -n 1)"
    B_CHANNEL="$(printf '%s\n' "${text}" | sed -n 's/^channel=//p' | head -n 1)"
    is_update_id "${B_ID}" && [[ ${B_CHANNEL} =~ ^[a-z]+$ ]]
}

# changelog_json TAR CURRENT: the "- " lines of the bundle's changelog.txt
# above the first id not newer than CURRENT (the first id's only when
# CURRENT is empty), as a JSON array.
changelog_json() {
    local line items="" n=0 seen=""
    while IFS= read -r line; do
        line="${line%$'\r'}"
        if is_update_id "${line}"; then
            if [ -n "$2" ]; then
                id_newer "${line}" "$2" || break
            else
                [ -n "${seen}" ] && break
                seen=1
            fi
            continue
        fi
        case "${line}" in
            "- "*)
                items="${items:+${items},}$(json "${line}")"
                n=$((n + 1))
                [ "${n}" -ge 100 ] && break
                ;;
        esac
    done < <(tar -xOf "$1" changelog.txt 2>/dev/null | head -c 65536)
    printf '[%s]' "${items}"
}

cmd_offline() {
    local tar best="" best_id="" best_channel="" best_own="" own current newer=false
    # The folder shows on the card once looked for, for the player to find.
    mkdir -p "${ARCHR_UPDATE_OFFLINE_DIR}" 2>/dev/null
    for tar in "${ARCHR_UPDATE_OFFLINE_DIR}"/archr-update*.tar; do
        [ -f "${tar}" ] && read_manifest "${tar}" || continue
        own=""
        [ "${B_CHANNEL}" = "${BRANCH}" ] && own=1
        # One for this console's channel first, then the newest id.
        if [ -z "${best}" ] || { [ -n "${own}" ] && [ -z "${best_own}" ]; } ||
           { [ "${own}" = "${best_own}" ] && id_newer "${B_ID}" "${best_id}"; }; then
            best="${tar}"
            best_id="${B_ID}"
            best_channel="${B_CHANNEL}"
            best_own="${own}"
        fi
    done
    if [ -z "${best}" ]; then
        if [ "$1" = --json ]; then
            echo '{"found":false}'
        else
            echo "No update file in ${ARCHR_UPDATE_OFFLINE_DIR}."
        fi
        return 0
    fi
    current="$(installed_update_id)"
    id_newer "${best_id}" "${current}" && newer=true
    if [ "$1" = --json ]; then
        printf '{"found":true,"file":%s,"id":%s,"channel":%s,"newer":%s,"current":%s,"changelog":%s}\n' \
            "$(json "${best}")" "$(json "${best_id}")" "$(json "${best_channel}")" "${newer}" \
            "$(json "${current}")" "$(changelog_json "${best}" "${current}")"
    elif [ -z "${best_own}" ]; then
        echo "${best} (update ${best_id}) is for the ${best_channel} channel; this console is on ${BRANCH}."
    elif [ "${newer}" = true ]; then
        echo "${best} brings update ${best_id} (installed: ${current:-none}). Install it with: ${0##*/} update --from ${best}"
    else
        echo "${best} (update ${best_id}) is not newer than the installed update ${current}."
    fi
    return 0
}

# Only regular files, all top-level, with a bundle's names and its four
# fixed files.
bundle_listing_ok() {
    local kind name fixed=0
    tar -tvf "$1" >"${WORK}/listing" 2>/dev/null || return 1
    while read -r kind name; do
        [ "${kind}" = - ] && [[ ${name} =~ ${BUNDLE_ENTRY} ]] || return 1
        case "${name}" in
            archr-update.txt|archr.db|archr.db.sig|changelog.txt) fixed=$((fixed + 1)) ;;
        esac
    done < <(awk '{ print substr($1, 1, 1), $NF }' "${WORK}/listing")
    [ "${fixed}" -eq 4 ]
}

# Unpacks the bundle into OFFLINE_WORK with extract lines; SIGTERM or the
# cancel file stops it (tar is ended at once: nothing to keep).
run_extract() {
    local rc bytes percent
    # 9>&-: the lock stays with this script, not with a tar ended later.
    tar -x -o -f "$1" -C "${OFFLINE_WORK}" >"${WORK}/extract" 2>&1 </dev/null 9>&- &
    PID=$!
    while kill -0 "${PID}" 2>/dev/null; do
        bytes=$(($(du -sk "${OFFLINE_WORK}" 2>/dev/null | awk '{ print $1 + 0 }') * 1024))
        percent=$((bytes * 100 / TOTAL))
        [ "${percent}" -gt 99 ] && percent=99
        emit "\"phase\":\"extract\",\"bytes\":${bytes},\"total\":${TOTAL},\"percent\":${percent}"
        sleep "${TICK}"
        [ -e "${UPDATE_CANCEL}" ] && CANCELLED=1
        [ -n "${CANCELLED}" ] && kill -TERM "${PID}" 2>/dev/null
    done
    wait "${PID}"
    rc=$?
    PID=""
    cat "${WORK}/extract" >>"${UPDATE_LOG}" 2>/dev/null
    [ -n "${CANCELLED}" ] && fail cancelled "Update cancelled."
    [ "${rc}" -eq 0 ] ||
        fail offline-invalid "The update file is damaged; copy it again." "$(last_error "${WORK}/extract")"
    emit "\"phase\":\"extract\",\"bytes\":${TOTAL},\"total\":${TOTAL},\"percent\":100"
}

# pacman.conf for the bundle: the real one, with the [archr] repo served
# from the work dir and the cache there too (packages are not copied
# again). Everything else, SigLevel included, stays as it is.
offline_conf() {
    awk -v work="${OFFLINE_WORK}" '
        /^[[:space:]]*\[/ {
            section = $0
            gsub(/[][[:space:]]/, "", section)
            print
            if (section == "options") print "CacheDir = " work "/"
            if (section == "archr") { print "Server = file://" work; found = 1 }
            next
        }
        section == "options" && /^[[:space:]]*CacheDir[[:space:]]*=/ { next }
        section == "archr" && /^[[:space:]]*(Server|Include)[[:space:]]*=/ { next }
        { print }
        END { exit !found }' "${PACMAN_CONF}" >"${WORK}/pacman.conf"
}

cmd_update_offline() {
    local tar=$1 low old current space targets reason name file missing=""
    take_lock
    # Only the lock's holder owns the work dir and the followed file.
    OFFLINE=1
    rm -f "${UPDATE_CANCEL}"
    : >"${UPDATE_PROGRESS}" && FOLLOWED=1
    TOTAL=$(stat -c %s "${tar}" 2>/dev/null)
    case "${TOTAL}" in
        ""|*[!0-9]*) TOTAL=0 ;;
    esac
    emit "\"phase\":\"extract\",\"bytes\":0,\"total\":${TOTAL},\"percent\":0"
    { [ "${TOTAL}" -gt 0 ] && read_manifest "${tar}" && bundle_listing_ok "${tar}"; } ||
        fail offline-invalid "This is not a readable Arch R update file; copy it again."
    [ "${B_CHANNEL}" = "${BRANCH}" ] ||
        fail offline-invalid "This update file is for the ${B_CHANNEL} channel; this console is on ${BRANCH}."
    current="$(installed_update_id)"
    id_newer "${B_ID}" "${current}" ||
        fail offline-old "This update file (${B_ID}) is not newer than the installed update (${current})."
    low="$(battery_low)" &&
        fail battery "Battery at ${low}%; connect the charger (needs ${MIN_BATTERY}%)."
    old="$(os_version)"
    logf "update: from ${tar} (${B_ID}, ${TOTAL} bytes)"
    rm -rf "${OFFLINE_WORK}"
    mkdir -p "${OFFLINE_WORK%/*}"
    space=$(df -Pk "${OFFLINE_WORK%/*}" 2>/dev/null | awk 'NR == 2 { print $4 }')
    if [ -n "${space}" ] && [ $((space * 1024)) -lt $((TOTAL + SPACE_MARGIN)) ]; then
        fail space "Not enough free space to unpack the update ($((TOTAL / 1048576)) MiB)."
    fi
    mkdir -p "${OFFLINE_WORK}" || fail install "Cannot create ${OFFLINE_WORK}."
    run_extract "${tar}"
    offline_conf || fail sync "No [archr] repository in ${PACMAN_CONF}."
    PACMAN_ARGS=(--config "${WORK}/pacman.conf")
    seed_local_db >>"${UPDATE_LOG}" 2>&1 ||
        fail seed "No package database for this image; reflash to update."
    emit '"phase":"sync"'
    # -yy: the bundle's db replaces the synced one whatever their dates.
    logged "${WORK}/sync" pacman -Syy --noconfirm --color never "${PACMAN_ARGS[@]}" ||
        fail offline-invalid "The update file was refused: its package database is damaged or not signed by Arch R." \
            "$(last_error "${WORK}/sync")"
    targets="$(list_targets)" ||
        fail sync "Cannot list the upgrade." "$(last_error "${WORK}/targets")"
    while read -r name _ _ _ file; do
        [ -n "${name}" ] && [ ! -f "${OFFLINE_WORK}/${file}" ] && missing="${missing} ${name}"
    done <<<"${targets}"
    [ -n "${missing}" ] && fail offline-incomplete "${INCOMPLETE_MESSAGE}" "missing:${missing}"
    NEW_VERSION="$(sed -n '1s/^[[:space:]]*\([^[:space:]]*\)[[:space:]]*$/\1/p' "${OFFLINE_WORK}/changelog.txt")"
    case "${NEW_VERSION}" in
        *[!0-9A-Za-z._-]*) NEW_VERSION="" ;;
    esac
    COUNT=0
    reason=""
    if [ -n "${targets}" ]; then
        COUNT=$(wc -l <<<"${targets}")
        reason="$(reboot_reason <<<"${targets}")"
        logf "update: ${COUNT} package(s) from ${tar}"
        low="$(battery_low)" &&
            fail battery "Battery at ${low}%; connect the charger (needs ${MIN_BATTERY}%)."
        run_install
    else
        logf "update: nothing to do from ${tar}"
    fi
    if [ -n "${NEW_VERSION}" ]; then
        mkdir -p "${UPDATE_STATE}" && echo "${NEW_VERSION}" >"${UPDATE_STATE}/version"
    fi
    record_update_id "${B_ID}"
    rm -f "${tar}"
    logf "update: done (${B_ID})"
    emit "\"phase\":\"done\",\"count\":${COUNT},$(reboot_fields "${reason}"),\"old_version\":$(json "${old}"),\"new_version\":$(json "$(os_version)")"
}

### Human CLI

cmd_check() {
    take_lock
    write_mirrorlist
    seed_local_db || return 1
    pacman -Sy --noconfirm >/dev/null 2>&1 || {
        echo "Failed to sync repo metadata. Check network."
        return 1
    }
    pending=$(pacman -Qu | wc -l)
    if [ "${pending}" -eq 0 ]; then
        echo "No updates available."
        return 1
    fi
    echo "Updates available: ${pending} package(s)."
    pacman -Qu
}

cmd_update() {
    take_lock
    write_mirrorlist
    seed_local_db || return 1
    pacman -Syu --noconfirm && drop_cache
}

cmd_info() {
    echo "OS:         ${OS_NAME:-ArchR} ${OS_VERSION:-?}"
    echo "Build:      ${OS_BUILD:-?}"
    echo "Channel:    ${BRANCH}"
    echo "Mirror:     ${REPO}/repo-${BRANCH}"
    echo "Pacman:     $(pacman --version | head -1 | awk '{print $3}')"
}

# Seeding needs no network (004-seed-pacmandb runs it at boot).
if [ "${1:-}" = seed ]; then
    seed_local_db
    exit $?
fi
if [ "${1:-}" = version ]; then
    os_version
    exit 0
fi

# Reads the card only: no lock, no network.
if [ "${1:-}" = offline ]; then
    cmd_offline "${2:-}"
    exit 0
fi

MODE=plain
CHANGED=false
FROM=""
ARGV="$*"
case "${1:-update} ${2:-}" in
    "check --json") MODE=json ;;
    "update --progress") MODE=progress ;;
esac
# update --from TAR [--progress], in any order: always progress lines.
if [ "${1:-}" = update ] && [[ " $* " == *" --from "* ]]; then
    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            --from) FROM="${2:-}"; [ $# -ge 2 ] && shift; shift ;;
            --progress) shift ;;
            *) usage; exit 2 ;;
        esac
    done
    [ -n "${FROM}" ] || { usage; exit 2; }
    MODE=progress
fi
if [ "${MODE}" != plain ]; then
    # A reader that goes away must not kill the run: writes just fail.
    trap '' PIPE
    mkdir -p "${UPDATE_LOG%/*}" 2>/dev/null
    WORK="$(mktemp -d)" || exit 1
    trap 'rm -rf "${WORK}"; if [ -n "${OFFLINE}" ] && [ -n "${OFFLINE_WORK}" ]; then rm -rf "${OFFLINE_WORK}"; fi; if [ -n "${FOLLOWED}" ]; then rm -f "${UPDATE_CANCEL}"; fi' EXIT
    logf "archr-update ${ARGV} (channel ${BRANCH})"
    if [ "${MODE}" = json ]; then
        cmd_check_json
    elif [ -n "${FROM}" ]; then
        trap cancel TERM
        cmd_update_offline "${FROM}"
    else
        trap cancel TERM
        cmd_update_progress
    fi
    exit $?
fi

if ! network_ok; then
    echo "Network connection unavailable."
    exit 1
fi

case "${1:-update}" in
    check)  cmd_check ;;
    update) cmd_update ;;
    info)   cmd_info ;;
    -h|--help|help) usage ;;
    *)      usage; exit 2 ;;
esac
