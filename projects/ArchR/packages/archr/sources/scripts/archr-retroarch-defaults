# Runs once per installation (001-setup, every boot until done). Older
# defaults put integer scale, aspect ratio, bezel, rewind, run-ahead and
# savestate numbering in system.cfg for everyone, and setsettings.sh then
# imposed them on RetroArch at every game. Remove each of those keys only
# while it still holds the old factory value, so what the user chose in
# the launcher stays; RetroArch's own settings take over for the rest.

# shellcheck source=/dev/null
. "${SETSETTINGS_PROFILE:-/etc/profile}"

DONE="migration.retroarch_defaults"
[ -z "$(get_setting "${DONE}")" ] || exit 0
[ -f "${J_CONF}" ] || exit 0

