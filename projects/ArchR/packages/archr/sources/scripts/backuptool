#!/bin/bash

# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2020-present Shanti Gilbert (https://github.com/shantigilbert)
# Copyright (C) 2023 JELOS (https://github.com/JustEnoughLinuxOS)

# shellcheck source=/dev/null
. /etc/profile

# NOTE: to customize your backups, create a backuptool.conf file in
# /storage/.config like this:

# LOCATIONS=(
#   /storage/.config/retroarch/*
#   /storage/roms/savestates/*
#   /storage/some/other/folder/file.name*
# )
# Only files under /storage are backed up, since only those can be restored.

usage() {
    echo "Usage: ${0} {backup|restore} [--with-wifi]"
    echo "  --with-wifi  Include saved Wi-Fi settings and iwd profiles (backup/restore)."
    echo "               Backups are unencrypted and stored on the ROMs share."
}

if [ "$#" -gt 2 ] || { [ -n "${2}" ] && [ "${2}" != "--with-wifi" ]; }
then
    usage >&2
    exit 1
fi

set -o pipefail
STORAGE="/storage"
BACKUPFOLDER="/storage/roms/backup"
BACKUPFILE="${BACKUPFOLDER}/${OS_NAME}_BACKUP.zip"
mkdir -p "${BACKUPFOLDER}" || exit 1

# Real paths, not the /storage/.emulationstation symlink: that link only
# exists while EmulationStation is installed. WiFi is iwd, whose saved
# networks (/var/lib/iwd) live in /storage/.cache/iwd; Bluetooth pairings
# (/var/lib/bluetooth) live in /storage/.cache/bluetooth.
ES_DIR="/storage/.config/emulationstation"

# Restore overwrites these with the backup's copy.
CONFIG_LOCATIONS=(
    /storage/.config/fancontrol.conf
    /storage/.config/backuptool.conf
    /storage/.cache/bluetooth/*
    /storage/.config/system/configs/system.cfg
    /storage/.config/ppsspp/*
    /storage/.config/retroarch/*
    /storage/.config/moonlight/*
    /storage/.config/game/*
    /storage/.config/archr-launcher/*
    "${ES_DIR}"/es_*.cfg
    "${ES_DIR}"/scripts/*
    "${ES_DIR}"/themesettings/*
)
# Restore never replaces a newer copy of these; everything under
# /storage/roms counts as a save too. Save-only trees: no emulator binaries,
# ROMs or BIOS images. Saves kept in system images are named one by one.
SAVE_LOCATIONS=(
    /storage/roms/savestates
    /storage/roms/openbor/Saves
    /storage/roms/pico-8/cdata
    /storage/.lexaloffle/pico-8/cdata
    /storage/.local/share/pico-8/cdata
    /storage/.local/share/scummvm/saves
    /storage/.config/scummvm/saves
    /storage/.config/drastic/backup
    /storage/.config/drastic/savestates
    /storage/.config/duckstation/memcards
    /storage/.config/duckstation/savestates
    /storage/.config/flycast/data
    /storage/.config/amiberry/savestates
    /storage/.config/amiberry/nvram
    /storage/.config/amiberry/whdboot/save-data
    /storage/.config/hatari/auto.sav
    /storage/.config/hatari/hatari.sav
    /storage/.config/vice/*.vsf
    /storage/.vice/*.vsf
    /storage/.config/touchHLE/touchHLE_sandbox
    /storage/.config/ppsspp/PSP/SAVEDATA
    /storage/.config/ppsspp/PSP/PPSSPP_STATE
    /storage/.config/retroarch/saves
    /storage/.config/retroarch/states
    /storage/.config/game/configs/hypseus/ram
    /storage/.config/dolphin-emu/Wii/title/00010000
    # DSiWare saves live inside melonDS's DSi NAND image.
    /storage/roms/bios/dsi_nand.bin
    /storage/roms/bios/yabasanshiro/backup.bin
    /storage/roms/bios/dc/dc_flash.bin
    /storage/roms/bios/dc/dc_nvmem.bin
    /storage/roms/bios/GC/MemoryCard[AB].*.raw
)
DEFAULT=("${CONFIG_LOCATIONS[@]}" "${SAVE_LOCATIONS[@]}")
while IFS= read -r -d '' THEME
do
    DEFAULT+=("${THEME}")
done < <(find "${ES_DIR}/themes" -mindepth 1 -maxdepth 1 -type d -not -name es-theme-art-book-next -not -name system-theme -print0 2>/dev/null)

USE_DEFAULT=true
if [ -e "/storage/.config/backuptool.conf" ]
then
    # shellcheck source=/dev/null
    if ! source /storage/.config/backuptool.conf
    then
        WARN="Error loading custom backuptool configs. Using defaults."
        ${DEBUG} && echo "${WARN}"
        logger -t backuptool "${WARN}"
        COMPRESSLOCATIONS=("${DEFAULT[@]}")
    else
        COMPRESSLOCATIONS=("${LOCATIONS[@]}")
        USE_DEFAULT=false
    fi
else
    COMPRESSLOCATIONS=("${DEFAULT[@]}")
fi

# Also exclude profiles when a custom location contains their parent directory.
EXCLUDES=('storage/.cache/iwd' 'storage/.cache/iwd/*')
if [ "${2}" = "--with-wifi" ]
then
    COMPRESSLOCATIONS+=(/storage/.cache/iwd/*)
    EXCLUDES=()
fi
PRUNE=(-path "${BACKUPFOLDER}" -o -path "${BACKUPFOLDER}/*")
if [ "${2}" != "--with-wifi" ]; then
    PRUNE+=(-o -path '/storage/.cache/iwd' -o -path '/storage/.cache/iwd/*')
fi
# Never restore an embedded backup over the archive being read, either.
EXCLUDES+=('storage/roms/backup' 'storage/roms/backup/*')
# System-managed symlinks are recreated by the OS: restore skips them and
# everything below them instead of writing through them.
declare -A LINKS=()
while IFS= read -r -d '' LINK
do
    LINKS["${LINK#/}"]=1
done < <(find "${COMPRESSLOCATIONS[@]}" -type l -print0 2>/dev/null)

# Archives from before the FHS bridges hold these paths through their links.
ALIASES=('var/lib/bluetooth/' 'storage/.cache/bluetooth/'
         'var/lib/iwd/' 'storage/.cache/iwd/')
# "sha256 mtime path" of every archived file, checked at backup and before
# any restore. The mtime is the file's own at backup time.
MANIFEST="${STORAGE#/}/.cache/backuptool.manifest"
declare -A MTIMES=()
SYSTEM_CFG="storage/.config/system/configs/system.cfg"
STAMP=$(date +%Y-%m-%d_%H-%M-%S) || exit 1

# One backup or restore at a time. The lock lives on ext4, not the possibly
# exFAT ROMs card, and is released by the kernel even after a crash.
take_lock() {
    local error
    if ! { mkdir -p /storage/.cache && exec 9>/storage/.cache/backuptool.lock; }
    then
        echo 'Error: cannot open the backup lock.' >&2
        exit 1
    fi
    # flock -n fails silently when another holder has the lock.
    if ! error=$(flock -n 9 2>&1); then
        if [ -z "${error}" ]; then
            echo 'A backup or restore is already running.' >&2
        else
            echo "Error: cannot take the backup lock: ${error}" >&2
        fi
        exit 1
    fi
}

# Emit regular files only. No traversal through system-managed symlinks and no
# recursion into the output directory, even with LOCATIONS=(/storage/roms).
collect_tree() {
    local location
    for location in "$@"; do
        [ -e "${location}" ] && [ ! -L "${location}" ] || continue
        find "${location}" \
            \( "${PRUNE[@]}" \) -prune -o \
            -type f -print0 || return 1
    done
}

collect_rom_saves() {
    [ -d /storage/roms ] || return 0
    # Do not use *.st*: .st and .stx are Atari ST disk images, not N64 states.
    # Large arbitrary trees (ROMs, ports, BIOS) are never added wholesale.
    find /storage/roms -path "${BACKUPFOLDER}" -prune -o -type f \( \
        -iname '*.srm' -o -iname '*.rtc' -o -iname '*.sav' -o -iname '*.dsv' -o \
        -iname '*.eep' -o -iname '*.sra' -o -iname '*.fla' -o -iname '*.mpk' -o \
        -iname '*.mcd' -o -iname '*.mcr' -o -iname '*.bkr' -o -iname '*.bcr' -o \
        -iname '*.flash' -o -iname '*.smpc' -o -iname '*.seep' -o -iname '*.fxb' -o \
        -iname '*.mg[0-9]' -o -iname '*.mednafen.fds' -o -iname '*.mednafen.type' -o \
        -iname '*.fs' -o -iname '*.hi' -o -iname '*.memcard' -o -iname '*.nvram' -o \
        -iname '*.brm' -o -iname '*.bup' -o -iname '*.sram' -o -iname '*.nv' -o \
        -iname '*.nvmem' -o -iname '*.eeprom' -o -iname 'vmu_save*.bin' -o \
        -iname '*.vmu' -o -iname '*.vms' -o -iname '*.vmi' -o -iname '*.p8d' -o \
        -iname '*.ram' -o -iname '*.zds' -o -iname '*.vsf' -o -iname '*.uss' -o \
        -iname '*.gci' -o \
        -iname '*.st[0-9]*' -o -iname '*.state' -o -iname '*.state[0-9]*' -o \
        -iname '*.state.auto*' -o -iname '*.sav.[0-9]*' -o -iname '*.mcr.[0-9]*' \
    \) -print0 || return 1
    # PPSSPP's patched SAVEDATA path is roms/psp/<game ID>, not PSP/SAVEDATA.
    # Save containers may hold .BIN, .SFO, images and game-specific filenames.
    local directory
    for directory in /storage/roms/psp/[A-Za-z][A-Za-z][A-Za-z][A-Za-z][0-9][0-9][0-9][0-9][0-9]*; do
        # An ID-named ROM folder is not necessarily a save. PPSSPP saves have
        # PARAM.SFO at the root; an extracted disc has it under PSP_GAME.
        [ -f "${directory}/PARAM.SFO" ] || continue
        collect_tree "${directory}" || return 1
    done
    collect_tree /storage/roms/psp/SAVEDATA /storage/roms/psp/PSP/SAVEDATA \
        /storage/roms/psp/PPSSPP_STATE /storage/roms/psp/PSP/PPSSPP_STATE
}

# Keep only what restore accepts: plain names under /storage, reached without
# symlinks. NUL list in $1, newline list out (no name holds a newline).
select_files() {
    local files real index
    mapfile -d '' -t files <"$1" || return 1
    [ "${#files[@]}" -gt 0 ] || return 0
    mapfile -d '' -t real < <(printf '%s\0' "${files[@]}" | xargs -0 realpath -m -z --) || return 1
    [ "${#real[@]}" -eq "${#files[@]}" ] || return 1
    for index in "${!files[@]}"; do
        if [[ "${files[index]}" != "${STORAGE}/"* || "${real[index]}" != "${files[index]}" ||
              "${files[index]}" == *[[:cntrl:]\\]* ]]; then
            echo "Skipped (outside /storage, behind a symlink or oddly named): ${files[index]}" >&2
            continue
        fi
        printf '%s\n' "${files[index]}"
    done
}

# Names as BusyBox unzip prints them: every byte outside printable ASCII
# becomes "?". Applied to any list, it makes Info-ZIP's output comparable.
printable() {
    LC_ALL=C sed 's/[^ -~]/?/g'
}

# Members of ZIP $1 from unzip -v, which BusyBox and Info-ZIP print alike:
# printable names into $2, "decimal-CRC name" into $2.crc, and the total
# uncompressed size in LISTED_BYTES. A newline in a name breaks the count;
# the exact names come from the extraction and the manifest. BusyBox strips
# "/" and ".." prefixes from what it lists and only warns on stderr, so any
# warning refuses the archive.
list_members() {
    local listing total size crc name
    listing=$(unzip -v "$1" 2>"$2.err") || return 1
    if [ -s "$2.err" ]; then
        echo "Refusing backup: unsafe member name; unzip says: $(cat "$2.err")" >&2
        return 1
    fi
    LISTED_BYTES=0
    : >"$2" && : >"$2.crc" || return 1
    while read -r size crc name; do
        LISTED_BYTES=$((LISTED_BYTES + size))
        printf '%s\n' "${name}" >>"$2"
        printf '%s %s\n' "$((16#${crc}))" "${name}" >>"$2.crc"
    done < <(printf '%s\n' "${listing}" | printable | sed -nE \
        's/^ *([0-9]+) +[^ ]+ +[0-9]+ +-?[0-9]+% +[0-9-]{10} +[0-9:]{5} +([0-9a-f]{8})  (.*)$/\1 \2 \3/p')
    total=$(printf '%s\n' "${listing}" | sed -nE '$s/^ *[0-9]+ +[0-9]+ +-?[0-9]+% +([0-9]+) files?$/\1/p')
    [ -n "${total}" ] && [ "${total}" -eq "$(wc -l <"$2")" ]
}

# The /storage-relative path a member restores to, in REL.
map_member() {
    local index path="$1/"
    REL="$1"
    for ((index = 0; index < ${#ALIASES[@]}; index += 2)); do
        case "${path}" in
            "${ALIASES[index]}"*)
                REL="${ALIASES[index + 1]}${path#"${ALIASES[index]}"}"
                REL="${REL%/}" ;;
        esac
    done
}

# Refuse the whole archive unless every member is a plain relative path
# under storage/: no absolute names, no "." or ".." components, no empty
# components, no backslashes, and no file that another member would treat
# as its directory (a symlink entry). Duplicates and control characters are
# caught after extraction.
check_members() {
    local name rel part parts path
    local -A files=()
    while IFS= read -r name; do
        rel="${name%/}"
        if [ -z "${rel}" ] || [[ "${rel}" == /* || "${rel}" == */ || "${rel}" == *\\* ]]; then
            echo "Refusing backup: unsafe member name '${name}'." >&2
            return 1
        fi
        IFS=/ read -r -a parts <<<"${rel}"
        for part in "${parts[@]}"; do
            case "${part}" in
                '' | . | ..)
                    echo "Refusing backup: unsafe member name '${name}'." >&2
                    return 1 ;;
            esac
        done
        map_member "${rel}"
        if [[ "${REL}/" != "${STORAGE#/}/"?* && ! ( "${name}" == */ &&
              "${STORAGE#/}/" == "${REL}/"* ) ]]; then
            echo "Refusing backup: '${name}' is outside ${STORAGE}." >&2
            return 1
        fi
        [[ "${name}" == */ ]] || files["${rel}"]=1
    done <"$1"
    while IFS= read -r name; do
        path="${name%/}"
        while [[ "${path}" == */* ]]; do
            path="${path%/*}"
            if [ -n "${files[${path}]}" ]; then
                echo "Refusing backup: '${name}' would be written through '${path}'." >&2
                return 1
            fi
        done
    done <"$1"
}

# Check ZIP $1 completely before anyone trusts it: safe member names, room
# to extract, an extraction into the empty directory $2/root holding exactly
# those members as regular files, their real CRC32 (BusyBox unzip skips it
# for STORED entries), and, when present (or required by $3), the manifest:
# sha256 and modification time of every file when it was backed up.
# Sets VERIFIED (contents proven by sha256 or CRC) and MTIMES.
verify_archive() {
    local zip="$1" dir="$2" available mtime name
    VERIFIED=false
    MTIMES=()
    mkdir -p "${dir}/root" || return 1
    if ! list_members "${zip}" "${dir}/members"; then
        echo "Refusing backup: cannot list ${zip}." >&2
        return 1
    fi
    check_members "${dir}/members" || return 1
    available=$(df -Pk "${dir}" | awk 'END {print $4}')
    if ! [[ "${available}" =~ ^[0-9]+$ ]] || \
       [ "${available}" -lt $((LISTED_BYTES / 1024 + 1024)) ]; then
        echo "Not enough free space to unpack the backup: $((LISTED_BYTES / 1024 + 1024)) KiB needed." >&2
        return 1
    fi
    if ! unzip -q -o "${zip}" -d "${dir}/root" >"${dir}/unzip.log" 2>&1; then
        cat "${dir}/unzip.log" >&2
        echo "Refusing backup: ${zip} does not extract cleanly." >&2
        return 1
    fi
    if [ -n "$(find "${dir}/root" ! -type f ! -type d -print -quit)" ]; then
        echo 'Refusing backup: it holds links or special files.' >&2
        return 1
    fi
    if (cd "${dir}/root" && find . -type f -print0) | LC_ALL=C grep -qz '[[:cntrl:]\\]'; then
        echo 'Refusing backup: a member name holds control characters.' >&2
        return 1
    fi
    (cd "${dir}/root" && find . -type f | sed 's|^\./||' | LC_ALL=C sort) >"${dir}/files" || return 1
    # Exactly the listed members, each once: a duplicate leaves one file.
    if ! grep -v '/$' "${dir}/members" | LC_ALL=C sort | \
         cmp -s - <(printable <"${dir}/files" | LC_ALL=C sort); then
        echo 'Refusing backup: the extracted files differ from its listing.' >&2
        return 1
    fi
    # GNU cksum (coreutils 9.6+) computes the ZIP CRC32; BusyBox has none.
    if cksum -a crc32b </dev/null >/dev/null 2>&1; then
        if ! (cd "${dir}/root" && tr '\n' '\0' <../files | xargs -0 -r cksum -a crc32b --) | \
               sed -E 's/^([0-9]+) [0-9]+ /\1 /' | printable | LC_ALL=C sort | \
               cmp -s - <(grep -v '/$' "${dir}/members.crc" | LC_ALL=C sort); then
            echo 'Refusing backup: CRC mismatch, the backup is corrupt.' >&2
            return 1
        fi
        VERIFIED=true
    fi
    if ! grep -Fqx "${MANIFEST}" "${dir}/files"; then
        if [ -n "$3" ]; then
            echo 'Refusing backup: its manifest is missing.' >&2
            return 1
        fi
        if "${VERIFIED}"; then
            echo 'Note: this backup has no manifest; its contents match the ZIP CRCs.'
        else
            echo 'Note: this backup has no manifest and its CRCs cannot be checked here: files already on the device are kept and the backup copies go beside them.'
        fi
        return 0
    fi
    if grep -vqE '^[0-9a-f]{64} [0-9]+ .' "${dir}/root/${MANIFEST}" || \
       ! cut -d' ' -f3- "${dir}/root/${MANIFEST}" | LC_ALL=C sort | \
         cmp -s - <(grep -Fvx "${MANIFEST}" "${dir}/files"); then
        echo 'Refusing backup: its manifest does not match its files.' >&2
        return 1
    fi
    if ! (cd "${dir}/root" && grep -Fvx "${MANIFEST}" ../files | tr '\n' '\0' | \
            xargs -0 -r sha256sum --) | LC_ALL=C sort | \
         cmp -s - <(sed -E 's/^([0-9a-f]{64}) [0-9]+ /\1  /' "${dir}/root/${MANIFEST}" | LC_ALL=C sort); then
        echo 'Refusing backup: checksum mismatch (corrupt, or a file changed while it was archived).' >&2
        return 1
    fi
    while read -r _ mtime name; do
        MTIMES["${name}"]="${mtime}"
    done <"${dir}/root/${MANIFEST}"
    VERIFIED=true
}

is_excluded() {
    local pattern path
    for pattern in "${EXCLUDES[@]}"; do
        # shellcheck disable=SC2053 # EXCLUDES holds glob patterns.
        [[ "$1" == ${pattern} || "$2" == ${pattern} ]] && return 0
    done
    for path in "$1" "$2"; do
        while :; do
            [ -z "${LINKS[${path}]}" ] || return 0
            [[ "${path}" == */* ]] || break
            path="${path%/*}"
        done
    done
    return 1
}

is_save() {
    local location
    case "$1" in "${STORAGE}/roms/"*) return 0 ;; esac
    for location in "${SAVE_LOCATIONS[@]}"; do
        # shellcheck disable=SC2053 # Locations may be globs, such as *.vsf.
        [[ "$1" == ${location} || "$1" == ${location}/* ]] && return 0
    done
    return 1
}

# Services through which other machines write to /storage stop while a
# restore runs, and start again when it ends.
SERVICES=(smbd nmbd simple-http-server syncthing)
PAUSED=()
pause_services() {
    local service
    command -v systemctl >/dev/null || return 0
    for service in "${SERVICES[@]}"; do
        systemctl is-active --quiet "${service}" 2>/dev/null || continue
        PAUSED+=("${service}")
        systemctl stop "${service}" || { echo "Cannot stop ${service}." >&2; return 1; }
    done
}
resume_services() {
    [ "${#PAUSED[@]}" -eq 0 ] || systemctl start "${PAUSED[@]}"
}

# Enter directory $1 and require it to be exactly that path, reached with
# no symlink. Relative names then resolve inside this directory even if a
# component of its path is swapped later, so writes stay on its filesystem.
enter() {
    cd -P -- "$1" 2>/dev/null && [ "$(pwd -P)" = "$1" ]
}

# Create the missing directories of $1 one level at a time, each inside its
# checked parent. CREATED keeps them for the rollback.
make_dirs() {
    local path="${STORAGE}" part
    local -a parts
    [ "$1" != "${STORAGE}" ] || return 0
    [[ "$1" == "${STORAGE}/"* ]] || return 1
    IFS=/ read -r -a parts <<<"${1#"${STORAGE}"/}"
    for part in "${parts[@]}"; do
        if [ ! -e "${path}/${part}" ] && [ ! -L "${path}/${part}" ]; then
            { enter "${path}" && mkdir -- "${part}"; } || return 1
            CREATED+=("${path}/${part}")
        fi
        path="${path}/${part}"
    done
}

# Each planned file: staged source, final path, backed-up mtime ("" if
# unknown), whether the path is new, and how far the transaction got.
P_SRC=() P_DEST=() P_MTIME=() P_NEW=() P_STATE=() CREATED=()
COMMITTED=false
plan() {
    P_SRC+=("$1") P_DEST+=("$2") P_MTIME+=("$3") P_NEW+=("$4")
}
temp_of() { local base="${P_DEST[$1]##*/}"; echo ".${base}.restore-$$"; }
undo_of() { local base="${P_DEST[$1]##*/}"; echo ".${base}.undo-$$"; }

# Undo every step taken, newest first, from what is on disk: a file moved
# aside comes back, a new file goes, temporaries go.
rollback() {
    local index base temp undo
    for ((index = ${#P_STATE[@]} - 1; index >= 0; index--)); do
        [ -n "${P_STATE[index]}" ] || continue
        base="${P_DEST[index]##*/}" temp=$(temp_of "${index}") undo=$(undo_of "${index}")
        if ! enter "${P_DEST[index]%/*}"; then
            echo "Cannot roll back ${P_DEST[index]}: its folder changed." >&2
            continue
        fi
        if [ -e "${undo}" ]; then
            mv -fT -- "${undo}" "${base}"
        elif [ "${P_STATE[index]}" = committing ] && [ "${P_NEW[index]}" = 1 ] && [ ! -e "${temp}" ]; then
            rm -f -- "${base}"
        fi
        rm -f -- "${temp}"
    done
    for ((index = ${#CREATED[@]} - 1; index >= 0; index--)); do
        rmdir -- "${CREATED[index]}" 2>/dev/null
    done
}

abort() {
    echo "$1" >&2
    echo 'Restore failed; nothing was changed.' >&2
    exit 1
}

# Free space for the files that must be copied to another filesystem; a
# move inside the staging filesystem is only a rename.
check_space() {
    local index dir dev stage_dev available need
    local -A devices=() needs=() places=()
    stage_dev=$(stat -c %d "${STAGE}/root") || return 1
    for index in "${!P_DEST[@]}"; do
        dir="${P_DEST[index]%/*}"
        while [ ! -d "${dir}" ]; do dir="${dir%/*}"; done
        [ -n "${devices[${dir}]}" ] || devices["${dir}"]=$(stat -c %d "${dir}/") || return 1
        dev="${devices[${dir}]}"
        [ "${dev}" != "${stage_dev}" ] || continue
        needs["${dev}"]=$(( ${needs[${dev}]:-0} + $(stat -c %s "${P_SRC[index]}") ))
        places["${dev}"]="${dir}"
    done
    for dev in "${!needs[@]}"; do
        available=$(df -Pk "${places[${dev}]}/" | awk 'END {print $4}')
        need=$(( needs[${dev}] / 1024 + 1024 ))
        if ! [[ "${available}" =~ ^[0-9]+$ ]] || [ "${available}" -lt "${need}" ]; then
            echo "Not enough free space in ${places[${dev}]}: ${need} KiB needed." >&2
            return 1
        fi
    done
}

restore() {
    local member src dest mtime index keep base temp restored=0 kept=0 report
    local -a real=() bad=() notes=() dests=() members=()
    take_lock
    [ -f "${BACKUPFILE}" ] || { echo "No backup at ${BACKUPFILE}." >&2; exit 1; }
    STAGE=""
    trap 'trap "" HUP INT TERM
        "${COMMITTED}" || rollback
        cd /
        [ -z "${STAGE}" ] || rm -rf "${STAGE}"
        resume_services' EXIT
    trap 'exit 1' HUP INT TERM
    pause_services || exit 1
    # Stage on /storage itself, so most promotions are renames on one disk.
    STAGE=$(mktemp -d /storage/.cache/backuptool-restore.XXXXXX) || exit 1
    enter "${STAGE}" || abort "Unsafe staging folder ${STAGE}."
    verify_archive "${BACKUPFILE}" "${STAGE}" "" || exit 1

    while IFS= read -r member; do
        [ "${member}" != "${MANIFEST}" ] || continue
        map_member "${member}"
        is_excluded "${member}" "${REL}" && continue
        members+=("${member}")
        dests+=("/${REL}")
    done <"${STAGE}/files"
    [ "${#members[@]}" -gt 0 ] || { echo 'Nothing to restore.'; exit 0; }
    # Refuse early when a destination is reached through a symlink or is not
    # a file. Every step below checks its folder again right before acting.
    mapfile -d '' -t real < <(printf '%s\0' "${dests[@]}" | xargs -0 realpath -m -z --) || exit 1
    [ "${#real[@]}" -eq "${#dests[@]}" ] || exit 1
    for index in "${!dests[@]}"; do
        dest="${dests[index]}"
        if [[ "${real[index]}" != "${dest}" || "${dest}" != "${STORAGE}/"* ]] || \
           { [ -e "${dest}" ] && [ ! -f "${dest}" ]; }; then
            bad+=("${dest}")
        fi
    done
    if [ "${#bad[@]}" -gt 0 ]; then
        printf 'Unsafe destination (symlink or not a file): %s\n' "${bad[@]}" >&2
        abort 'Refusing backup.'
    fi
    # Current Wi-Fi credentials stay unless the user restores Wi-Fi as well.
    if [ "${2}" != "--with-wifi" ] && [ -f "${STAGE}/root/${SYSTEM_CFG}" ]; then
        KEEP=$(grep '^wifi\.\(ssid\|key\)=' "/${SYSTEM_CFG}" 2>/dev/null)
        sed -i '/^wifi\.\(ssid\|key\)=/d' "${STAGE}/root/${SYSTEM_CFG}" || exit 1
        [ -z "${KEEP}" ] || printf '%s\n' "${KEEP}" >>"${STAGE}/root/${SYSTEM_CFG}" || exit 1
    fi

    # Decide every file first. A save is replaced only when the device copy
    # is provably older than the backed-up one (by the mtime recorded at
    # backup time; the extracted mtime is meaningless with BusyBox). Equal
    # times, as on 2-second FAT clocks, or no record at all keep the device
    # copy and put the backup's beside it. Unverified contents never replace.
    for index in "${!members[@]}"; do
        member="${members[index]}" dest="${dests[index]}"
        src="${STAGE}/root/${member}" mtime="${MTIMES[${member}]}"
        if [ ! -e "${dest}" ]; then
            plan "${src}" "${dest}" "${mtime}" 1
            restored=$((restored + 1))
            continue
        fi
        cmp -s -- "${dest}" "${src}" && continue
        if is_save "${dest}"; then
            if [ -n "${mtime}" ] && [ "$(stat -c %Y -- "${dest}")" -lt "${mtime}" ]; then
                plan "${src}" "${dest}" "${mtime}" 0
                restored=$((restored + 1))
                continue
            fi
        elif "${VERIFIED}"; then
            plan "${src}" "${dest}" "${mtime}" 0
            restored=$((restored + 1))
            continue
        fi
        keep="${dest}.backup-${STAMP}"
        [ ! -e "${keep}" ] || keep="${keep}-$$"
        plan "${src}" "${keep}" "${mtime}" 1
        kept=$((kept + 1))
        notes+=("Kept ${dest}; the backup's copy is ${keep}")
    done
    check_space || abort 'Refusing to start the restore.'

    # Phase 1: every file waits as a temporary next to its destination, on
    # the destination's filesystem. A failure here leaves nothing changed.
    for index in "${!P_DEST[@]}"; do
        dest="${P_DEST[index]}" temp=$(temp_of "${index}")
        { make_dirs "${dest%/*}" && enter "${dest%/*}"; } || abort "Unsafe folder for ${dest}."
        P_STATE[index]=staging
        mv -fT -- "${P_SRC[index]}" "${temp}" || abort "Cannot write ${dest}."
        if [ -n "${P_MTIME[index]}" ]; then
            touch -m -d "@${P_MTIME[index]}" -- "${temp}" || abort "Cannot write ${dest}."
        fi
        P_STATE[index]=staged
    done
    # Phase 2: renames only. The old file moves aside first so that a
    # failure or a signal can put it back.
    for index in "${!P_DEST[@]}"; do
        dest="${P_DEST[index]}" base="${P_DEST[index]##*/}" temp=$(temp_of "${index}")
        enter "${dest%/*}" || abort "Unsafe folder for ${dest}."
        if [ "${P_NEW[index]}" = 1 ]; then
            { [ ! -e "${base}" ] && [ ! -L "${base}" ]; } || abort "${dest} appeared during the restore."
            P_STATE[index]=committing
        else
            { [ -f "${base}" ] && [ ! -L "${base}" ]; } || abort "${dest} changed during the restore."
            P_STATE[index]=committing
            mv -fT -- "${base}" "$(undo_of "${index}")" || abort "Cannot replace ${dest}."
        fi
        mv -fT -- "${temp}" "${base}" || abort "Cannot replace ${dest}."
        P_STATE[index]=placed
    done
    COMMITTED=true
    for index in "${!P_DEST[@]}"; do
        [ "${P_NEW[index]}" = 1 ] || { enter "${P_DEST[index]%/*}" && rm -f -- "$(undo_of "${index}")"; }
    done
    cd / || exit 1

    echo "Restored ${restored} files; kept ${kept} device files that differ, with the backup's copy beside them."
    if [ "${#notes[@]}" -gt 0 ]; then
        report="${BACKUPFOLDER}/${OS_NAME}_RESTORE-${STAMP}.log"
        [ ! -e "${report}" ] || report="${BACKUPFOLDER}/${OS_NAME}_RESTORE-${STAMP}-$$.log"
        printf '%s\n' "${notes[@]}" | tee "${report}"
        printf '%s\n' "${notes[@]}" | logger -t backuptool 2>/dev/null
    fi
    return 0
}

backup() {
    local bytes names cfgsize required available
    take_lock
    WORKDIR="" ARCHIVEFILENAME=""
    trap '[ -z "${WORKDIR}" ] || rm -rf "${WORKDIR}"
        if [ -n "${ARCHIVEFILENAME}" ] && [ ! -f "${BACKUPFILE}" ]; then
            mv "${BACKUPFOLDER}/${ARCHIVEFILENAME}" "${BACKUPFILE}"
        fi' EXIT
    trap 'exit 1' HUP INT TERM
    # Build on the destination filesystem, so publication never copies
    # across mounts.
    WORKDIR=$(mktemp -d "${BACKUPFOLDER}/.backuptool.XXXXXX") || exit 1
    collect_tree "${COMPRESSLOCATIONS[@]}" >"${WORKDIR}/files.raw" || exit 1
    if "${USE_DEFAULT}"; then
        collect_rom_saves >>"${WORKDIR}/files.raw" || exit 1
    fi
    sort -zu "${WORKDIR}/files.raw" >"${WORKDIR}/files.sorted" || exit 1
    select_files "${WORKDIR}/files.sorted" >"${WORKDIR}/files" || exit 1
    [ -s "${WORKDIR}/files" ] || { echo 'No files to back up.' >&2; exit 1; }
    # Raw file sizes plus deflate expansion, names and ZIP headers, for the
    # ZIP and for its verification copy, which coexist.
    bytes=$(tr '\n' '\0' <"${WORKDIR}/files" | xargs -0 -r stat -c '%s' | \
        awk '{bytes += $1; files++} END {printf "%.0f", bytes + bytes/1000 + files*256}') || exit 1
    names=$(wc -c <"${WORKDIR}/files") || exit 1
    cfgsize=0
    [ ! -f "/${SYSTEM_CFG}" ] || cfgsize=$(stat -c '%s' "/${SYSTEM_CFG}") || exit 1
    required=$(( (bytes*2 + names*6 + cfgsize*3 + 1048576 + 1023) / 1024 ))
    available=$(df -Pk "${BACKUPFOLDER}" | awk 'END {print $4}') || exit 1
    [[ "${available}" =~ ^[0-9]+$ ]] || { echo 'Cannot check free space.' >&2; exit 1; }
    echo "Backup: up to ${required} KiB required; ${available} KiB free."
    if [ "${available}" -lt "${required}" ]; then
        echo 'Not enough free space for the backup.' >&2
        exit 1
    fi
    # Wi-Fi credentials leave system.cfg unless the user opted in: the
    # archive gets a sanitized copy under the same name.
    if [ "${2}" != "--with-wifi" ] && grep -Fqx "/${SYSTEM_CFG}" "${WORKDIR}/files"; then
        mkdir -p "${WORKDIR}/${SYSTEM_CFG%/*}" || exit 1
        grep -v '^wifi\.\(ssid\|key\)=' "/${SYSTEM_CFG}" >"${WORKDIR}/${SYSTEM_CFG}"
        [ "$?" -le 1 ] || exit 1
        grep -Fvx "/${SYSTEM_CFG}" "${WORKDIR}/files" >"${WORKDIR}/files.zip"
        [ "$?" -le 1 ] || exit 1
        echo "${SYSTEM_CFG}" >>"${WORKDIR}/files.zip" || exit 1
    else
        cp "${WORKDIR}/files" "${WORKDIR}/files.zip" || exit 1
    fi
    # Checksum and mtime of what goes in, relative to the archive root.
    # sha256sum and stat keep their input order, so the lines pair up.
    mkdir -p "${WORKDIR}/${MANIFEST%/*}" || exit 1
    (cd "${WORKDIR}" && paste -d ' ' \
        <(tr '\n' '\0' <files.zip | xargs -0 -r stat -c '%Y' --) \
        <(tr '\n' '\0' <files.zip | xargs -0 -r sha256sum --)) | \
        sed -E 's|^([0-9]+) ([0-9a-f]{64})  /?|\2 \1 |' >"${WORKDIR}/${MANIFEST}" || exit 1
    [ "$(wc -l <"${WORKDIR}/${MANIFEST}")" -eq "$(wc -l <"${WORKDIR}/files.zip")" ] || exit 1
    echo "${MANIFEST}" >>"${WORKDIR}/files.zip" || exit 1
    # Absolute names lose their leading slash, so live files and the staged
    # ones share one archive root. Writing to a pipe keeps every non-empty
    # entry deflated: Info-ZIP stores incompressible files only when it can
    # seek back, and BusyBox unzip checks CRCs of deflated entries alone.
    (cd "${WORKDIR}" && zip -q -9 -MM - -@ <files.zip | cat >backup.zip) || exit 1
    # The finished archive must pass the same checks as a restore.
    verify_archive "${WORKDIR}/backup.zip" "${WORKDIR}/verify" required || exit 1
    rm -rf "${WORKDIR}/verify"
    # Keep the last good backup at its usual path until the new ZIP is ready.
    if [ -f "${BACKUPFILE}" ]; then
        ARCHIVEFILENAME="ARCHIVED_${OS_NAME}_BACKUP-${STAMP}-$$.zip"
        mv "${BACKUPFILE}" "${BACKUPFOLDER}/${ARCHIVEFILENAME}" || exit 1
    fi
    if ! mv "${WORKDIR}/backup.zip" "${BACKUPFILE}"; then
        [ -z "${ARCHIVEFILENAME}" ] || mv "${BACKUPFOLDER}/${ARCHIVEFILENAME}" "${BACKUPFILE}"
        exit 1
    fi
}

case "${1}" in
    "restore") restore "$@" ;;
    "backup") backup "$@" ;;
    *)
        usage >&2
        exit 1
    ;;
esac
