#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2023 JELOS (https://github.com/JustEnoughLinuxOS)
# Copyright (C) 2025-present ArchR (https://github.com/archr-linux/Arch-R)
#
# Second microSD (SD2). The card is mounted at /storage/games-external only;
# /storage/roms (SD1) is never covered. Its ROM folder, <card>/roms when it
# exists, else the card root (dArkOS layout), is published as the symlink
# /run/archr/roms2, which the launcher lists next to /storage/roms.
# Unified storage (system.merged.storage=1, ext4/btrfs only) is the explicit
# exception: an overlay of both cards on /storage/roms, and no symlink.
#
#   automount              boot, or a card inserted (archr-automount.service)
#   automount eject        unmount the card now; 0 done, 1 busy, 2 no card
#   automount remove DEV   udev: DEV was pulled out, lazy unmount
#
# Paths and the profile can be redirected for the host test (tests/).

. "${AUTOMOUNT_PROFILE:-/etc/profile}"

STORAGE="${AUTOMOUNT_STORAGE:-/storage}"
PROC="${AUTOMOUNT_PROC:-/proc}"
SYS_BLOCK="${AUTOMOUNT_SYS:-/sys/class/block}"
ROMS2="${AUTOMOUNT_RUN:-/run/archr}/roms2"
MS_PATH="${STORAGE}/roms"
EXTERNAL="${STORAGE}/games-external"
INTERNAL_BIND="${STORAGE}/.games-internal-bind/roms"
# Smaller partitions are boot/firmware areas, never a games card. The old
# 8 GiB floor (JELOS: skip a handheld's internal eMMC) hid real 4/8 GB cards;
# the system card is now skipped by name (system_disk) instead.
MIN_KIB=65536
# Bounded so a damaged card delays the boot by at most this; a card that
# needs longer is better checked on a PC.
FSCK_TIMEOUT=${AUTOMOUNT_FSCK_TIMEOUT:-60}

### Mount table helpers (no octal escapes: our mount points have no spaces).
mounted_at() {
  awk -v p="$1" '$2 == p { d = $1 } END { print d }' "${PROC}/mounts"
}
fstype_at() {
  awk -v p="$1" '$2 == p { t = $3 } END { print t }' "${PROC}/mounts"
}
# The whole disk of a partition: mmcblk0p1 -> mmcblk0, sda1 -> sda.
disk_of() {
  local name=${1##*/}
  case ${name} in
    mmcblk*p[0-9]* | nvme*p[0-9]*) echo "${name%p[0-9]*}" ;;
    sd*) echo "${name%%[0-9]*}" ;;
    *) echo "${name}" ;;
  esac
}
system_disk() {
  disk_of "$(mounted_at "${STORAGE}")"
}

publish() {
  local roms=${EXTERNAL}
  [ -d "${EXTERNAL}/roms" ] && roms="${EXTERNAL}/roms"
  mkdir -p "${ROMS2%/*}"
  ln -sfn "${roms}" "${ROMS2}"
  log $0 "Second card ROMs at ${roms}"
}

start_ms() {
  ### Entrypoint will be either games card found (external), or not found (internal).
  MS_DEVICE=$(get_setting system.merged.device)
  ### If the merge target isn't defined and we have an external microsd, we should use the external card by default.
  if [ -z "${MS_DEVICE}" ] && [ "${1}" = "external" ]
  then
    set_setting system.merged.device external
  fi

  mkdir -p "${MS_PATH}"

  # Migrate: if games-internal/roms has content but roms/ is empty, move it
  if [ -d "${STORAGE}/games-internal/roms" ] && [ "$(ls -A ${STORAGE}/games-internal/roms 2>/dev/null)" ] && [ ! "$(ls -A ${MS_PATH} 2>/dev/null)" ]; then
    log $0 "Migrating ROMs from games-internal/roms/ to roms/"
    mv ${STORAGE}/games-internal/roms/* ${MS_PATH}/ 2>/dev/null
    rmdir ${STORAGE}/games-internal/roms 2>/dev/null
    ln -sf ${MS_PATH} ${STORAGE}/games-internal/roms 2>/dev/null
  fi

  # Backwards compat: symlink games-internal/roms → roms if not already
  if [ ! -L "${STORAGE}/games-internal/roms" ] && [ ! -d "${STORAGE}/games-internal/roms" ]; then
    mkdir -p ${STORAGE}/games-internal
    ln -sf ${MS_PATH} ${STORAGE}/games-internal/roms
  fi

  [ "${1}" = "external" ] || return 0

  if [ -e "${STORAGE}/.ms_unsupported" ] || [ ! "$(get_setting system.merged.storage)" = 1 ]
  then
    publish
    return 0
  fi
  if [ -n "$(mounted_at "${MS_PATH}")" ]
  then
    log $0 "${MS_PATH} already merged."
    return 0
  fi

  ### Unified storage: an overlay of both cards on /storage/roms.
  case ${MS_DEVICE} in
    internal) LOWER="external"; UPPER="internal" ;;
    *)        LOWER="internal"; UPPER="external" ;;
  esac
  log $0 "Enabling merged storage of games-${LOWER} and games-${UPPER} on ${MS_PATH}."
  # "internal" lives at /storage/roms itself: bind it elsewhere so the overlay
  # does not use one path as both lowerdir and mount point (-EBUSY).
  local LOWER_DIR UPPER_DIR WORK_DIR
  [ "${LOWER}" = "internal" ] && LOWER_DIR="${INTERNAL_BIND}" || LOWER_DIR="${EXTERNAL}/roms"
  [ "${UPPER}" = "internal" ] && UPPER_DIR="${INTERNAL_BIND}" || UPPER_DIR="${EXTERNAL}/roms"
  [ "${UPPER}" = "internal" ] && WORK_DIR="${STORAGE}/.tmp/games-workdir" || WORK_DIR="${EXTERNAL}/.tmp/games-workdir"
  mkdir -p "${INTERNAL_BIND}" "${EXTERNAL}/roms" "${WORK_DIR}"
  [ -n "$(mounted_at "${INTERNAL_BIND}")" ] || mount --bind "${MS_PATH}" "${INTERNAL_BIND}"
  mount -t overlay overlay -o lowerdir=${LOWER_DIR},upperdir=${UPPER_DIR},workdir=${WORK_DIR} "${MS_PATH}"
}

### Drops the card. $1: the device that went away (empty: whatever is
### mounted); $2: -l for a lazy unmount. Returns 1 when a mount stays busy.
release() {
  local device
  device=$(mounted_at "${EXTERNAL}")
  [ -n "${device}" ] || return 0
  [ -z "${1}" ] || [ "${1}" = "${device}" ] || return 0
  rm -f "${ROMS2}"
  if [ "$(fstype_at "${MS_PATH}")" = "overlay" ]
  then
    umount ${2} "${MS_PATH}" || return 1
    umount ${2} "${INTERNAL_BIND}" 2>/dev/null
  fi
  umount ${2} "${EXTERNAL}" || return 1
  log $0 "Released ${device}."
}

eject() {
  [ -n "$(mounted_at "${EXTERNAL}")" ] || return 2
  sync
  if ! release
  then
    # Busy: put back whatever was already taken down.
    start_ms external
    return 1
  fi
}

load_modules() {
  for MODULE in exfat vfat ntfs3
  do
    lsmod | grep -q "^${MODULE} " || modprobe ${MODULE} >/dev/null 2>&1
  done
}

create_game_dirs() {
  ### We don't want systemd to manage this or the directories could be created in the wrong location.
  if [ -e "/usr/config/system-dirs.conf" ]
  then
    log $0 "Creating game directories."
    systemd-tmpfiles --create /usr/config/system-dirs.conf >/dev/null 2>&1 ||:
  fi
}

mount_card() {
  local options
  case ${FSTYPE} in
    ext4 | btrfs) options="-t ${FSTYPE}" ;;
    # vfat's own UTF-8 switch: iocharset=utf8 would make names case-sensitive.
    vfat) options="-t vfat -o uid=0,gid=0,fmask=0022,dmask=0022,utf8" ;;
    exfat) options="-t exfat -o uid=0,gid=0,fmask=0022,dmask=0022,iocharset=utf8" ;;
    ntfs) options="-t ntfs3 -o uid=0,gid=0,iocharset=utf8" ;;
  esac
  mount ${options} "${1}" "${EXTERNAL}" >/dev/null 2>&1
}

mount_games() {
  FSTYPE=$(blkid -o value -s TYPE "${1}")
  case ${FSTYPE} in
    ext4 | btrfs)
      rm -f "${STORAGE}/.ms_unsupported"
      touch "${STORAGE}/.ms_supported"
    ;;
    vfat | exfat | ntfs)
      rm -f "${STORAGE}/.ms_supported"
      touch "${STORAGE}/.ms_unsupported"
    ;;
    *)
      log $0 "${1}: unsupported filesystem '${FSTYPE}'."
      return 1
    ;;
  esac

  mkdir -p "${EXTERNAL}"
  log $0 "Mounting ${1} (${FSTYPE}) on ${EXTERNAL}"
  if ! mount_card "${1}" || ! touch "${EXTERNAL}/.tmp-archr" 2>/dev/null
  then
    log $0 "Checking filesystem ${1}."
    umount "${EXTERNAL}" >/dev/null 2>&1
    timeout ${FSCK_TIMEOUT} fsck -Mly "${1}" >/dev/null 2>&1
    if ! mount_card "${1}"
    then
      log $0 "Cannot mount ${1}."
      return 1
    fi
  fi
  rm -f "${EXTERNAL}/.tmp-archr"
  start_ms external
}

find_games() {
  local system dev name size
  system=$(system_disk)
  for dev in $(blkid | awk -F: '/mmcblk[0-9]|\/sd[a-z]|nvme[0-9]/ && (/ext4/ || /btrfs/ || /fat/ || /ntfs/) {print $1}' | sort -r)
  do
    name=${dev##*/}
    if [ "$(disk_of "${dev}")" = "${system}" ]
    then
      continue
    fi
    if [ -L "${SYS_BLOCK}/$(disk_of "${dev}")boot0" ]
    then
      log $0 "Device ${dev} might be Android, ignoring."
      continue
    fi
    size=$(awk -v n="${name}" '$4 == n {print $3}' "${PROC}/partitions")
    if [ "${size:-0}" -lt "${MIN_KIB}" ]
    then
      log $0 "${dev} is too small (${size:-0} KiB), ignoring."
      continue
    fi
    if [ -n "$(awk -v d="${dev}" '$1 == d' "${PROC}/mounts")" ] || [ ! -e "${dev}" ]
    then
      log $0 "${dev} not available."
      continue
    fi
    log $0 "Found ${dev} available to mount."
    mount_games "${dev}" && return 0
  done
  return 1
}

### Main.
case "${1}" in
  eject)
    eject
    exit $?
  ;;
  remove)
    release "${2}" -l
    exit 0
  ;;
esac

MOUNT_GAMES=$(get_setting system.automount)
if [[ ! "${MOUNT_GAMES}" =~ [0-9] ]]
then
  set_setting system.automount 1
elif [[ "${MOUNT_GAMES}" == "0" ]]
then
  start_ms internal
  exit 0
fi

# Restarted for another card while one is mounted: keep it if it is still
# there, drop it if it was pulled out. /storage/roms is never unmounted here.
CURRENT=$(mounted_at "${EXTERNAL}")
if [ -n "${CURRENT}" ] && [ -e "${CURRENT}" ]
then
  start_ms external
  exit 0
fi
[ -z "${CURRENT}" ] || release "" -l
rm -f "${ROMS2}"

if [ -e "${STORAGE}/.please_resize_me" ]
then
  start_ms internal
  exit 0
fi

load_modules
GAMES_DEVICE=$(get_setting system.gamesdevice)
if { [ -e "${GAMES_DEVICE}" ] && mount_games "${GAMES_DEVICE}"; } || find_games
then
  create_game_dirs
  exit 0
fi

log $0 "No second card; ${MS_PATH} is used directly."
if [ -z "$(get_setting system.merged.device)" ]
then
  set_setting system.merged.device internal
fi
start_ms internal
create_game_dirs
