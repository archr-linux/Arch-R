#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2023 JELOS (https://github.com/JustEnoughLinuxOS)
# Copyright (C) 2025-present ArchR (https://github.com/archr-linux/Arch-R)
#
# Second microSD (SD2). The card is mounted at /storage/games-external only.
# Its ROM folder, <card>/roms when it exists, else the card root (dArkOS
# layout), is published as the symlink /run/archr/roms2, which the launcher
# lists next to /storage/roms.
#
# Unified storage (system.merged.storage=1, off by default) shows both cards
# as one /storage/roms instead: a mergerfs union of SD1's /storage/roms and
# the SD2 ROM folder, and no symlink. Nothing is moved or reformatted; each
# card keeps its own files and stays readable on its own in a PC. New files
# go to the card that already holds their folder (epmfs: a save stays next
# to its game). Turning it off only unmounts the union.
#
#   automount              boot, or a card inserted (archr-automount.service)
#   automount eject        unmount the card now; 0 done, 1 busy, 2 no card
#   automount remove DEV   udev: DEV was pulled out, lazy unmount
#   automount unify 0|1    save unified storage and apply it now; 1 failed
#
# Paths and the profile can be redirected for the host test (tests/).

. "${AUTOMOUNT_PROFILE:-/etc/profile}"

STORAGE="${AUTOMOUNT_STORAGE:-/storage}"
PROC="${AUTOMOUNT_PROC:-/proc}"
SYS_BLOCK="${AUTOMOUNT_SYS:-/sys/class/block}"
RUN="${AUTOMOUNT_RUN:-/run/archr}"
ROMS2="${RUN}/roms2"
# Present while the mounted card failed its check; the Storage page warns.
ERRORS="${ROMS2}.errors"
MS_PATH="${STORAGE}/roms"
EXTERNAL="${STORAGE}/games-external"
# SD1's /storage/roms as a union branch: a branch cannot be the mount point
# itself, so it is bound here first (private: the union must not propagate
# onto its own branch).
SD1_BRANCH="${RUN}/sd1-roms"
UNION_OPTS="category.create=epmfs,func.getattr=newest,minfreespace=1G,moveonenospc=true,cache.files=partial,dropcacheonclose=true,fsname=archr-roms"
# Smaller partitions are boot/firmware areas, never a games card. The old
# 8 GiB floor (JELOS: skip a handheld's internal eMMC) hid real 4/8 GB cards;
# the system card is now skipped by name (system_disk) instead.
MIN_KIB=65536
# The check is read-only (never repairs at boot), so cutting it is harmless;
# bounded so a damaged card delays the boot by at most this.
FSCK_TIMEOUT=${AUTOMOUNT_FSCK_TIMEOUT:-60}

### Mount table helpers (no octal escapes: our mount points have no spaces).
mounted_at() {
  awk -v p="$1" '$2 == p { d = $1 } END { print d }' "${PROC}/mounts"
}
fstype_at() {
  awk -v p="$1" '$2 == p { t = $3 } END { print t }' "${PROC}/mounts"
}
# The whole disk of a partition: mmcblk0p1 -> mmcblk0, sda1 -> sda.
disk_of() {
  local name=${1##*/}
  case ${name} in
    mmcblk*p[0-9]* | nvme*p[0-9]*) echo "${name%p[0-9]*}" ;;
    sd*) echo "${name%%[0-9]*}" ;;
    *) echo "${name}" ;;
  esac
}
system_disk() {
  disk_of "$(mounted_at "${STORAGE}")"
}

# The second card's ROM folder.
card_roms() {
  if [ -d "${EXTERNAL}/roms" ]; then echo "${EXTERNAL}/roms"; else echo "${EXTERNAL}"; fi
}

publish() {
  mkdir -p "${RUN}"
  ln -sfn "$(card_roms)" "${ROMS2}"
  log $0 "Second card ROMs at $(card_roms)"
}

# Unified storage was an overlay (ext4/btrfs only) before mergerfs. Its files
# are plain files on either card and stay where they are; only its bookkeeping
# goes: the work dir and the whiteouts (0:0 character devices standing for
# files deleted through the overlay), which would shadow real files in the
# union. A file deleted that way while the other card still had it shows up
# again: nothing is lost. Runs once, while a work dir is left.
forget_overlay() {
  local work found=
  for work in "${STORAGE}/.tmp/games-workdir" "${EXTERNAL}/.tmp/games-workdir"
  do
    [ -d "${work}" ] || continue
    rm -rf "${work}"
    found=1
  done
  rmdir "${STORAGE}/.games-internal-bind/roms" "${STORAGE}/.games-internal-bind" 2>/dev/null
  [ -n "${found}" ] || return 0
  log $0 "Dropping the old overlay's whiteouts."
  find "${MS_PATH}" "$(card_roms)" -xdev -type c -exec sh -c \
    'for f; do [ "$(stat -c %t:%T "$f")" = 0:0 ] && rm -f "$f"; done' sh {} +
}

unified() {
  case $(fstype_at "${MS_PATH}") in
    fuse.mergerfs | overlay) return 0 ;;
  esac
  return 1
}

# Both cards as one /storage/roms. On failure the two folders stay apart.
unify() {
  unified && return 0
  forget_overlay
  mkdir -p "${SD1_BRANCH}"
  if [ -z "$(mounted_at "${SD1_BRANCH}")" ]
  then
    mount --bind "${MS_PATH}" "${SD1_BRANCH}" && mount --make-private "${SD1_BRANCH}" || return 1
  fi
  # Its own scope: restarting automount (a card inserted) or the launcher
  # (which runs "automount unify") must not kill the union's daemon.
  if ! systemd-run --scope --quiet --collect \
    mergerfs -o "${UNION_OPTS}" "${SD1_BRANCH}:$(card_roms)" "${MS_PATH}"
  then
    log $0 "Cannot unify ${MS_PATH} and $(card_roms)."
    umount "${SD1_BRANCH}" 2>/dev/null
    return 1
  fi
  rm -f "${ROMS2}"
  log $0 "Unified ${MS_PATH} and $(card_roms)."
}

# Back to two folders. Lazy, so it never fails: open files keep working
# through the detached union, while every new path reaches SD1 directly. The
# SD1 branch stays bound while the union still uses it, so a write through
# it always lands on SD1 (it is reused by the next unify).
separate() {
  unified || return 0
  umount -l "${MS_PATH}"
  umount "${SD1_BRANCH}" 2>/dev/null
  umount "${STORAGE}/.games-internal-bind/roms" 2>/dev/null
  log $0 "${MS_PATH} is SD1 alone again."
}

# The card is mounted: unified or two folders, as the setting says.
apply() {
  if [ "$(get_setting system.merged.storage)" = 1 ]
  then
    unify && return 0
    publish
    return 1
  fi
  separate
  publish
}

start_ms() {
  mkdir -p "${MS_PATH}"

  # Migrate: if games-internal/roms has content but roms/ is empty, move it
  if [ -d "${STORAGE}/games-internal/roms" ] && [ "$(ls -A ${STORAGE}/games-internal/roms 2>/dev/null)" ] && [ ! "$(ls -A ${MS_PATH} 2>/dev/null)" ]; then
    log $0 "Migrating ROMs from games-internal/roms/ to roms/"
    mv ${STORAGE}/games-internal/roms/* ${MS_PATH}/ 2>/dev/null
    rmdir ${STORAGE}/games-internal/roms 2>/dev/null
    ln -sf ${MS_PATH} ${STORAGE}/games-internal/roms 2>/dev/null
  fi

  # Backwards compat: symlink games-internal/roms → roms if not already
  if [ ! -L "${STORAGE}/games-internal/roms" ] && [ ! -d "${STORAGE}/games-internal/roms" ]; then
    mkdir -p ${STORAGE}/games-internal
    ln -sf ${MS_PATH} ${STORAGE}/games-internal/roms
  fi

  [ "${1}" = "external" ] || return 0
  # A failed union still leaves both cards listed: never a failed mount.
  apply || :
}

### Drops the card. $1: the device that went away (empty: whatever is
### mounted); $2: -l for a lazy unmount. Returns 1 when the card stays busy.
release() {
  local device
  device=$(mounted_at "${EXTERNAL}")
  [ -n "${device}" ] || return 0
  [ -z "${1}" ] || [ "${1}" = "${device}" ] || return 0
  rm -f "${ROMS2}" "${ERRORS}"
  separate
  umount ${2} "${EXTERNAL}" || return 1
  log $0 "Released ${device}."
}

eject() {
  [ -n "$(mounted_at "${EXTERNAL}")" ] || return 2
  sync
  if ! release
  then
    # Busy: put back whatever was already taken down.
    start_ms external
    return 1
  fi
}

# Saves the switch, then applies it to a mounted card (a card inserted
# later follows the saved value). A failed union restores the old value.
set_unified() {
  local old
  case ${1} in 0 | 1) ;; *) return 1 ;; esac
  old=$(get_setting system.merged.storage)
  set_setting system.merged.storage "${1}"
  [ -n "$(mounted_at "${EXTERNAL}")" ] || return 0
  apply && return 0
  set_setting system.merged.storage "${old:-0}"
  apply
  return 1
}

load_modules() {
  for MODULE in exfat vfat ntfs3
  do
    lsmod | grep -q "^${MODULE} " || modprobe ${MODULE} >/dev/null 2>&1
  done
}

create_game_dirs() {
  ### We don't want systemd to manage this or the directories could be created in the wrong location.
  if [ -e "/usr/config/system-dirs.conf" ]
  then
    log $0 "Creating game directories."
    systemd-tmpfiles --create /usr/config/system-dirs.conf >/dev/null 2>&1 ||:
  fi
}

mount_card() {
  local options
  case ${FSTYPE} in
    ext4 | btrfs) options="-t ${FSTYPE}" ;;
    # vfat's own UTF-8 switch: iocharset=utf8 would make names case-sensitive.
    vfat) options="-t vfat -o uid=0,gid=0,fmask=0022,dmask=0022,utf8" ;;
    exfat) options="-t exfat -o uid=0,gid=0,fmask=0022,dmask=0022,iocharset=utf8" ;;
    ntfs) options="-t ntfs3 -o uid=0,gid=0,iocharset=utf8" ;;
  esac
  mount ${options} "${1}" "${EXTERNAL}" >/dev/null 2>&1
}

mount_games() {
  FSTYPE=$(blkid -o value -s TYPE "${1}")
  # Markers of the old overlay, which needed ext4/btrfs; mergerfs takes any.
  rm -f "${STORAGE}/.ms_supported" "${STORAGE}/.ms_unsupported"
  case ${FSTYPE} in
    ext4 | btrfs | vfat | exfat | ntfs) ;;
    *)
      log $0 "${1}: unsupported filesystem '${FSTYPE}'."
      return 1
    ;;
  esac

  mkdir -p "${EXTERNAL}"
  log $0 "Mounting ${1} (${FSTYPE}) on ${EXTERNAL}"
  if ! mount_card "${1}" || ! touch "${EXTERNAL}/.tmp-archr" 2>/dev/null
  then
    # Look, never repair: errors (or no verdict in time) are reported, and
    # the card is still mounted as it is.
    umount "${EXTERNAL}" >/dev/null 2>&1
    if ! timeout ${FSCK_TIMEOUT} fsck -n "${1}" >/dev/null 2>&1
    then
      log $0 "${1} has filesystem errors (or the check timed out); repair it on a PC."
      mkdir -p "${ERRORS%/*}"
      touch "${ERRORS}"
    fi
    if ! mount_card "${1}"
    then
      log $0 "Cannot mount ${1}."
      return 1
    fi
  fi
  rm -f "${EXTERNAL}/.tmp-archr"
  start_ms external
}

find_games() {
  local system dev name size
  system=$(system_disk)
  for dev in $(blkid | awk -F: '/mmcblk[0-9]|\/sd[a-z]|nvme[0-9]/ && (/ext4/ || /btrfs/ || /fat/ || /ntfs/) {print $1}' | sort -r)
  do
    name=${dev##*/}
    if [ "$(disk_of "${dev}")" = "${system}" ]
    then
      continue
    fi
    if [ -L "${SYS_BLOCK}/$(disk_of "${dev}")boot0" ]
    then
      log $0 "Device ${dev} might be Android, ignoring."
      continue
    fi
    size=$(awk -v n="${name}" '$4 == n {print $3}' "${PROC}/partitions")
    if [ "${size:-0}" -lt "${MIN_KIB}" ]
    then
      log $0 "${dev} is too small (${size:-0} KiB), ignoring."
      continue
    fi
    if [ -n "$(awk -v d="${dev}" '$1 == d' "${PROC}/mounts")" ] || [ ! -e "${dev}" ]
    then
      log $0 "${dev} not available."
      continue
    fi
    log $0 "Found ${dev} available to mount."
    mount_games "${dev}" && return 0
  done
  return 1
}

### Main.
case "${1}" in
  eject)
    eject
    exit $?
  ;;
  remove)
    release "${2}" -l
    exit 0
  ;;
  unify)
    set_unified "${2}"
    exit $?
  ;;
esac

MOUNT_GAMES=$(get_setting system.automount)
if [[ ! "${MOUNT_GAMES}" =~ [0-9] ]]
then
  set_setting system.automount 1
elif [[ "${MOUNT_GAMES}" == "0" ]]
then
  start_ms internal
  exit 0
fi

# Restarted for another card while one is mounted: keep it if it is still
# there, drop it if it was pulled out. /storage/roms is never unmounted here.
CURRENT=$(mounted_at "${EXTERNAL}")
if [ -n "${CURRENT}" ] && [ -e "${CURRENT}" ]
then
  start_ms external
  exit 0
fi
[ -z "${CURRENT}" ] || release "" -l
rm -f "${ROMS2}" "${ERRORS}"

if [ -e "${STORAGE}/.please_resize_me" ]
then
  start_ms internal
  exit 0
fi

load_modules
GAMES_DEVICE=$(get_setting system.gamesdevice)
if { [ -e "${GAMES_DEVICE}" ] && mount_games "${GAMES_DEVICE}"; } || find_games
then
  create_game_dirs
  exit 0
fi

log $0 "No second card; ${MS_PATH} is used directly."
start_ms internal
create_game_dirs
