#!/usr/bin/python3
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2026-present ArchR (https://github.com/archr-linux/Arch-R)
#
# archr-boot-tuning: CPU and GPU voltages, and two extra CPU steps, set at
# boot through a device tree overlay, /flash/overlays/tuning.dtbo, that
# extlinux.conf lists after the panel's. Never the system DTB
# (archr-flash-sync replaces it on updates). The initramfs (tuning_guard)
# arms the watchdog and counts boots in /flash/tuning.trial while the
# overlay differs from the neutral one; a clean shutdown sets it to 0 (the
# unit's stop), and two unclean boots in a row put the neutral one back.
#
#   archr-boot-tuning status                 JSON: the whole state
#   archr-boot-tuning brief                  every step in one line (modules)
#   archr-boot-tuning set cpu|gpu <MHz> <uV> one step; 0 is its stock voltage,
#                                            or no step for a new CPU one
#   archr-boot-tuning offset cpu <uV>        every CPU step moved by it
#   archr-boot-tuning reset                  the neutral overlay: stock voltages
#   archr-boot-tuning boot                   at start: a revert becomes a toast
#   archr-boot-tuning clean                  at a clean shutdown: trial to 0
#   archr-boot-tuning dtbs-changed           archr-flash-sync put new DTBs in
#                                            /flash: the neutral overlay
#
# Changes take effect at the next boot. Voltages go in the regulators'
# 12.5 mV steps. A CPU step from 50 mV under its stock voltage to 25 over;
# the 1200 and 1296 MHz steps, where a table lacks them (the RK3326 has
# both since 20261125.2), between the stock voltages of the steps around
# them; the GPU only down to 1.1 V, the floor of vdd_logic, which it
# shares with the DDR (patch 035: lower corrupts the memory), and never
# over its stock voltage, the rail's ceiling.
import json
import os
import re
import struct
import subprocess
import sys

ROOT = os.environ.get("ARCHR_TUNING_ROOT", "")  # tests: a scratch root
FLASH = ROOT + "/flash"
OVERLAYS = FLASH + "/overlays"
ACTIVE = OVERLAYS + "/tuning.dtbo"
NEUTRAL = OVERLAYS + "/tuning.neutral.dtbo"
STOCK = FLASH + "/tuning.stock.json"
SETTINGS = FLASH + "/tuning.json"
TRIAL = FLASH + "/tuning.trial"
REVERTED = FLASH + "/tuning.reverted"
REVERTED_SEEN = REVERTED + ".seen"  # told once, kept for status
RESET = FLASH + "/tuning.reset"  # new DTBs undid the settings: told once
EXTLINUX = FLASH + "/extlinux/extlinux.conf"
DT = ROOT + "/proc/device-tree"
CFG = ROOT + "/storage/.config/system/configs/system.cfg"
TABLES = {"cpu": "opp-table-0", "gpu": "opp-table-1"}
STEP_UV = 12500
CPU_RANGE_UV = (-50000, 25000)  # around the stock voltage; -50 hangs some R36S
CPU_NEW_MHZ = (1200, 1296)
GPU_FLOOR_UV = 1100000
RAIL_UV = (850000, 1450000)


def out(obj, code=0):
    print(json.dumps(obj, separators=(",", ":")))
    sys.exit(code)


def load(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


# --- flattened device tree, just enough to write an overlay ---------------

def fdt(root):
    """An FDT blob from nested (name, props, children) tuples; props are
    (name, bytes)."""
    strings = b""
    offsets = {}
    body = b""

    def name_off(name):
        nonlocal strings
        if name not in offsets:
            offsets[name] = len(strings)
            strings += name.encode() + b"\0"
        return offsets[name]

    def pad(b):
        return b + b"\0" * (-len(b) % 4)

    def node(name, props, children):
        nonlocal body
        body += struct.pack(">I", 1) + pad(name.encode() + b"\0")
        for pname, value in props:
            body += struct.pack(">III", 3, len(value), name_off(pname)) + pad(value)
        for child in children:
            node(*child)
        body += struct.pack(">I", 2)

    node(*root)
    body += struct.pack(">I", 9)
    rsvmap = b"\0" * 16
    off_rsv = 40
    off_struct = off_rsv + len(rsvmap)
    off_strings = off_struct + len(body)
    total = off_strings + len(strings)
    header = struct.pack(">10I", 0xD00DFEED, total, off_struct, off_strings,
                         off_rsv, 17, 16, 0, len(strings), len(body))
    return header + rsvmap + body + strings


def fdt_string(text):
    return text.encode() + b"\0"


def fdt_cells(*values):
    return b"".join(struct.pack(">I", v) for v in values)


# --- the running tree -------------------------------------------------------

def read_table(table):
    """{MHz: {"uv": [...], "latency": ns}} of a table in the running tree."""
    path = os.path.join(DT, table)
    found = {}
    if not os.path.isdir(path):
        return found
    for name in os.listdir(path):
        node = os.path.join(path, name)
        uv_file = os.path.join(node, "opp-microvolt")
        if not (re.fullmatch(r"opp-\d+", name) and os.path.isfile(uv_file)):
            continue
        with open(uv_file, "rb") as f:
            raw = f.read()
        entry = {"uv": list(struct.unpack(">%dI" % (len(raw) // 4), raw))}
        try:
            with open(os.path.join(node, "clock-latency-ns"), "rb") as f:
                entry["latency"] = struct.unpack(">I", f.read(4))[0]
        except (OSError, struct.error):
            pass
        found[str(int(name[4:]) // 1000000)] = entry
    return found


def is_neutral():
    try:
        with open(ACTIVE, "rb") as a, open(NEUTRAL, "rb") as n:
            return a.read() == n.read()
    except OSError:
        return not os.path.exists(ACTIVE)


def stock():
    """The stock tables: read from the running tree while no tuning runs,
    then kept in /flash for when one does."""
    saved = load(STOCK, None)
    if isinstance(saved, dict) and all(isinstance(saved.get(t), dict) for t in TABLES):
        return saved
    settings = load(SETTINGS, {})
    if not is_neutral() or settings.get("pending_reboot"):
        return None
    tables = {t: read_table(name) for t, name in TABLES.items()}
    return tables if tables["cpu"] else None


def flash_rw():
    if not ROOT:
        subprocess.run(["mount", "-o", "remount,rw", "/flash"], check=True)


def flash_ro():
    if not ROOT:
        os.sync()
        subprocess.run(["mount", "-o", "remount,ro", "/flash"])


def write(path, data):
    tmp = path + ".new"
    with open(tmp, "wb" if isinstance(data, bytes) else "w") as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


def ensure_extlinux():
    """FDTOVERLAYS lists tuning.dtbo, after what it already lists."""
    try:
        with open(EXTLINUX) as f:
            text = f.read()
    except OSError:
        return False
    if "/overlays/tuning.dtbo" in text:
        return True
    lines = text.splitlines(keepends=True)
    for n, line in enumerate(lines):
        m = re.match(r"^(\s*)FDTOVERLAYS\s+(.*?)\s*$", line)
        if m:
            lines[n] = f"{m.group(1)}FDTOVERLAYS {m.group(2)} /overlays/tuning.dtbo\n"
            break
    else:
        for n, line in enumerate(lines):
            if re.match(r"^\s*FDTDIR\s", line):
                indent = re.match(r"^(\s*)", line).group(1)
                lines.insert(n + 1, f"{indent}FDTOVERLAYS /overlays/tuning.dtbo\n")
                break
        else:
            return False
    write(EXTLINUX, "".join(lines))
    return True


# --- the steps ----------------------------------------------------------------

def mv(uv):
    v = uv / 1000
    return int(v) if v == int(v) else v


def neighbours(cpu, mhz):
    """The stock steps just under and over a new one."""
    keys = sorted(int(k) for k in cpu)
    under = [k for k in keys if k < mhz]
    over = [k for k in keys if k > mhz]
    return (under[-1] if under else None), (over[0] if over else None)


def steps(st):
    """table -> [(MHz, stock µV or 0, low µV, high µV, base µV)] of what may
    change; base is where a uniform offset starts."""
    found = {"cpu": [], "gpu": []}
    cpu = st["cpu"]
    for k, e in cpu.items():
        s = e["uv"][0]
        found["cpu"].append((int(k), s, max(RAIL_UV[0], s + CPU_RANGE_UV[0]),
                             min(RAIL_UV[1], s + CPU_RANGE_UV[1]), s))
    for mhz in CPU_NEW_MHZ:
        if str(mhz) in cpu:
            continue
        under, over = neighbours(cpu, mhz)
        if under is None or over is None:
            continue
        low, high = cpu[str(under)]["uv"][0], cpu[str(over)]["uv"][0]
        found["cpu"].append((mhz, 0, low, min(RAIL_UV[1], high + CPU_RANGE_UV[1]), high))
    for k, e in st.get("gpu", {}).items():
        s = e["uv"][0]
        if s > GPU_FLOOR_UV:
            found["gpu"].append((int(k), s, GPU_FLOOR_UV, s, s))
    for t in found:
        found[t].sort()
    return found


def overlay(st, settings):
    """The overlay for these settings: the neutral one (a fragment over /
    that changes nothing) when there are none."""
    fragments = []
    for n, (t, table) in enumerate(TABLES.items()):
        chosen = settings.get(t, {})
        nodes = []
        for k in sorted(chosen, key=int):
            uv = chosen[k]
            stock_entry = st[t].get(k)
            name = "opp-%d" % (int(k) * 1000000)
            if stock_entry:
                cells = stock_entry["uv"]
                new = [uv] if len(cells) == 1 else [uv, uv, max(cells[-1], uv)]
                nodes.append((name, [("opp-microvolt", fdt_cells(*new))], []))
            else:
                _, over = neighbours(st[t], int(k))
                top = st[t][str(over)]["uv"]
                latency = next((e.get("latency") for e in st[t].values() if e.get("latency")), 40000)
                hz = int(k) * 1000000
                nodes.append((name, [("opp-hz", fdt_cells(hz >> 32, hz & 0xFFFFFFFF)),
                                     ("opp-microvolt", fdt_cells(uv, uv, max(top[-1], uv))),
                                     ("clock-latency-ns", fdt_cells(latency))], []))
        if nodes:
            fragments.append(("fragment@%d" % n, [("target-path", fdt_string("/" + table))],
                              [("__overlay__", [], nodes)]))
    if not fragments:
        fragments = [("fragment@0", [("target-path", fdt_string("/"))], [("__overlay__", [], [])])]
    return fdt(("", [], fragments))


def check(st, table, mhz, uv):
    """None when the step may take this voltage (0: its stock one)."""
    for m, _, low, high, _ in steps(st)[table]:
        if m == mhz:
            if uv == 0 or (uv % STEP_UV == 0 and low <= uv <= high):
                return None
            return "out_of_range"
    return "no_step"


def save(st, settings):
    """Writes the overlay for these settings; the next boot runs it."""
    flash_rw()
    try:
        os.makedirs(OVERLAYS, exist_ok=True)
        if load(STOCK, None) != st:
            write(STOCK, json.dumps(st))
        neutral = overlay(st, {})
        if not os.path.exists(NEUTRAL):
            write(NEUTRAL, neutral)
        write(ACTIVE, overlay(st, settings))
        if not ensure_extlinux():
            write(ACTIVE, neutral)
            out({"ok": False, "error": "no_extlinux"}, 1)
        for stale in (TRIAL, REVERTED, REVERTED_SEEN):
            if os.path.exists(stale):
                os.remove(stale)
        settings["pending_reboot"] = True
        write(SETTINGS, json.dumps(settings))
    finally:
        flash_ro()
    return {"ok": True, "reboot": True}


def current():
    settings = load(SETTINGS, {})
    return {t: {k: v for k, v in settings.get(t, {}).items() if isinstance(v, int)}
            for t in TABLES} | {"pending_reboot": bool(settings.get("pending_reboot"))}


def reverted_count():
    for path in (REVERTED, REVERTED_SEEN):
        try:
            with open(path) as f:
                return f.read().strip()
        except OSError:
            pass
    return None


def status():
    st = stock()
    trial = load(TRIAL, 0)
    return {
        "neutral": is_neutral(),
        "settings": current(),
        "stock": st,
        "running": {t: read_table(name) for t, name in TABLES.items()},
        "trial": trial if isinstance(trial, int) else 0,
        "reverted": reverted_count(),
    }


def brief():
    """Each step as [MHz, chosen mV (0: stock, or no step), stock mV (0:
    new), lowest, highest], short enough for a module (600 bytes)."""
    st = stock()
    settings = current()
    if not st:
        return {"supported": False, "pending": settings["pending_reboot"]}
    found = steps(st)
    rows = {t: [[m, mv(settings[t].get(str(m), 0)), mv(s), mv(lo), mv(hi)]
                for m, s, lo, hi, _ in found[t]] for t in found}
    return rows | {"pending": settings["pending_reboot"],
                   "reverted": reverted_count() is not None, "supported": True}


TOAST = {
    "pt": ("Ajuste de tensão desfeito: o console travou duas vezes",
           "As tensões de fábrica voltaram"),
    "es": ("Ajuste de voltaje deshecho: la consola se colgó dos veces",
           "Se restauraron los voltajes de fábrica"),
    "ru": ("Настройка напряжения отменена: консоль дважды зависла",
           "Восстановлены заводские напряжения"),
    "de": ("Spannungsanpassung zurückgenommen: die Konsole hing zweimal",
           "Werksspannungen wiederhergestellt"),
    "zh": ("电压调整已撤销：主机连续两次死机", "已恢复出厂电压"),
    "en": ("Voltage tuning undone: the console froze twice",
           "Stock voltages restored"),
}


# New DTBs (an update) undid the settings: their tables may have other steps.
TOAST_RESET = {
    "pt": ("Ajuste de tensão desfeito pela atualização",
           "A tabela do processador mudou; ajuste de novo em Desempenho e chip"),
    "es": ("La actualización deshizo el ajuste de voltaje",
           "La tabla del procesador cambió; ajústalo de nuevo en Rendimiento y chip"),
    "ru": ("Обновление отменило настройку напряжения",
           "Таблица процессора изменилась; настройте заново в «Производительность и чип»"),
    "de": ("Das Update hat die Spannungsanpassung zurückgesetzt",
           "Die Prozessortabelle hat sich geändert; neu einstellen"),
    "zh": ("更新撤销了电压调整", "处理器频率表已改变，请重新调整"),
    "en": ("Voltage tuning undone by the update",
           "The processor table changed; tune it again in Performance and chip"),
}


def language():
    try:
        with open(CFG, encoding="utf-8", errors="replace") as f:
            for line in f:
                if line.startswith("system.language="):
                    return line.split("=", 1)[1].strip()[:2] or "en"
    except OSError:
        pass
    return "en"


def boot():
    """This boot runs what is in place: nothing pending; a revert by the
    initramfs becomes a toast and clears the settings it undid."""
    settings = load(SETTINGS, None)
    changed = False
    if settings and settings.get("pending_reboot"):
        settings["pending_reboot"] = False
        changed = True
    reverted = os.path.exists(REVERTED)
    if reverted:
        title, detail = TOAST.get(language(), TOAST["en"])
        subprocess.run(["archr-toast", "error", "errors", title, detail],
                       capture_output=True)
        if settings and any(settings.get(t) for t in TABLES):
            settings = {"pending_reboot": False}
            changed = True
    reset = os.path.exists(RESET)
    if reset:
        title, detail = TOAST_RESET.get(language(), TOAST_RESET["en"])
        subprocess.run(["archr-toast", "info", "updates", title, detail],
                       capture_output=True)
    if changed or reverted or reset:
        flash_rw()
        try:
            if changed:
                write(SETTINGS, json.dumps(settings))
            if reverted:
                os.replace(REVERTED, REVERTED_SEEN)
            if reset:
                os.remove(RESET)
        finally:
            flash_ro()
    return {"ok": True, "reverted": reverted, "reset": reset}


def dtbs_changed():
    """New DTBs in /flash: the stock tables kept here, and settings made
    against them, may not fit (20261125.2 took the 408 MHz step out, and an
    overlay node for a step a table lacks breaks its whole CPU table). The
    stock goes, to be read again from the next boot's tree; settings go
    back to the neutral overlay, told at that boot."""
    settings = load(SETTINGS, {})
    tuned = not is_neutral() or any(settings.get(t) for t in TABLES)
    if not tuned and not os.path.exists(STOCK):
        return {"ok": True, "reset": False}
    flash_rw()
    try:
        if os.path.exists(STOCK):
            os.remove(STOCK)
        if tuned:
            os.makedirs(OVERLAYS, exist_ok=True)
            neutral = overlay({"cpu": {}, "gpu": {}}, {})
            if not os.path.exists(NEUTRAL):
                write(NEUTRAL, neutral)
            with open(NEUTRAL, "rb") as f:
                write(ACTIVE, f.read())
            for stale in (TRIAL, REVERTED):
                if os.path.exists(stale):
                    os.remove(stale)
            write(RESET, "1\n")
        # The running tree is still the old one: no stock read until a boot.
        write(SETTINGS, json.dumps({"pending_reboot": True}))
    finally:
        flash_ro()
    return {"ok": True, "reset": tuned}


def number(text):
    try:
        return int(text)
    except ValueError:
        out({"ok": False, "error": "bad_value"}, 2)


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    if cmd == "status":
        out(status())
    if cmd == "brief":
        out(brief())
    if cmd == "boot":
        out(boot())
    if cmd == "dtbs-changed":
        out(dtbs_changed())
    if cmd == "clean":
        if os.path.exists(TRIAL):
            flash_rw()
            try:
                write(TRIAL, "0\n")
            finally:
                flash_ro()
        out({"ok": True})
    if cmd not in ("set", "offset", "reset"):
        out({"ok": False, "error": "usage"}, 2)
    st = stock()
    if not st:
        out({"ok": False, "error": "no_stock"}, 1)
    settings = current()
    if cmd == "reset" and len(argv) == 2:
        out(save(st, {}))
    if cmd == "set" and len(argv) == 5 and argv[2] in TABLES:
        table, mhz, uv = argv[2], number(argv[3]), number(argv[4])
        error = check(st, table, mhz, uv)
        if error:
            out({"ok": False, "error": error}, 2)
        if uv == 0:
            settings[table].pop(str(mhz), None)
        else:
            settings[table][str(mhz)] = uv
        out(save(st, settings))
    if cmd == "offset" and len(argv) == 4 and argv[2] == "cpu":
        offset = number(argv[3])
        if offset % STEP_UV or not CPU_RANGE_UV[0] <= offset <= CPU_RANGE_UV[1]:
            out({"ok": False, "error": "out_of_range"}, 2)
        cpu = {}
        for m, s, low, high, base in steps(st)["cpu"]:
            if s == 0 and str(m) not in settings["cpu"]:
                continue  # a new step stays off
            uv = max(low, min(high, base + offset))
            if s == 0 or uv != s:
                cpu[str(m)] = uv
        settings["cpu"] = cpu
        out(save(st, settings))
    out({"ok": False, "error": "usage"}, 2)


if __name__ == "__main__":
    main(sys.argv)
