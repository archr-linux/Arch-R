"""archr-keypress KEY...: press and release keys on a short-lived virtual
keyboard (uinput), so the focused window, the running emulator, gets them as
from a real keyboard. archr-game-save-exit uses it for the emulators' own
"save state" keys. Keys: F1..F12, ESC."""
import fcntl
import os
import struct
import sys
import time

KEYS = {"ESC": 1, **{f"F{n}": 58 + n for n in range(1, 11)}, "F11": 87, "F12": 88}
EV_SYN, EV_KEY = 0, 1
UI_SET_EVBIT, UI_SET_KEYBIT = 0x40045564, 0x40045565
UI_DEV_CREATE, UI_DEV_DESTROY = 0x5501, 0x5502
# The compositor adds the new keyboard to its seat before the first key.
SETTLE = float(os.environ.get("ARCHR_KEYPRESS_SETTLE", "0.6"))


def main(names):
    codes = [KEYS.get(name.upper()) for name in names]
    if not codes or None in codes:
        print("usage: archr-keypress KEY... (F1..F12, ESC)", file=sys.stderr)
        return 2
    fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
    try:
        fcntl.ioctl(fd, UI_SET_EVBIT, EV_KEY)
        for code in codes:
            fcntl.ioctl(fd, UI_SET_KEYBIT, code)
        # struct uinput_user_dev: name, input_id, ff_effects_max, 4 x 64 abs.
        os.write(fd, struct.pack("80sHHHHi", b"archr-keypress", 0x06, 1, 1, 1, 0) + bytes(4 * 64 * 4))
        fcntl.ioctl(fd, UI_DEV_CREATE)
        time.sleep(SETTLE)

        def emit(kind, code, value):
            os.write(fd, struct.pack("llHHi", 0, 0, kind, code, value))

        for code in codes:
            for value in (1, 0):
                emit(EV_KEY, code, value)
                emit(EV_SYN, 0, 0)
                time.sleep(0.08)
        time.sleep(0.1)
        fcntl.ioctl(fd, UI_DEV_DESTROY)
    finally:
        os.close(fd)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
