#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2026 ArchR (https://github.com/archr-linux/Arch-R)
#
# archr-report: one zip with what a bug report needs, in a folder any PC
# reads (roms/relatorios). Settings > System > Diagnostics runs it; it is
# also meant to be run by hand (SSH) or by a button combination later.
#
#   archr-report        builds the report; prints on stdout
#                         REPORT=/storage/roms/relatorios/archr-relatorio-<date>.zip
#                         SIZE=<bytes>
#                       exit 1 when no report could be written.
#
# What goes in: hardware, kernel and dmesg, the journal of this boot and of
# the previous one (when the journal is persistent), failed services,
# network (addresses, routes, the SSID; never a password: Wi-Fi keys live in
# iwd's files, which are not read), storage, temperatures and frequencies,
# installed packages and libretro cores, system.cfg and the emulator and
# launcher configs, the last game's exec.log, the launcher's log and pstore.
#
# Every text file is sanitized before it is zipped: on any "name = value",
# "name=value" or "name: value" line whose name holds pass, token, key,
# secret, login, auth, credential, cookie, session or psk, or a user name of
# the scraper or of RetroAchievements, the value becomes <removed>. Files
# that only hold secrets (iwd, scraper and RetroAchievements credentials)
# are never copied. Each command runs with a time limit and each log is
# capped, so the report stays small and the run short.
#
# ARCHR_REPORT_ROOT prefixes every file read and written (tests).

ROOT="${ARCHR_REPORT_ROOT:-}"
OUT_DIR="${ROOT}/storage/roms/relatorios"
STAMP=$(date +%Y%m%d-%H%M)
NAME="archr-relatorio-${STAMP}"
CAP=$((2 * 1024 * 1024))
LIMIT=15

WORK=$(mktemp -d "${TMPDIR:-/tmp}/archr-report.XXXXXX") || exit 1
trap 'rm -rf "${WORK}"' EXIT
DIR="${WORK}/${NAME}"
mkdir -p "${DIR}"

# run FILE CMD...: CMD's output (stdout and stderr), with a time limit and
# a size cap, appended under a header. A missing command says so.
run() {
  local file="${DIR}/$1"
  shift
  {
    echo "### $*"
    if command -v "$1" >/dev/null 2>&1; then
      timeout "${LIMIT}" "$@" 2>&1 | head -c "${CAP}"
    else
      echo "(not available)"
    fi
    echo
  } >>"${file}"
}

# grab FILE SOURCE...: the last CAP bytes of each readable source file.
grab() {
  local file="${DIR}/$1" src
  shift
  for src in "$@"; do
    [ -f "${ROOT}${src}" ] && [ -r "${ROOT}${src}" ] || continue
    {
      echo "### ${src}"
      tail -c "${CAP}" "${ROOT}${src}"
      echo
    } >>"${file}"
  done
}

# Sysfs readings, one "path: value" per line.
readings() {
  local f
  for f in "$@"; do
    [ -r "${ROOT}${f}" ] && echo "${f#/sys/}: $(head -c 200 "${ROOT}${f}" 2>/dev/null | tr '\n' ' ')"
  done
}

# hardware
grab hardware.txt /proc/device-tree/model /etc/os-release /proc/cpuinfo /proc/meminfo /proc/cmdline
run hardware.txt uname -a
run hardware.txt lsusb
run hardware.txt lsmod

# kernel
run kernel-dmesg.txt dmesg
grab kernel-dmesg.txt /var/log/boot.log

# journal: this boot, and the previous one when it was kept
run journal-boot-atual.txt journalctl -b 0 --no-pager -o short-monotonic
if command -v journalctl >/dev/null 2>&1 &&
  timeout "${LIMIT}" journalctl --list-boots --no-pager 2>/dev/null | grep -q '^ *-1 '; then
  run journal-boot-anterior.txt journalctl -b -1 --no-pager -o short-monotonic
fi

# services
run servicos.txt systemctl --failed --no-pager
run servicos.txt systemctl list-units --type=service --state=running --no-pager

# network: interfaces, routes and the station (SSID and signal)
run rede.txt ip -brief address
run rede.txt ip route
run rede.txt iw dev
run rede.txt iwctl station wlan0 show
grab rede.txt /etc/resolv.conf /var/log/wifictl.log

# storage
run armazenamento.txt lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINT
run armazenamento.txt df -h
grab armazenamento.txt /proc/mounts

# temperatures, frequencies and battery
{
  readings /sys/class/thermal/thermal_zone*/type /sys/class/thermal/thermal_zone*/temp
  readings /sys/devices/system/cpu/cpufreq/policy*/scaling_governor \
    /sys/devices/system/cpu/cpufreq/policy*/scaling_cur_freq \
    /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq
  readings /sys/class/devfreq/*/cur_freq /sys/class/devfreq/*/governor
  readings /sys/class/power_supply/*/status /sys/class/power_supply/*/capacity \
    /sys/class/power_supply/*/current_now /sys/class/power_supply/*/voltage_now
} >"${DIR}/temperaturas.txt" 2>/dev/null

# emulators and cores
run emuladores.txt pacman -Q
{
  echo "### ${ROOT}/usr/lib/libretro"
  for src in "${ROOT}"/usr/lib/libretro/*_libretro.so; do
    [ -e "${src}" ] && echo "${src##*/}"
  done
} >>"${DIR}/emuladores.txt"

# configs (sanitized below)
mkdir -p "${DIR}/configs"
for src in /storage/.config/system/configs/system.cfg \
  /storage/.config/retroarch/retroarch.cfg \
  /storage/.config/retroarch/retroarch-core-options.cfg \
  /storage/.config/archr-launcher/launcher.toml \
  /storage/.config/archr/systems.cfg; do
  [ -f "${ROOT}${src}" ] && head -c "${CAP}" "${ROOT}${src}" >"${DIR}/configs/${src##*/}"
done

# logs: the last game, the launcher, pstore
mkdir -p "${DIR}/logs"
grab logs/exec.log /var/log/exec.log
grab logs/launcher.log /var/log/archr-launcher-session.log
grab logs/runemu-debug.log /var/log/runemu-debug.log
for src in "${ROOT}"/sys/fs/pstore/*; do
  [ -f "${src}" ] && mkdir -p "${DIR}/pstore" && head -c "${CAP}" "${src}" >"${DIR}/pstore/${src##*/}"
done

# Values of secret-looking names become <removed>, anywhere in a line.
# Names match in any case; the name and its separator are kept. A value
# is a quoted string or runs to the next blank, comma, semicolon or &.
sanitize() {
  awk '
    function cut(line, re,    lower, out) {
      out = ""
      lower = tolower(line)
      while (match(lower, re)) {
        out = out substr(line, 1, RSTART + RLENGTH - 1) "<removed>"
        line = substr(line, RSTART + RLENGTH)
        lower = substr(lower, RSTART + RLENGTH)
        if (match(lower, /^"[^"]*"?/) || match(lower, /^\047[^\047]*\047?/) ||
            match(lower, /^[^[:space:],;&]*/)) {
          line = substr(line, RLENGTH + 1)
          lower = substr(lower, RLENGTH + 1)
        }
      }
      return out line
    }
    {
      line = cut($0, "[a-z0-9_.-]*(pass|token|key|secret|login|auth|credential|cookie|session|psk)[a-z0-9_.-]*\"?[[:space:]]*[=:][[:space:]]*")
      print cut(line, "(scraper|screenscraper|cheevos|retroachievements)[a-z0-9_.-]*(user|name)[a-z0-9_.-]*\"?[[:space:]]*[=:][[:space:]]*")
    }'
}
while IFS= read -r -d '' f; do
  if grep -Iq . "${f}" 2>/dev/null; then
    sanitize <"${f}" >"${f}.clean" && mv -f "${f}.clean" "${f}"
  fi
done < <(find "${DIR}" -type f -print0)

mkdir -p "${OUT_DIR}" || exit 1
ZIP="${OUT_DIR}/${NAME}.zip"
rm -f "${ZIP}.part"
if ! (cd "${WORK}" && zip -q -r -9 "${ZIP}.part" "${NAME}" >&2) ||
  ! mv -f "${ZIP}.part" "${ZIP}"; then
  rm -f "${ZIP}.part"
  echo "archr-report: could not write ${ZIP}" >&2
  exit 1
fi
sync -f "${ZIP}" 2>/dev/null || :
echo "REPORT=${ZIP#"${ROOT}"}"
echo "SIZE=$(stat -c %s "${ZIP}")"
