# Backlight levels belong to archr-levels (2.2 gamma above a legible
# minimum, saved once they settle). Screen N is display.brightnessN.
#   brightness [screen]                     raw value of a screen (1 or 2)
#   brightness up|down [screen|all]         a 2 % step, prints the raw value
#   brightness set [screen|all] <percent>

DEVS=(/sys/class/backlight/*/brightness)
if [ ! -e "${DEVS[0]}" ]; then
  echo "ERROR: No backlight devices found in /sys/class/backlight/." >&2
  exit 1
fi

screen_ok() {
  if ! [[ "${1}" =~ ^[12]$ ]] || [ "${1}" -gt "${#DEVS[@]}" ]; then
    echo "ERROR: Screen number ${1} is out of range (1-$(( ${#DEVS[@]} < 2 ? ${#DEVS[@]} : 2 )))." >&2
    return 1
  fi
}

# level <op> <screen|all>
level() {
  local i first=1 last=$(( ${#DEVS[@]} < 2 ? ${#DEVS[@]} : 2 ))
  if [ "${2}" != all ]; then
    screen_ok "${2}" || return 1
    first=${2}
    last=${2}
  fi
  for ((i = first; i <= last; i++)); do
    archr-levels "brightness$([ "${i}" -gt 1 ] && echo "${i}")" "${1}" >/dev/null || return 1
  done
}

raw() {
  screen_ok "${1}" && cat "${DEVS[$((${1} - 1))]}"
}

case ${1} in
  up|down)
    level "$([ "${1}" = up ] && echo +2 || echo -2)" "${2:-all}" && raw "$([ "${2:-all}" = all ] && echo 1 || echo "${2}")"
    ;;
  set)
    if [ "$#" -eq 2 ]; then
      level "${2}" all && raw 1
    elif [ "$#" -ge 3 ]; then
      level "${3}" "${2}" && raw "$([ "${2}" = all ] && echo 1 || echo "${2}")"
    else
      echo "Usage: $0 set [screen_num|all] <percentage>" >&2
      exit 1
    fi
    ;;
  ""|[0-9]*)
    raw "${1:-1}"
    ;;
  *)
    echo "Usage: $0 {up|down|set} [screen_num|all] [percentage]" >&2
    exit 1
    ;;
esac
