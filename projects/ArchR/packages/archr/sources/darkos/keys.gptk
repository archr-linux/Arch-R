# Keyboard keys for the dialog menus of dArkOS tools (same mapping as
# dArkOS's /opt/inttools/keys.gptk, by Christian Haitian).
back = esc
start = enter
a = enter
b = backspace
b = repeat
l1 = pageup
r1 = pagedown
up = up
down = down
left = left
right = right
left_analog_up = up
left_analog_down = down
left_analog_left = left
left_analog_right = right
