[Unit]
Description=Report a crash or a freeze of the previous boot
RequiresMountsFor=/storage

# "boot" reports a panic kept in pstore, or a boot that never shut down,
# and marks this one; "shutdown", run as the unit stops at a clean
# shutdown, takes the mark away.
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/archr-error-report boot
ExecStop=/usr/bin/archr-error-report shutdown
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
