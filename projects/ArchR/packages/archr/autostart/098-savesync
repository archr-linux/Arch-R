# Save sync at boot (Settings › System › Save sync, "When the console
# starts"): brings what another console changed. In the background, as the
# Wi-Fi may still be coming up; archr-savesync waits for it a while.
. /etc/profile.d/001-functions

if [ "$(get_setting savesync.enabled)" = "1" ]; then
  setsid /usr/bin/archr-savesync sync --boot >/dev/null 2>&1 </dev/null &
fi
