# Minimal OS variable loading for performance
. /etc/profile.d/001-functions

tocon "Configuring display..."

# archr-levels owns the levels, their defaults and the one-time conversion
# of old values: re-apply what it holds, never a value read here (it could
# predate the conversion and be written back over it).
archr-levels brightness restore >/dev/null
set -- /sys/class/backlight/*
if [ $# -gt 1 ]; then
  archr-levels brightness2 restore >/dev/null
fi
