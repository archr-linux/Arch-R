[Unit]
Description=Boot trace on the boot partition (/flash/boot-trace.log)
# Opt-in: only while /flash/archr-trace exists, an empty file the user
# creates on the boot partition from a PC. No ordering: it watches the
# boot from its start and holds nothing back.
DefaultDependencies=no
ConditionPathExists=/flash/archr-trace

[Service]
Type=simple
ExecStart=/usr/bin/archr-boot-trace
TimeoutStopSec=5

[Install]
WantedBy=archr.target
