[Unit]
Description=ArchR critical and low battery guard
RequiresMountsFor=/storage
After=archr-automount.service
ConditionPathExists=/sys/class/power_supply/battery/capacity

[Service]
Environment=HOME=/storage
ExecStart=/usr/bin/archr-battery-guard
Restart=on-failure
RestartSec=5
# A stop or restart ends the guard script only: a game save it started
# before powering off runs to its end (the next guard sees the battery
# again and powers off then).
KillMode=process

[Install]
WantedBy=multi-user.target
