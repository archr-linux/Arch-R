 int rwnx_cfg80211_set_monitor_channel_(struct wiphy *wiphy,
                                              struct net_device *dev,
                                              struct cfg80211_chan_def *chandef)
@@ -4714,7 +4714,7 @@
     if (rwnx_vif->vif_index == rwnx_hw->monitor_vif)
