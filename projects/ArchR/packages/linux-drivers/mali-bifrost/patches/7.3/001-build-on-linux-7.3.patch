diff --git a/product/kernel/include/linux/version_compat_defs.h b/product/kernel/include/linux/version_compat_defs.h
index 7b75ee7..68fb2b2 100644
--- a/product/kernel/include/linux/version_compat_defs.h
+++ b/product/kernel/include/linux/version_compat_defs.h
@@ -642,7 +642,10 @@ static inline unsigned long
 kbase_mm_get_unmapped_area_helper(struct mm_struct *mm, struct file *filp, unsigned long addr,
 				  unsigned long len, unsigned long pgoff, unsigned long flags)
 {
-#if (KERNEL_VERSION(6, 10, 0) <= LINUX_VERSION_CODE)
+#if (KERNEL_VERSION(6, 17, 0) <= LINUX_VERSION_CODE)
+	(void)mm;
+	return mm_get_unmapped_area(filp, addr, len, pgoff, flags);
+#elif (KERNEL_VERSION(6, 10, 0) <= LINUX_VERSION_CODE)
 	return mm_get_unmapped_area(mm, filp, addr, len, pgoff, flags);
 #else
 	return mm->get_unmapped_area(filp, addr, len, pgoff, flags);
@@ -665,4 +668,19 @@ static unsigned long __maybe_unused regs_get_kernel_argument(struct pt_regs *reg
 }
 #endif
 
+#if (KERNEL_VERSION(6, 15, 0) <= LINUX_VERSION_CODE)
+#define del_timer(t) timer_delete(t)
+#define del_timer_sync(t) timer_delete_sync(t)
+#endif
+
+#if (KERNEL_VERSION(6, 17, 0) <= LINUX_VERSION_CODE)
+/* Only in-tree page types can be movable_ops pages now: kbase cannot mark
+ * its pages movable, so page migration stays off (see
+ * kbase_mem_migrate_init) and these never run.
+ */
+#define KBASE_NO_PAGE_MIGRATION 1
+#define __SetPageMovable(p, ops) do { (void)(p); (void)(ops); } while (0)
+#define __ClearPageMovable(p) do { (void)(p); } while (0)
+#endif
+
