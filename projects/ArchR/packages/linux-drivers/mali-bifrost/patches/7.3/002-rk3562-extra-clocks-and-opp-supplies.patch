+	for (i = 0; i < max_t(unsigned int, 1, kbdev->nr_regulators); i++) {
 		kbdev->clocks[i] = of_clk_get(kbdev->dev->of_node, (int)i);
 		if (IS_ERR(kbdev->clocks[i])) {
 			err = PTR_ERR(kbdev->clocks[i]);
@@ -4647,6 +4699,16 @@ int power_control_init(struct kbase_device *kbdev)
 	kbdev->nr_clocks = i;
 	dev_dbg(&pdev->dev, "Clocks probed: %u\n", kbdev->nr_clocks);
 
+	if (kbase_extra_clocks_init(kbdev, kbdev->nr_clocks) == -EPROBE_DEFER) {
+		while (i > 0) {
+			clk_disable_unprepare(kbdev->clocks[--i]);
+			clk_put(kbdev->clocks[i]);
+			kbdev->clocks[i] = NULL;
