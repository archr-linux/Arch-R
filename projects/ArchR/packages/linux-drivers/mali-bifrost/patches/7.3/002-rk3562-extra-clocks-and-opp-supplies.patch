Scale the SCMI GPU clock, keep the other GPU clocks on, and give the
OPP core a terminated list

The RK3562 GPU node lists the SCMI clock "clk_mali" and the CRU clocks
clk_gpu, clk_gpu_brg and aclk_gpu. On the RK3562 the GPU rate is set by
the firmware through SCMI (it owns the GPU PLL); the CRU clk_gpu is only
a gate of clk_gpu_pre, a gpll/cpll divider that tops out at 594 MHz, so
scaling it left the GPU at 594 MHz whatever devfreq asked for.

Scale one clock per regulator (at least one): the one named "clk_mali"
when the node has it, the first ones otherwise. Keep every other listed
clock prepared and enabled while the driver is bound, as the panfrost
patch 013 does for the same node; before this kbase also took the
bridge clock as a scaled clock and never enabled aclk_gpu, which
clk_disable_unused then gated.

dev_pm_opp_set_regulators() expects a NULL-terminated list; kbase passed
its two-entry name table, read past its end and asked for a
"shadercores" supply this board does not have. Pass only the supplies
that were found.

diff --git a/product/kernel/drivers/gpu/arm/midgard/mali_kbase_core_linux.c b/product/kernel/drivers/gpu/arm/midgard/mali_kbase_core_linux.c
index def8580..7a9d3e1 100644
--- a/product/kernel/drivers/gpu/arm/midgard/mali_kbase_core_linux.c
+++ b/product/kernel/drivers/gpu/arm/midgard/mali_kbase_core_linux.c
@@ -4560,6 +4560,63 @@ void kbase_device_backend_term(struct kbase_device *kbdev)
 	kbase_arbiter_pm_early_term(kbdev);
 }
 
+static void kbase_extra_clocks_term(struct kbase_device *kbdev)
+{
+	while (kbdev->nr_extra_clocks > 0) {
+		struct clk *clk = kbdev->extra_clocks[--kbdev->nr_extra_clocks];
+
+		clk_disable_unprepare(clk);
+		clk_put(clk);
+		kbdev->extra_clocks[kbdev->nr_extra_clocks] = NULL;
+	}
+}
+
+#ifdef CONFIG_OF
+/* The device tree can list more clocks than kbase scales: on the RK3562
+ * the GPU node has the SCMI "clk_mali" clock, whose rate the firmware
+ * sets (it owns the GPU PLL), plus the CRU core, bridge and AXI gates.
+ * Those gates are not frequency-scaled; keep them prepared and enabled
+ * while the driver is bound, or clk_disable_unused gates the GPU bus.
+ * Clocks @first..@first + @count - 1 are the scaled ones and skipped.
+ */
+static int kbase_extra_clocks_init(struct kbase_device *kbdev, unsigned int first,
+				   unsigned int count)
+{
+	unsigned int i;
+	int err;
+
+	kbdev->nr_extra_clocks = 0;
+	for (i = 0; kbdev->nr_extra_clocks < ARRAY_SIZE(kbdev->extra_clocks); i++) {
+		struct clk *clk;
+
+		if (i >= first && i < first + count)
+			continue;
+
+		clk = of_clk_get(kbdev->dev->of_node, (int)i);
+
+		if (IS_ERR(clk)) {
+			err = PTR_ERR(clk);
+			if (err == -EPROBE_DEFER)
+				goto fail;
+			return 0;
+		}
+
+		err = clk_prepare_enable(clk);
+		if (err) {
+			dev_err(kbdev->dev, "Failed to enable extra clock %u (%d)\n", i, err);
+			clk_put(clk);
+			goto fail;
+		}
+		kbdev->extra_clocks[kbdev->nr_extra_clocks++] = clk;
+	}
+	return 0;
+
+fail:
+	kbase_extra_clocks_term(kbdev);
+	return err;
+}
+#endif
+
