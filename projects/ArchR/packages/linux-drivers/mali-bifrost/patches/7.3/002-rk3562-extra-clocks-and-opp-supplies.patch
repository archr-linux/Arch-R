Keep the extra GPU clocks on and give the OPP core a terminated list

The RK3562 GPU node lists three clocks: clk_gpu, clk_gpu_brg and
aclk_gpu. kbase took the first two as frequency-scaled clocks, so
devfreq would set the 200/100 MHz bridge clock to the GPU rate, and it
never enabled aclk_gpu, which clk_disable_unused then gates. Scale only
the clocks that have a regulator (at least one) and keep the rest
prepared and enabled while the driver is bound, as the panfrost patch
013 does for the same node.

dev_pm_opp_set_regulators() expects a NULL-terminated list; kbase passed
its two-entry name table, read past its end and asked for a
"shadercores" supply this board does not have. Pass only the supplies
that were found.

diff --git a/product/kernel/drivers/gpu/arm/midgard/mali_kbase_core_linux.c b/product/kernel/drivers/gpu/arm/midgard/mali_kbase_core_linux.c
index def8580..9eef7e2 100644
--- a/product/kernel/drivers/gpu/arm/midgard/mali_kbase_core_linux.c
+++ b/product/kernel/drivers/gpu/arm/midgard/mali_kbase_core_linux.c
@@ -4560,6 +4560,55 @@ void kbase_device_backend_term(struct kbase_device *kbdev)
 	kbase_arbiter_pm_early_term(kbdev);
 }
 
+static void kbase_extra_clocks_term(struct kbase_device *kbdev)
+{
+	while (kbdev->nr_extra_clocks > 0) {
+		struct clk *clk = kbdev->extra_clocks[--kbdev->nr_extra_clocks];
+
+		clk_disable_unprepare(clk);
+		clk_put(clk);
+		kbdev->extra_clocks[kbdev->nr_extra_clocks] = NULL;
+	}
+}
+
+#ifdef CONFIG_OF
+/* The device tree can list more clocks than kbase scales: on the RK3562
+ * the GPU node has the core clock plus the bridge and AXI clocks. Those
+ * are not frequency-scaled; keep them prepared and enabled while the
+ * driver is bound, or clk_disable_unused gates the GPU bus.
+ */
+static int kbase_extra_clocks_init(struct kbase_device *kbdev, unsigned int first)
+{
+	unsigned int i;
+	int err;
+
+	kbdev->nr_extra_clocks = 0;
+	for (i = first; kbdev->nr_extra_clocks < ARRAY_SIZE(kbdev->extra_clocks); i++) {
+		struct clk *clk = of_clk_get(kbdev->dev->of_node, (int)i);
+
+		if (IS_ERR(clk)) {
+			err = PTR_ERR(clk);
+			if (err == -EPROBE_DEFER)
+				goto fail;
+			return 0;
+		}
+
+		err = clk_prepare_enable(clk);
+		if (err) {
+			dev_err(kbdev->dev, "Failed to enable extra clock %u (%d)\n", i, err);
+			clk_put(clk);
+			goto fail;
+		}
+		kbdev->extra_clocks[kbdev->nr_extra_clocks++] = clk;
+	}
+	return 0;
+
+fail:
+	kbase_extra_clocks_term(kbdev);
+	return err;
+}
+#endif
+
 int power_control_init(struct kbase_device *kbdev)
 {
 #ifndef CONFIG_OF
@@ -4621,7 +4670,10 @@ int power_control_init(struct kbase_device *kbdev)
 	 * Any other error is ignored and the driver will continue
 	 * operating with a partial initialization of clocks.
 	 */
-	for (i = 0; i < BASE_MAX_NR_CLOCKS_REGULATORS; i++) {
