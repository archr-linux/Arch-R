+		for (i = 0; i < kbdev->nr_regulators; i++)
+			names[i] = regulator_names[i];
+		kbdev->token = dev_pm_opp_set_regulators(kbdev->dev, names);
 
 		if (kbdev->token < 0) {
 			err = kbdev->token;
@@ -4683,6 +4752,7 @@ int power_control_init(struct kbase_device *kbdev)
 #if defined(CONFIG_PM_OPP) && \
 	((KERNEL_VERSION(4, 10, 0) <= LINUX_VERSION_CODE) && defined(CONFIG_REGULATOR))
 regulators_probe_defer:
+	kbase_extra_clocks_term(kbdev);
 	for (i = 0; i < BASE_MAX_NR_CLOCKS_REGULATORS; i++) {
 		if (kbdev->clocks[i]) {
 			if (__clk_is_enabled(kbdev->clocks[i]))
@@ -4720,6 +4790,8 @@ void power_control_term(struct kbase_device *kbdev)
