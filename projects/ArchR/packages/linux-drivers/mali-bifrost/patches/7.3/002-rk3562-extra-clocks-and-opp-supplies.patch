-	for (i = 0; i < BASE_MAX_NR_CLOCKS_REGULATORS; i++) {
-		kbdev->clocks[i] = of_clk_get(kbdev->dev->of_node, (int)i);
+	/* Only clocks paired with a regulator are scaled (at least one);
+	 * the rest are bus clocks, see kbase_extra_clocks_init(). A clock
+	 * named "clk_mali" (Rockchip: the SCMI GPU clock) is the one that
+	 * sets the GPU rate, wherever it sits in the list.
+	 */
+	nr_scaled = max_t(unsigned int, 1, kbdev->nr_regulators);
+	mali_clock = of_property_match_string(kbdev->dev->of_node, "clock-names", "clk_mali");
+	if (mali_clock >= 0) {
+		first_clock = (unsigned int)mali_clock;
+		nr_scaled = 1;
+	}
+	for (i = 0; i < nr_scaled; i++) {
+		kbdev->clocks[i] = of_clk_get(kbdev->dev->of_node, (int)(first_clock + i));
 		if (IS_ERR(kbdev->clocks[i])) {
 			err = PTR_ERR(kbdev->clocks[i]);
 			kbdev->clocks[i] = NULL;
@@ -4647,6 +4718,16 @@ int power_control_init(struct kbase_device *kbdev)
 	kbdev->nr_clocks = i;
 	dev_dbg(&pdev->dev, "Clocks probed: %u\n", kbdev->nr_clocks);
 
+	if (kbase_extra_clocks_init(kbdev, first_clock, kbdev->nr_clocks) == -EPROBE_DEFER) {
+		while (i > 0) {
