From: ArchR <noreply@arch-r.io>
Subject: [PATCH] 8188eu: a connect is never reported done without its BSS

rtw_cfg80211_indicate_connect() looks the BSS up and hands it to
cfg80211_connect_bss() as a success even when the lookup came back
empty (the entry expired while associating). cfg80211 then fails its
own lookup, WARNs (bss_not_found) and is left half connected; on an
R36S with a 0bda:8179 dongle that ended in a use-after-free (LIST_POISON)
in __cfg80211_connect_result. Tell cfg80211 the BSS again; still
without one, report a failed connect so the supplicant retries.
---
--- a/os_dep/linux/ioctl_cfg80211.c	2026-11-26 22:32:41.792631187 -0300
+++ b/os_dep/linux/ioctl_cfg80211.c	2026-11-26 22:32:41.807618040 -0300
@@ -1147,12 +1147,27 @@
                         struct cfg80211_bss *bss;
                         bss = cfg80211_get_bss(pwdev->wiphy, NULL, cur_network->network.MacAddress, NULL, 0, 
                                 IEEE80211_BSS_TYPE_ANY, IEEE80211_PRIVACY_ANY);
+                        /* The BSS can be gone from cfg80211's list (expired
+                         * while associating): tell it again. A success
+                         * without one leaves cfg80211 half connected
+                         * (WARN bss_not_found, then a crash in
+                         * __cfg80211_connect_result); report a failure
+                         * instead and the supplicant tries again. */
+                        if (!bss) {
+                                rtw_cfg80211_inform_bss(padapter, cur_network);
+                                bss = cfg80211_get_bss(pwdev->wiphy, NULL, cur_network->network.MacAddress, NULL, 0,
+                                        IEEE80211_BSS_TYPE_ANY, IEEE80211_PRIVACY_ANY);
+                        }
+                        if (bss)
                         cfg80211_connect_bss(wdev_to_ndev(pwdev), cur_network->network.MacAddress, bss
                                 , pmlmepriv->assoc_req + sizeof(struct rtw_ieee80211_hdr_3addr) + 2
                                 , pmlmepriv->assoc_req_len - sizeof(struct rtw_ieee80211_hdr_3addr) - 2
                                 , pmlmepriv->assoc_rsp + sizeof(struct rtw_ieee80211_hdr_3addr) + 6
                                 , pmlmepriv->assoc_rsp_len - sizeof(struct rtw_ieee80211_hdr_3addr) - 6
                                 , WLAN_STATUS_SUCCESS, GFP_ATOMIC, NL80211_TIMEOUT_UNSPECIFIED);
+                        else
+                                rtw_cfg80211_connect_result(pwdev, cur_network->network.MacAddress,
+                                        NULL, 0, NULL, 0, WLAN_STATUS_UNSPECIFIED_FAILURE, GFP_ATOMIC);
                 }
 		#if defined(RHEL79) && (LINUX_VERSION_CODE < KERNEL_VERSION(3, 11, 0) || defined(COMPAT_KERNEL_RELEASE))
 		RTW_INFO("pwdev->sme_state(a)=%d\n", pwdev->sme_state);
