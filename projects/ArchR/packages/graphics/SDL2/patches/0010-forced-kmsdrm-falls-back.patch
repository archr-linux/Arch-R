+/* ArchR: ports made for ArkOS/dArkOS force SDL_VIDEODRIVER=kmsdrm, but
+ * ArchR runs every game inside sway, which holds the display: kmsdrm cannot
+ * start there and the game quits with "kmsdrm not available". A forced
+ * kmsdrm takes the normal driver order instead when a Wayland session is
+ * there or kmsdrm does not start. ARCHR_SDL_KMSDRM=1 keeps it forced. */
+static SDL_bool ArchR_KMSDRMForced(const char *name)
+{
+    const char *keep = SDL_getenv("ARCHR_SDL_KMSDRM");
+
+    return (name && SDL_strcasecmp(name, "kmsdrm") == 0 &&
+            !(keep && SDL_strcmp(keep, "1") == 0)) ? SDL_TRUE : SDL_FALSE;
+}
