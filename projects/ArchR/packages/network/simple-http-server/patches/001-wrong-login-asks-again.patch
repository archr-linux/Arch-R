+// A 401 without WWW-Authenticate is final for a browser: after a wrong
+// user or password it showed the error and never asked again.
+fn wrong_login() -> Response {
+    let mut response = text_response(StatusCode::UNAUTHORIZED, "Wrong username or password.");
+    response.headers_mut().insert(
+        header::WWW_AUTHENTICATE,
+        HeaderValue::from_static("Basic realm=\"main\""),
+    );
+    response
+}
