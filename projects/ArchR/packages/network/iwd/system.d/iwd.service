[Unit]
Description=Wireless service
Documentation=man:iwd(8) man:iwd.config(5) man:iwd.network(5) man:iwd.ap(5)
After=network-pre.target
RequiresMountsFor=/storage
Before=network.target
Wants=network.target

[Service]
# The card's folder itself, not the /var/lib/iwd link to it: iwd watches its
# state directory with IN_ONLYDIR|IN_DONT_FOLLOW, which fails on a link, and a
# profile written while iwd runs (a network joined from Settings, the boot's
# rejoin of the saved one) then stayed unseen until iwd restarted ("No Agent
# registered"). /var/lib/iwd still links here for everything else.
Environment=STATE_DIRECTORY=/storage/.cache/iwd
Type=dbus
BusName=net.connman.iwd
ExecStart=/usr/lib/iwd
NotifyAccess=main
LimitNPROC=1
Restart=on-failure
# iwd quits 1 s after SIGTERM (iwd_shutdown's l_timeout), so a 1 s stop
# timeout raced it: a stop (Wi-Fi off, shutdown) ended in SIGKILL and a
# failed unit, which sent an error report.
TimeoutStopSec=3s
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
#PrivateTmp=true
#NoNewPrivileges=true
DevicePolicy=closed
DeviceAllow=/dev/rfkill rw
#ProtectHome=yes
#ProtectSystem=strict
#ProtectControlGroups=yes
#ProtectKernelModules=yes
#ConfigurationDirectory=iwd
#StateDirectory=iwd
#StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
