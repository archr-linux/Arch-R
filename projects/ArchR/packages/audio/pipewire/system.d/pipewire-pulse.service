[Unit]
Description=PipeWire PulseAudio Service
Requires=pipewire-pulse.socket
After=pipewire.service wireplumber.service
RequiresMountsFor=/storage

[Service]
User=root
Type=simple
ExecStart=/usr/bin/pipewire-pulse
Restart=on-failure
RuntimeDirectory=pipewire
RuntimeDirectoryPreserve=yes
ExecStartPre=/bin/mkdir -p /run/0-runtime-dir/pulse
Environment=PIPEWIRE_RUNTIME_DIR=%t/pipewire
# Same directory as /var/run/0-runtime-dir everywhere else, spelled the way
# pipewire-pulse.socket listens, so the server adopts that socket.
Environment=XDG_RUNTIME_DIR=/run/0-runtime-dir
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket
Environment=HOME=/storage
# Environment=PIPEWIRE_DEBUG=4

[Install]
Also=pipewire-pulse.socket
WantedBy=default.target
