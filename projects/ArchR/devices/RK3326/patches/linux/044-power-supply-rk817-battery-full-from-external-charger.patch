From: Douglas Teles <dga.teles@gmail.com>
Date: Thu, 12 Nov 2026 12:30:00 -0300
Subject: [PATCH] power: supply: rk817-battery: calibrate full from an
 external charger

R36S and its clones charge the pack through a separate charger IC, so
the RK817 never reaches CHARGE_FINISH and the full-charge calibration
never runs. The rested voltage pair, the only other correction, is
dropped above voltage-max-design (4.1 V), while a full pack rests at
4.18 V. A counter that started low (charged while off, a deep
discharge) then stays low for good: users see 0% on a full battery,
and 0% at 3.85 V once it runs down (issue 50).

Take two signals the board does give:
- accept a relax pair up to the charge voltage; above the ocv table it
  reads 100%;
- with the RK817 charger off and unplugged, the pack held within 50 mV
  of the charge voltage while taking no more than the termination
  current, for a minute of polls, is a finished charge: set the counter
  full once per hold. On battery the current is negative, so it never
  fires there, and boards charged by the RK817 itself keep its own
  CHARGE_FINISH path.

Signed-off-by: Douglas Teles <dga.teles@gmail.com>
---
--- a/drivers/power/supply/rk817_charger.c
+++ b/drivers/power/supply/rk817_charger.c
@@ -105,6 +105,9 @@
 	/* Retained for the ocv-capacity table the recalibration needs. */
 	struct power_supply_battery_info *bat_info;
 
+	/* Polls in a row an external charger has held the pack full. */
+	int ext_full_polls;
+
 	/* Stamped at system suspend to correct the gauge across sleep. */
 	time64_t slp_boottime;
 	int slp_charge_uah;
@@ -366,7 +369,7 @@
 				      bool live_only)
 {
 	unsigned int need = RK817_RELAX_VOL_UPD;
-	int ret, sts, vol;
+	int ret, sts, vol, max_uv;
 
 	if (live_only)
 		need |= RK817_RELAX_STS;
@@ -378,8 +381,17 @@
 	vol = max(rk817_bat_voltage_uv(charger, RK817_GAS_GAUGE_RELAX_VOL1_H),
 		  rk817_bat_voltage_uv(charger, RK817_GAS_GAUGE_RELAX_VOL2_H));
 
-	if (vol < charger->bat_voltage_min_design_uv ||
-	    vol > charger->bat_voltage_max_design_uv)
+	/*
+	 * A full pack rests between the design maximum and the charge
+	 * voltage (4.18 V on an R36S rated 4.1 V): that pair reads 100%,
+	 * and it is the only one that can correct a counter left low.
+	 */
+	max_uv = charger->bat_voltage_max_design_uv;
+	if (charger->bat_info)
+		max_uv = max(max_uv,
+			     charger->bat_info->constant_charge_voltage_max_uv);
+
+	if (vol < charger->bat_voltage_min_design_uv || vol > max_uv)
 		return 0;
 
 	return vol;
@@ -856,6 +868,57 @@
 	rk817_record_battery_nvram_values(charger);
 }
 
+/* A minute of 2 second polls, as long as the gauge's own averaging. */
+#define RK817_EXT_FULL_POLLS		30
+/* Under the charge voltage by at most this much counts as held there. */
+#define RK817_EXT_FULL_MARGIN_UV	50000
+
+/*
+ * Boards that charge through a separate charger IC (R36S and clones) never
+ * reach CHARGE_FINISH, so the full-charge calibration never runs, and a
+ * counter that started low (charged while off, or after a deep discharge)
+ * stays low: 0% on a full pack. The external charger holding the pack at
+ * its charge voltage, taking no more than the termination current, is a
+ * finished charge too: set the counter full once per such hold. On battery
+ * the current is always negative, so this never fires there.
+ */
+static void rk817_bat_ext_full(struct rk817_charger *charger)
+{
+	struct rk808 *rk808 = charger->rk808;
+	struct power_supply_battery_info *info = charger->bat_info;
+	u8 bulk_reg[4];
+	int tmp;
+
+	if (!info || !charger->battery_present || charger->plugged_in ||
+	    charger->charge_status != CHRG_OFF ||
+	    charger->cur_avg_ua < 0 ||
+	    charger->cur_avg_ua > info->charge_term_current_ua ||
+	    charger->volt_avg_uv < info->constant_charge_voltage_max_uv -
+				   RK817_EXT_FULL_MARGIN_UV) {
+		charger->ext_full_polls = 0;
+		return;
+	}
+
+	/* Already done for this hold. */
+	if (charger->ext_full_polls >= RK817_EXT_FULL_POLLS)
+		return;
+	if (++charger->ext_full_polls < RK817_EXT_FULL_POLLS)
+		return;
+	if (charger->soc >= 100000)
+		return;
+
+	dev_info(charger->dev,
+		 "external charger holds %d uV at %d uA: counter set full (soc %d -> 100000)\n",
+		 charger->volt_avg_uv, charger->cur_avg_ua, charger->soc);
+	charger->soc = 100000;
+	charger->charge_now_uah = charger->fcc_mah * 1000;
+	tmp = CHARGE_TO_ADC(charger->fcc_mah, charger->res_div);
+	put_unaligned_be32(tmp, bulk_reg);
+	regmap_bulk_write(rk808->regmap, RK817_GAS_GAUGE_Q_INIT_H3,
+			  bulk_reg, 4);
+	rk817_record_battery_nvram_values(charger);
+}
+
 static int
 rk817_read_or_set_full_charge_on_boot(struct rk817_charger *charger,
 				struct power_supply_battery_info *bat_info)
@@ -1144,6 +1207,7 @@
 
 	rk817_read_props(charger);
 	rk817_bat_ocv_recalibrate(charger);
+	rk817_bat_ext_full(charger);
 
 	/* Every 2 seconds, so charger plug/unplug shows up promptly. */
 	queue_delayed_work(system_wq, &charger->work, msecs_to_jiffies(2000));
@@ -1411,6 +1475,9 @@
 				(charger->charge_status == CC_OR_CV_CHRG ||
 				 charger->charge_status == TRICKLE_CHRG);
 
+	/* A hold has to be seen again, in real time, after the sleep. */
+	charger->ext_full_polls = 0;
+
 	/* Any relax pair found at resume will postdate this suspend. */
 	regmap_write_bits(charger->rk808->regmap, RK817_GAS_GAUGE_GG_STS,
 			  RK817_RELAX_VOL_UPD, 0);
