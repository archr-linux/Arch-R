From 446c837aa2e959fec1b7f32ed336e8772cceeee7 Mon Sep 17 00:00:00 2001
From: Jacob Cook <jacobmcook1984@gmail.com>
Date: Fri, 2 Oct 2026 19:50:04 -0400
Subject: [PATCH] mmc: core: Retry a failed SD card resume after a power cycle


---
diff --git a/drivers/mmc/core/sd.c b/drivers/mmc/core/sd.c
--- a/drivers/mmc/core/sd.c
+++ b/drivers/mmc/core/sd.c
@@ -1420,12 +1420,13 @@
 	u32 cid[4];
 	u32 rocr = 0;
 	bool v18_fixup_failed = false;
+	bool resume_retried = false;
 
 	WARN_ON(!host->claimed);
 retry:
 	err = mmc_sd_get_cid(host, ocr, cid, &rocr);
 	if (err)
-		return err;
+		goto resume_retry;
 
 	if (oldcard) {
 		if (memcmp(cid, oldcard->raw_cid, sizeof(cid)) != 0) {
@@ -1598,6 +1599,14 @@
 free_card:
 	if (!oldcard)
 		mmc_remove_card(card);
+resume_retry:
+	if (oldcard && mmc_card_suspended(oldcard) && !resume_retried) {
+		resume_retried = true;
+		pr_warn("%s: resume failed (%d), retrying after a power cycle\n",
+			mmc_hostname(host), err);
+		mmc_power_cycle(host, ocr);
+		goto retry;
+	}
 
 	return err;
 }
