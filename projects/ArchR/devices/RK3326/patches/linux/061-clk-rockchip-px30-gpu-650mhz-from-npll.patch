From: Douglas Teles <dga.teles@gmail.com>
Date: Mon, 23 Nov 2026 09:00:00 -0300
Subject: [PATCH] clk: rockchip: px30: let the GPU run at 650MHz from npll

The Mali-G31 is rated for 650MHz, but clk_gpu only ever divided gpll
(1200MHz): 650 ran at 600. npll is free on these boards (it only feeds
vopl, which none enables), so the DT sets it to 1300MHz and the GPU's
dividers may now ask their source for the PLL that makes the rate:
650 = npll/2, 600 = gpll/2, 480 = gpll/2.5. cpll (the panel's) and
usb480m (gone when the USB PHY sleeps) are kept out of the GPU's mux.
Adds 1300MHz to the PLL table.
---
--- a/drivers/clk/rockchip/clk-px30.c	2026-11-23 08:46:14.007054184 -0300
+++ b/drivers/clk/rockchip/clk-px30.c	2026-11-23 08:46:14.022476095 -0300
@@ -38,6 +38,7 @@
 	RK3036_PLL_RATE(1368000000, 1, 57, 1, 1, 1, 0),
 	RK3036_PLL_RATE(1344000000, 1, 56, 1, 1, 1, 0),
 	RK3036_PLL_RATE(1320000000, 1, 55, 1, 1, 1, 0),
+	RK3036_PLL_RATE(1300000000, 6, 325, 1, 1, 1, 0),
 	RK3036_PLL_RATE(1296000000, 1, 54, 1, 1, 1, 0),
 	RK3036_PLL_RATE(1272000000, 1, 53, 1, 1, 1, 0),
 	RK3036_PLL_RATE(1248000000, 1, 52, 1, 1, 1, 0),
@@ -182,6 +183,12 @@
 PNAME(mux_usbphy_ref_p)		= { "xin24m", "clk_ref24m_pmu" };
 PNAME(mux_mipidsiphy_ref_p)	= { "xin24m", "clk_ref24m_pmu" };
 PNAME(mux_gpu_p)		= { "clk_gpu_div", "clk_gpu_np5" };
+/*
+ * The GPU's source: gpll, or npll (set to 1300MHz in the DT, for 650MHz).
+ * cpll and usb480m are left out: cpll feeds the panel, usb480m comes and
+ * goes with the USB PHY.
+ */
+PNAME(mux_gpu_src_p)		= { "gpll", "dummy_cpll", "dummy_usb480m", "npll" };
 
 static struct rockchip_pll_clock px30_pll_clks[] __initdata = {
 	[apll] = PLL(pll_rk3328, PLL_APLL, "apll", mux_pll_p,
@@ -304,13 +311,14 @@
 			PX30_CLKGATE_CON(17), 4, GFLAGS),
 
 	/* PD_GPU */
-	COMPOSITE_NODIV(0, "clk_gpu_src", mux_4plls_p, 0,
+	COMPOSITE_NODIV(0, "clk_gpu_src", mux_gpu_src_p, 0,
 			PX30_CLKSEL_CON(1), 6, 2, MFLAGS,
 			PX30_CLKGATE_CON(0), 8, GFLAGS),
-	COMPOSITE_NOMUX(0, "clk_gpu_div", "clk_gpu_src", 0,
+	/* Rate parent: a GPU rate picks the PLL as well as the divider. */
+	COMPOSITE_NOMUX(0, "clk_gpu_div", "clk_gpu_src", CLK_SET_RATE_PARENT,
 			PX30_CLKSEL_CON(1), 0, 4, DFLAGS,
 			PX30_CLKGATE_CON(0), 12, GFLAGS),
-	COMPOSITE_NOMUX_HALFDIV(0, "clk_gpu_np5", "clk_gpu_src", 0,
+	COMPOSITE_NOMUX_HALFDIV(0, "clk_gpu_np5", "clk_gpu_src", CLK_SET_RATE_PARENT,
 			PX30_CLKSEL_CON(1), 8, 4, DFLAGS,
 			PX30_CLKGATE_CON(0), 9, GFLAGS),
 	COMPOSITE_NODIV(SCLK_GPU, "clk_gpu", mux_gpu_p, CLK_SET_RATE_PARENT,
