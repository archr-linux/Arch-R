From: Douglas Teles <dga.teles@gmail.com>
Date: Thu, 29 Oct 2026 18:30:00 -0300
Subject: [PATCH] input: polldev: poll on a high-priority freezable workqueue

The RK3326 handheld joypads (odroidgo2/3, rgb20s, xu10, gameforce) poll
the SARADC and GPIOs through input-polldev, which queued the work on
system_freezable_wq. Its kworkers run at nice 0 and compete with the
emulator threads for the four cores, so a poll can start late and the
input latency gains jitter on top of the poll interval.

Queue the poll work on a dedicated WQ_HIGHPRI | WQ_FREEZABLE workqueue.
Its kworkers run at nice -20, and freezing keeps the old suspend
behaviour. Fall back to system_freezable_wq if the queue cannot be
allocated.

--- a/drivers/input/input-polldev.c
+++ b/drivers/input/input-polldev.c
@@ -18,6 +18,13 @@
 MODULE_DESCRIPTION("Generic implementation of a polled input device");
 MODULE_LICENSE("GPL v2");
 
+/*
+ * Polled game controls are latency sensitive: run the poll work on a
+ * high-priority queue so it does not wait behind the emulator on a
+ * nice-0 kworker. The queue stays freezable like system_freezable_wq.
+ */
+static struct workqueue_struct *input_polldev_wq;
+
 static void input_polldev_queue_work(struct input_polled_dev *dev)
 {
 	unsigned long delay;
@@ -26,7 +33,8 @@
 	if (delay >= HZ)
 		delay = round_jiffies_relative(delay);
 
-	queue_delayed_work(system_freezable_wq, &dev->work, delay);
+	queue_delayed_work(input_polldev_wq ?: system_freezable_wq,
+			   &dev->work, delay);
 }
 
 static void input_polled_device_work(struct work_struct *work)
@@ -360,3 +368,20 @@
 	input_unregister_device(dev->input);
 }
 EXPORT_SYMBOL(input_unregister_polled_device);
+
+static int __init input_polldev_init(void)
+{
+	input_polldev_wq = alloc_workqueue("input_polldev",
+					   WQ_HIGHPRI | WQ_FREEZABLE, 0);
+	if (!input_polldev_wq)
+		pr_warn("falling back to system_freezable_wq\n");
+	return 0;
+}
+subsys_initcall(input_polldev_init);
+
+static void __exit input_polldev_exit(void)
+{
+	if (input_polldev_wq)
+		destroy_workqueue(input_polldev_wq);
+}
+module_exit(input_polldev_exit);
