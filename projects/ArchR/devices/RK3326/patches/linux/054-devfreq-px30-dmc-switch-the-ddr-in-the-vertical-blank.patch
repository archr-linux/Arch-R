+	px30_dmc_display_unlock();
 
 	/*
 	 * If we have a GAMMA LUT in the state, then let's make sure
--- a/drivers/gpu/drm/rockchip/rockchip_vop_reg.c
+++ b/drivers/gpu/drm/rockchip/rockchip_vop_reg.c
@@ -262,6 +262,8 @@
 	.intrs = px30_vop_intrs,
 	.nintrs = ARRAY_SIZE(px30_vop_intrs),
 	.line_flag_num[0] = VOP_REG(PX30_LINE_FLAG, 0xfff, 0),
+	/* BL31 switches the DDR rate at this one */
+	.line_flag_num[1] = VOP_REG(PX30_LINE_FLAG, 0xfff, 16),
 	.status = VOP_REG_MASK_SYNC(PX30_INTR_STATUS, 0xffff, 0),
 	.enable = VOP_REG_MASK_SYNC(PX30_INTR_EN, 0xffff, 0),
 	.clear = VOP_REG_MASK_SYNC(PX30_INTR_CLEAR, 0xffff, 0),
--- /dev/null
+++ b/include/soc/rockchip/px30_dmc.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * What the PX30 DDR rate driver needs from the display: BL31 switches the
+ * DDR inside the vertical blank when it knows a screen is being scanned out,
+ * and a switch must not land in the middle of a mode set.
+ */
+#ifndef __SOC_ROCKCHIP_PX30_DMC_H
+#define __SOC_ROCKCHIP_PX30_DMC_H
+
+#include <linux/types.h>
+
+#if IS_ENABLED(CONFIG_ARM_PX30_DMC_DEVFREQ)
+void px30_dmc_display_lock(void);
+void px30_dmc_display_unlock(void);
+void px30_dmc_display(bool on, int connector_type);
+#else
+static inline void px30_dmc_display_lock(void) { }
+static inline void px30_dmc_display_unlock(void) { }
+static inline void px30_dmc_display(bool on, int connector_type) { }
+#endif
+
+#endif
