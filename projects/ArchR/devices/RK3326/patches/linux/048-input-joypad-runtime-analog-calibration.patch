--- a/drivers/input/joystick/odroidgo3-joypad.c	2026-11-14 23:08:53.014066730 -0300
+++ b/drivers/input/joystick/odroidgo3-joypad.c	2026-11-14 23:08:53.030191358 -0300
@@ -82,6 +82,9 @@
 	int amux_ch;
 	/* adc data tuning value([percent), p = positive, n = negative */
 	int tuning_p, tuning_n;
+	/* runtime calibration (archr-joypad-cal.h) */
+	int raw, open_cal, deadzone, dt_tuning_p, dt_tuning_n;
+	bool cal_fixed;
 };
 
 struct analog_mux {
@@ -148,6 +151,9 @@
 	int debug_ch;
 };
 
+#define ARCHR_CAL_COUNT(j)	((j)->amux_count)
+#include "archr-joypad-cal.h"
+
 /*----------------------------------------------------------------------------*/
 //
 // set to the value in the boot.ini file. (if exist)
@@ -551,11 +557,12 @@
 				__func__, nbtn);
 			continue;
 		}
+		adc->raw = adc->value;
 		adc->value = adc->value - adc->cal;
 
 		/* Joystick Deadzone check */
-		if (joypad->bt_adc_deadzone) {
-			if (abs(adc->value) < joypad->bt_adc_deadzone)
+		if (adc->deadzone) {
+			if (abs(adc->value) < adc->deadzone)
 				adc->value = 0;
 		}
 
@@ -610,7 +617,7 @@
 				__func__, nbtn);
 			continue;
 		}
-		adc->cal = adc->value;
+		archr_cal_opened(adc, adc->value);
 		dev_info(joypad->dev, "%s : adc[%d] adc->cal = %d\n",
 			__func__, nbtn, adc->cal);
 	}
@@ -1053,6 +1060,12 @@
 	mutex_init(&joypad->lock);
 	platform_set_drvdata(pdev, joypad);
 
+	/* runtime analog calibration (archr-joypad-cal.h) */
+	archr_cal_init(joypad);
+	error = devm_device_add_group(dev, &archr_cal_attr_group);
+	if (error)
+		dev_warn(dev, "calibration sysfs failed (%d)\n", error);
+
 	error = sysfs_create_group(&pdev->dev.kobj, &joypad_attr_group);
 	if (error) {
 		dev_err(dev, "create sysfs group fail, error: %d\n",
