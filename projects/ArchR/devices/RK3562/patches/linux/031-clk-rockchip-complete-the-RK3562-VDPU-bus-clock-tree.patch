From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: retro98boy <retro98boy@qq.com>
Date: Sat, 24 Oct 2026 09:25:08 +0800
Subject: [PATCH] clk: rockchip: complete the RK3562 VDPU bus clock tree

Register the missing AXI and AHB BIU gates.
The BSP registers the AXI gate through its clock-link driver.
Route the decoder AHB clock through the AHB BIU gate.
Both gates use TOPCRU_GATE_CON10, as specified by the RK3562 TRM.
This removes orphan decoder clocks without forcing them permanently on.
---
Arch R RK3562 bring-up -- provenance:
Source: armbian/build ddbbfa20c2b2 patch/kernel/archive/rockchip64-7.3/rk3562-0029-clk-rockchip-complete-the-VDPU-bus-clock-tree.patch
Applied unchanged. (0030/0031 VDPU382 decoder NOT applied: they need the rest of Armbian's rkvdec series.)

 drivers/clk/rockchip/clk-rk3562.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/drivers/clk/rockchip/clk-rk3562.c b/drivers/clk/rockchip/clk-rk3562.c
index 7a2d93334..3a845ffc9 100644
--- a/drivers/clk/rockchip/clk-rk3562.c
+++ b/drivers/clk/rockchip/clk-rk3562.c
@@ -943,15 +943,19 @@ static struct rockchip_clk_branch rk3562_clk_branches[] __initdata = {
 	COMPOSITE(ACLK_VDPU_PRE, "aclk_vdpu_pre", gpll_cpll_pvtpll_dmyapll_p, 0,
 			RK3562_CLKSEL_CON(22), 6, 2, MFLAGS, 0, 5, DFLAGS,
 			RK3562_CLKGATE_CON(10), 0, GFLAGS),
+	GATE(0, "aclk_vdpu", "aclk_vdpu_pre", CLK_SET_RATE_PARENT,
+			RK3562_CLKGATE_CON(10), 5, GFLAGS),
 	COMPOSITE(CLK_RKVDEC_HEVC_CA, "clk_rkvdec_hevc_ca", gpll_cpll_pvtpll_dmyapll_p, 0,
 			RK3562_CLKSEL_CON(23), 14, 2, MFLAGS, 8, 5, DFLAGS,
 			RK3562_CLKGATE_CON(10), 3, GFLAGS),
 	COMPOSITE_NOMUX(HCLK_VDPU_PRE, "hclk_vdpu_pre", "aclk_vdpu", 0,
 			RK3562_CLKSEL_CON(24), 0, 4, DFLAGS,
 			RK3562_CLKGATE_CON(10), 4, GFLAGS),
+	GATE(0, "hclk_vdpu", "hclk_vdpu_pre", CLK_SET_RATE_PARENT,
+			RK3562_CLKGATE_CON(10), 6, GFLAGS),
 	GATE(ACLK_RKVDEC, "aclk_rkvdec", "aclk_vdpu", 0,
 			RK3562_CLKGATE_CON(10), 7, GFLAGS),
-	GATE(HCLK_RKVDEC, "hclk_rkvdec", "hclk_vdpu_pre", 0,
+	GATE(HCLK_RKVDEC, "hclk_rkvdec", "hclk_vdpu", 0,
 			RK3562_CLKGATE_CON(10), 8, GFLAGS),
 
 	/* PD_VEPU */
