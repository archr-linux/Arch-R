/*
 * AISLPC RG43V PRO, 4.3" 1024x768 MIPI-DSI panel (Arch R).
 *
 * Factory sources: .work/aislpc/rg43vpro/dts/rk3562-ro520c-lp3x-v14-linux.dts
 * (panel, "fab .dts") and the resolved/extract files named in the dtsi.
 * The v10 and v14 factory DTBs carry the same panel, buttons and battery.
 */

/dts-v1/;

#include "rk3562-aislpc-ro520c.dtsi"

/ {
	model = "AISLPC RG43V PRO";
	compatible = "aislpc,rg43v-pro", "rockchip,rk3562";

	/*
	 * Factory battery node (rk817,battery / rk817,charger, extrato-v14
	 * l.583-636): design 2906 mAh, Rbat 102 mOhm, power off 3500 mV, charge
	 * 1500 mA to 4280 mV, end of charge 300 mA. The product page says
	 * 4000 mAh; the DTB value is kept until it is measured. The mainline
	 * RK817 charger programs the voltage in 50 mV steps from 4.10 V, so
	 * 4280 mV would be rounded down to 4.25 V anyway; it is written as such.
	 */
	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <2906000>;
		charge-term-current-microamp = <300000>;
		constant-charge-current-max-microamp = <1500000>;
		constant-charge-voltage-max-microvolt = <4250000>;
		factory-internal-resistance-micro-ohms = <102000>;
		voltage-max-design-microvolt = <4175000>;
		voltage-min-design-microvolt = <3500000>;
		ocv-capacity-celsius = <20>;
		ocv-capacity-table-0 = <4175000 100>, <4090000 95>, <4054000 90>, <4041000 85>,
				       <4036000 80>, <4027000 75>, <3999000 70>, <3957000 65>,
				       <3926000 60>, <3903000 55>, <3871000 50>, <3847000 45>,
				       <3823000 40>, <3789000 35>, <3738000 30>, <3687000 25>,
				       <3644000 20>, <3605000 15>, <3570000 10>, <3529000 5>,
				       <3500000 0>;
	};
};

/*
 * Vertical case: the left stick reads the same polarity as the RG52's
 * (invert 0 from the dtsi). AveyondFly's rk3562-rg43v.dts inverts it, but
 * on a v10 board that sent up as down and left as right in games.
 * GPIO1_D4 is FN (BTN_MODE, from the dtsi) and the ADC buttons press at
 * 600 mV (dtsi default) on this model.
 */

&panel {
	/* LCD enable GPIO0_B0 active high (fab .dts panel@0 enable-gpios). */
	enable-gpios = <&gpio0 RK_PB0 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "default";
	pinctrl-0 = <&lcd_rst>, <&lcd_en>;

	/*
	 * Converted from the factory simple-panel-dsi node (fab .dts l.3821-3870,
	 * by kernel/tools/initseq2pdesc.py): 4 lanes, RGB888, dsi,flags 0xa03
	 * (VIDEO | BURST | NO_EOT | LPM), delays prepare/reset/init/enable/ready
	 * 20/20/20/120/20 ms. Timing0: 61.0 MHz, 1024+90+80+80 x 768+16+8+8,
	 * 59.85 Hz. Physical size from the 4.3" 4:3 diagonal (the factory
	 * 68x121 mm is the 5.5" value). 160 commands, all DCS short; the
	 * sequence is byte for byte the one of the AISLPC Pocket AIS mainline
	 * DT, which lights its panel on 7.2.
	 */
	panel_description =
		"G size=87,65 delays=20,20,20,120,20 format=rgb888 lanes=4 flags=0xa03",
		"M clock=61000 horizontal=1024,90,80,80 vertical=768,16,8,8 default=1",
			"I seq=ee01",
			"I seq=ea07",
			"I seq=eb12",
			"I seq=0a5e",
			"I seq=1314",
			"I seq=1735",
			"I seq=1d33",
			"I seq=2101",
			"I seq=2828",
			"I seq=2918",
			"I seq=2a63",
			"I seq=2ff3",
			"I seq=ee02",
			"I seq=39a9",
			"I seq=0000",
			"I seq=010d",
			"I seq=0212",
			"I seq=0308",
			"I seq=040e",
			"I seq=0530",
			"I seq=060b",
			"I seq=070e",
			"I seq=080f",
			"I seq=090e",
			"I seq=0a11",
			"I seq=0b4e",
			"I seq=0c14",
			"I seq=0d1a",
			"I seq=0e2f",
			"I seq=0f36",
			"I seq=103f",
			"I seq=2000",
