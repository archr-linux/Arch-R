# pkg_identity INSTALL_PKG_DIR: the pacman identity ArchR gives a built
# package, shared by gen-pacman-repo (the repo) and gen-image-localdb
# (the image's own installed-package db), which must agree exactly.
# Run from the top of the source tree. Sets name, version (with an epoch
# when it has one), fileversion (version without the epoch, for archive
# names), pkgrel, replaces (the PKG_REPLACES list) and depends (the
# PKG_PACMAN_DEPENDS list), plus pkgmk/relmk
# and srcmk (empty when no package.mk builds the package any more).
#
# PKG_ID_EXCLUDES: tar --exclude patterns for files never shipped.

PKG_ID_EXCLUDES=(
    # The depmod-generated indexes are stale by construction inside a
    # package (the kernel builds them before any out-of-tree module
    # exists); shipping them wiped the joypad and WiFi drivers from
    # modules.dep on every linux update. The device rebuilds them via
    # the archr-depmod hook; modules.builtin*/order stay (kernel-owned
    # depmod inputs).
    '*/modules/*/modules.dep'
    '*/modules/*/modules.dep.bin'
    '*/modules/*/modules.alias'
    '*/modules/*/modules.alias.bin'
    '*/modules/*/modules.symbols'
    '*/modules/*/modules.symbols.bin'
    '*/modules/*/modules.devname'
    '*/modules/*/modules.softdep'
    '*/modules/*/modules.weakdep'
    '*/modules/*/modules.builtin.bin'
    '*/modules/*/modules.builtin.alias.bin'
)

# The dates of git-pinned packages come from git history, so the image's
# package db and the repo of one build only agree when both see the full
# history. Without it (a source tarball, a shallow clone) every generator
# stops here, unless ARCHR_PKGVER_ALLOW_NOGIT=1 allows a fixed placeholder
# date for a development build that is never published. Checked once,
# when sourced from the top of the source tree.
PKG_ID_GIT=1
pkg_id_nogit=""
if [ "$(git rev-parse --show-toplevel 2>/dev/null)" != "$(pwd -P)" ]; then
    pkg_id_nogit="no git history of this tree"
elif [ "$(git rev-parse --is-shallow-repository 2>/dev/null)" != false ]; then
    pkg_id_nogit="shallow git history"
fi
if [ -n "${pkg_id_nogit}" ]; then
    if [ "${ARCHR_PKGVER_ALLOW_NOGIT:-}" != 1 ]; then
        echo "pkg-identity: ${pkg_id_nogit} in $(pwd); git-pinned package versions need the full history." >&2
        echo "pkg-identity: build from a full clone, or set ARCHR_PKGVER_ALLOW_NOGIT=1 for a build that is not published." >&2
        exit 1
    fi
    echo "pkg-identity: WARNING ${pkg_id_nogit}: git-pinned packages get the date 00000000T000000; do not publish this build." >&2
    PKG_ID_GIT=0
fi
unset pkg_id_nogit

pkg_is_git_sha() {
    [[ "$1" =~ ^[0-9a-f]{40}$ ]]
}

# The package.mk files a package.mk takes its version from, so a bump
# there dates the packages that reuse it: X's for a dynamic
# PKG_VERSION="$(get_pkg_version X)", and a base package.mk an overlay
# sources (". ${ROOT}/packages/.../package.mk").
pkg_version_source() {
    local mk="$1" other
    [ -n "${mk}" ] || return 0
    sed -n 's#^\. *"\{0,1\}\${\{0,1\}ROOT}\{0,1\}/\([^" ]*package\.mk\).*#\1#p' "${mk}"
    other="$(sed -n 's/^PKG_VERSION="\$(get_pkg_version \([^)]*\))"$/\1/p' "${mk}" | head -1)"
    [ -n "${other}" ] || return 0
    find projects/ArchR/packages packages -mindepth 2 -maxdepth 6 \
        -path "*/${other}/package.mk" -print -quit 2>/dev/null
}

# pkg_git_date FILE...: the newest UTC time, YYYYMMDDTHHMMSS, at which the
# distribution changed any of FILE. A file committed as is: the committer
# date of the last first-parent commit touching it (on main a merge counts
# at its own date, so the order follows main). A file edited but not
# committed: its mtime (a local build; the same in every script of the
# build). Allowed without history (ARCHR_PKGVER_ALLOW_NOGIT=1):
# 00000000T000000, older than any real date.
pkg_git_date() {
    local f d best=""
    if [ "${PKG_ID_GIT}" != 1 ]; then
        echo "00000000T000000"
        return 0
    fi
    for f in "$@"; do
        [ -f "${f}" ] || continue
        if git ls-files --error-unmatch -- "${f}" >/dev/null 2>&1 &&
           git diff --quiet HEAD -- "${f}" 2>/dev/null; then
            d="$(TZ=UTC git log -1 --first-parent --format=%cd \
                    --date=format-local:%Y%m%dT%H%M%S -- "${f}" 2>/dev/null)"
        else
            d="$(TZ=UTC date -r "${f}" +%Y%m%dT%H%M%S)"
        fi
        [[ "${d}" > "${best}" ]] && best="${d}"
    done
    echo "${best:-00000000T000000}"
}

# pkg_git_pkgver SHA FILE...: the pacman version of a package pinned to
# git commit SHA, given the package.mk files that set it:
# 1:0.git<YYYYMMDDTHHMMSS>.<sha7>. The date makes every bump sort higher;
# epoch 1 makes it sort above the bare hashes devices already have
# installed. PKG_VERSION itself is untouched (source URL, build dirs).
pkg_git_pkgver() {
    local sha="$1"
    shift
    printf '1:0.git%s.%s\n' "$(pkg_git_date "$@")" "${sha:0:7}"
}

pkg_identity() {
    local src="$1" dirname rev real="" replaced
    dirname="$(basename "${src}")"

    # The install_pkg dir name is "<pkgname>-<version_or_githash>". Strip
    # the trailing suffix to recover the package name; the suffix is
    # either a 40-char git hash or starts with a digit (semver).
    name="$(echo "${dirname}" | sed -E 's/-[0-9a-f]{40}$//; s/-[0-9].*$//')"

    # Try to recover the exact PKG_VERSION from a matching package.mk
    # under either the ArchR overlay or the top-level packages tree.
    # Search any depth; multiple categories share the same package name
    # in some cases, take the ArchR overlay first.
    pkgmk=""
    pkgmk="$(find projects/ArchR/packages -mindepth 2 -maxdepth 6 \
                -path "*/${name}/package.mk" -print -quit 2>/dev/null)"
    if [ -z "${pkgmk}" ]; then
        pkgmk="$(find packages -mindepth 2 -maxdepth 6 \
                    -path "*/${name}/package.mk" -print -quit 2>/dev/null)"
    fi

    version=""
    if [ -n "${pkgmk}" ]; then
        version="$(awk -F'"' '/^PKG_VERSION/ {print $2; exit}' "${pkgmk}")"
    fi
    # Some package.mk files set PKG_VERSION dynamically, e.g.:
    #   PKG_VERSION="$(get_pkg_version gstreamer)"
    # awk pulls the unresolved shell expansion as a string, which then
    # turns into garbage like "..get_pkg_version.gstreamer." after the
    # charset filter. Detect any $( ... ), :- or ${ and bail to the
    # dirname fallback below, which holds the version the build system
    # actually substituted.
    case "${version}" in
        *'$('* | *'${'* ) version="" ;;
    esac
    # Fallback: pull the suffix back out of the dirname.
    if [ -z "${version}" ]; then
        version="${dirname#${name}-}"
    fi
    version="${version:-$(date +%Y%m%d)}"

    # pacman version must match [a-zA-Z0-9.+_]+. Long hashes are fine
    # by this charset, but '/' or '~' would break: tr the rest. Use
    # printf instead of echo to avoid the trailing newline being
    # turned into a stray '.' by tr -c.
    version="$(printf '%s' "${version}" | tr -c 'a-zA-Z0-9.+_' '.')"
    # The name above is derived from the install_pkg directory, which
    # goes wrong when PKG_VERSION is empty or starts with a letter
    # ("autostart-", "mako-notify-v1.0"); devices already carry those
    # names, so they stay. Their package.mk is still found through the
    # name the build recorded, so PKG_REV and PKG_REPLACES work for them.
    relmk="${pkgmk}"
    if [ -z "${relmk}" ] && [ -f "${src}/.archr-package" ]; then
        real="$(sed -n 's/^INFO_PKG_NAME="\(.*\)"$/\1/p' "${src}/.archr-package")"
        if [ -n "${real}" ]; then
            relmk="$(find projects/ArchR/packages packages -mindepth 2 -maxdepth 6 \
                        -path "*/${real}/package.mk" -print -quit 2>/dev/null)"
        fi
    fi

    # pkgrel comes from the package's PKG_REV (the standard knob for "same
    # upstream version, new package build", e.g. a changed local overlay
    # like a joypad autoconfig). Hardcoding 1 here meant any local-only
    # change never produced a newer package, so pacman never saw it as an
    # update. Default to 1 when PKG_REV is unset or dynamic.
    pkgrel=1
    if [ -n "${relmk}" ]; then
        rev="$(awk -F'"' '/^PKG_REV/ {print $2; exit}' "${relmk}")"
        case "${rev}" in
            ''|*'$('* | *'${'* ) : ;;
            *) pkgrel="${rev}" ;;
        esac
    fi
    # PKG_REPLACES lists packages this one takes over (e.g. a dropped
    # package whose job it does). Without it a device keeps the old
    # package forever, since it leaves the repo but stays installed, and
    # files that moved to another package then conflict on -Syu. pacman
    # -Syu offers the replacement (accepted by --noconfirm) and removes
    # the old package in the same transaction.
    replaces=""
    if [ -n "${relmk}" ]; then
        replaces="$(awk -F'"' '/^PKG_REPLACES=/ {print $2; exit}' "${relmk}")"
    fi

    # PKG_PACMAN_DEPENDS lists what the installed package needs at run
    # time, with an optional version ("coreutils>=9.6-2"), so pacman -S or
    # -U of this one package pulls them into the same transaction.
    # PKG_DEPENDS_TARGET is build order only and never reaches pacman.
    depends=""
    if [ -n "${relmk}" ]; then
        depends="$(awk -F'"' '/^PKG_PACMAN_DEPENDS=/ {print $2; exit}' "${relmk}")"
    fi

    # srcmk: the package.mk that builds this package, device packages
    # (projects/ArchR/devices) included; empty for a leftover install_pkg
    # dir whose package is gone (renamed or dropped).
    srcmk="${relmk:-$(find projects/ArchR/devices -mindepth 3 -maxdepth 6 \
                -path "*/${real:-${name}}/package.mk" -print -quit 2>/dev/null || :)}"

    # A PKG_VERSION pinned to a git commit (40 hex chars) cannot be the
    # pkgver: vercmp orders commit hashes arbitrarily, so a bump to a hash
    # that sorts lower (a1b2... after 1018...) looked like a downgrade and
    # was never offered. See pkg_git_pkgver.
    # Dated by srcmk and the package.mk files its version comes from.
    if pkg_is_git_sha "${version}"; then
        version="$(pkg_git_pkgver "${version}" "${srcmk}" \
                    $(pkg_version_source "${srcmk}"))"
    fi

    # The archive name leaves the epoch out: GitHub Releases rewrite ':' in
    # asset names, and pacman finds the file through the db anyway.
    fileversion="${version#*:}"
}
